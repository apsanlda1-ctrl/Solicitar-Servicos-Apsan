const specialties=["Clínico Geral / General Practitioner","Medicina Interna","Cardiologia","Pediatria","Ginecologia e Obstetrícia","Ortopedia","Dermatologia","Oftalmologia","Otorrinolaringologia (ENT)","Neurologia","Neurocirurgia","Urologia","Cirurgia Geral","Psiquiatria","Pneumologia","Nefrologia","Gastroenterologia","Oncologia","Endocrinologia","Fisioterapia","Psicologia","Nutrição / Dietética","Odontologia"];
const serviceInfo={
 hospital:{title:"🏥 Acompanhamento Hospitalar",desc:"Acompanhamento e apoio hospitalar na Namíbia.",details:["Acompanhamento do cliente durante consultas, exames, internamentos e outros atendimentos hospitalares.","Apoio na comunicação entre o cliente e os profissionais de saúde, incluindo tradução e interpretação quando necessário.","Ajuda no preenchimento e organização de formulários e informações solicitadas pela unidade de saúde.","Orientação sobre localização de serviços, setores, horários e procedimentos básicos dentro da unidade.","Acompanhamento ao longo do atendimento para facilitar a compreensão das orientações recebidas pelo cliente."]},
 shopping:{title:"🛒 Compras na Namíbia",desc:"Prestação de serviço para compras na Namíbia.",details:["Apoio ao cliente na identificação e aquisição dos produtos pretendidos na Namíbia.","Pesquisa e localização de lojas, mercados ou estabelecimentos adequados ao tipo de compra solicitado.","Apoio na comunicação com vendedores e na compreensão das informações apresentadas no estabelecimento.","Auxílio na conferência dos artigos, quantidades e organização geral das compras.","Quando solicitado, o técnico acompanha o processo desde a procura dos produtos até à conclusão das compras."]},
 pricecheck:{title:"🔎 Consultar Preços na Namíbia",desc:"Consulta de preços e verificação de produtos na Namíbia.",details:["Pesquisa do preço do produto ou artigo indicado pelo cliente.","Verificação da disponibilidade do artigo quando essa informação puder ser confirmada no estabelecimento.","Recolha de informações básicas sobre o produto, como modelo, tamanho, quantidade ou características disponíveis.","Comparação de opções quando solicitado pelo cliente e quando houver alternativas disponíveis.","Quando for necessária deslocação, o técnico realiza a consulta presencialmente e informa os dados encontrados antes de qualquer contratação adicional."]},
 shoppingescort:{title:"🛍️ Acompanhamento para Compras na Namíbia",desc:"Acompanhamento do cliente durante as compras na Namíbia.",details:["O técnico acompanha o cliente durante a realização das compras.","Apoio na comunicação com lojas e vendedores e na localização dos estabelecimentos pretendidos.","Apoio na organização do percurso e da sequência das compras para facilitar o atendimento.","Auxílio na conferência dos produtos, quantidades e informações básicas no momento da compra.","O acompanhamento corresponde à presença do técnico durante o processo de compras, conforme o local e as condições selecionadas pelo cliente na consulta."]},
 parcel:{title:"📨 Envio e Recepção de Encomendas",desc:"Serviço de recepção, organização e encaminhamento de encomendas entre Angola e Namíbia.",details:["O técnico da APSAN, LDA é responsável por receber a encomenda quando esta for entregue para o serviço.","Após receber a encomenda, o técnico confere as informações necessárias para o encaminhamento e organiza a entrega à transportadora ou ao ponto de despacho definido.","O técnico acompanha o processo de despacho da encomenda para o destino indicado pelo cliente e organiza as informações da transportadora.","O cliente deve fornecer corretamente os dados do destinatário, destino, transportadora e demais informações necessárias para o envio.","A APSAN, LDA presta o serviço de recepção e encaminhamento; o transporte/frete da transportadora é tratado separadamente conforme a opção disponível.","O cliente poderá acompanhar o estado da solicitação através das informações fornecidas pela plataforma e pelos canais de contacto da APSAN, LDA."]},
 minorstranslation:{title:"👶 Documentos de viagem para menores",desc:"Preparação das versões em Português e Inglês de documentos de viagem para menores.",details:["Preparação de uma autorização de viagem para menor com base exclusivamente nos dados fornecidos pelo pai, pela mãe ou pelo responsável no formulário.","Recolha completa dos dados de identificação do pai: nome, nacionalidade, local e data de nascimento, estado civil, documento de identificação, entidade emissora, data de emissão e residência.","Recolha completa dos dados de identificação da mãe ou da adulta acompanhante, incluindo filiação, nacionalidade, local e data de nascimento, estado civil, documento, entidade emissora, data de emissão e residência.","Recolha dos dados de cada menor que viajará, permitindo inserir um ou vários menores no mesmo documento.","Recolha dos dados da viagem, incluindo local de partida, destino, acompanhante e período previsto de permanência.","O documento é preparado nas versões Português e Inglês, mantendo uma estrutura institucional organizada e sem logótipo.","Os dados de exemplo apresentados no sistema não são utilizados como dados reais: o documento final é gerado somente com os dados preenchidos pelo cliente no respetivo pedido.","Após o pagamento e o envio do comprovativo, o pedido fica em análise pela direção da plataforma. Somente depois da aprovação o documento final fica disponível para consulta.","Depois de aprovado, o cliente consulta o documento pelo nome completo utilizado no pagamento e pode pré-visualizá-lo e guardá-lo em PDF."]},
 borderescort:{title:"🚶 Acompanhamento para Atravessar a Fronteira",desc:"Acompanhamento do cliente durante o processo de travessia da fronteira.",details:["Acompanhamento do cliente durante o percurso de travessia da fronteira.","Apoio na organização dos documentos e informações necessários para a travessia.","Orientação ao cliente sobre onde se dirigir e como organizar o processo de passagem.","Apoio na comunicação quando houver necessidade de esclarecimento durante o percurso.","Quando o cliente transporta mercadorias, malas ou objetos pesados, essas condições devem ser informadas no formulário para que a consulta seja feita corretamente."]},
 sworn:{title:"📑 Tradução Oficial Juramentada",desc:"Tradução oficial de documentos para fins administrativos, legais ou de imigração.",details:["Tradução oficial de documentos apresentados pelo cliente para a finalidade indicada.","Atendimento de documentos como certidões, diplomas, certificados, documentos legais e outros documentos oficiais.","Verificação das informações do documento de origem antes da preparação da tradução.","Preparação da versão traduzida respeitando a estrutura e as informações essenciais do documento apresentado.","O cliente deve apresentar uma cópia legível e completa do documento que pretende traduzir."]},
 translation:{title:"🌐 Tradução e Interpretação",desc:"Serviços de tradução e interpretação entre Português e Inglês.",details:["Tradução de textos e documentos entre Português e Inglês.","Interpretação em reuniões, atendimentos, encontros, negócios e outras situações de comunicação.","Apoio linguístico para facilitar a comunicação entre pessoas que utilizam Português e Inglês.","O cliente informa o tipo de trabalho, idioma, quantidade de páginas ou duração necessária para que a prestação seja consultada.","O conteúdo final é preparado de acordo com as informações e materiais fornecidos pelo cliente."]},
 exchange:{title:"💰 Depósitos na Namíbia",desc:"Assistência ao cliente no processo de depósito de valores na Namíbia, através de entidades autorizadas.",details:[["O cliente informa o valor que pretende transferir para a Namíbia e fornece os dados necessários do beneficiário.","O cliente faz o depósito do valor na conta da APSAN, LDA indicada para o serviço.","Após a confirmação do depósito, a APSAN, LDA procede à conversão do valor para dólar namibiano, de acordo com o procedimento aplicável.","Opção 1 — Depósito bancário: o cliente fornece os dados do beneficiário, e a APSAN, LDA realiza o devido depósito num dos bancos da Namíbia.","Opção 2 — Depósito através da Shoprite: a APSAN, LDA realiza o depósito na Shoprite e fornece o número de referência do depósito.","Na opção Shoprite, o beneficiário dirige-se à Shoprite indicada e faz o levantamento do valor utilizando o número de referência do depósito.","A APSAN, LDA presta assistência durante o processo e o cliente deve fornecer informações corretas e completas do beneficiário."]]},
 import:{title:"📦 Importação e Exportação",desc:"Assistência em processos de importação, exportação e desalfandegamento.",details:["Apoio na organização das informações e documentos relacionados com a mercadoria.","Orientação na preparação dos dados de origem, destino, quantidade e natureza dos produtos.","Assistência na organização documental para processos de importação e exportação.","Apoio no acompanhamento administrativo do processo de desalfandegamento e na comunicação necessária.","O cliente deve fornecer informações completas e verdadeiras sobre a mercadoria para permitir o correto encaminhamento do pedido."]},
 website:{title:"💻 Criação de Websites",desc:"Criação de websites profissionais com funcionalidades adaptadas à empresa e integração com WhatsApp.",details:["Planeamento da estrutura do website de acordo com a atividade, objetivos e público da empresa.","Criação das páginas, menus, secções e conteúdos necessários ao projeto.","Desenvolvimento de funcionalidades adequadas ao tipo de website escolhido, incluindo formulários e áreas de contacto.","Integração com WhatsApp e adaptação do website para telemóveis, tablets e computadores.","Organização da apresentação da empresa, serviços, produtos e informações institucionais.","O porte da empresa é informado no formulário para que a consulta do preço seja calculada corretamente."]},
 social:{title:"📱 Gestão de Redes Sociais",desc:"Gestão e organização da presença da empresa nas redes sociais.",details:["Planeamento e organização da presença digital da empresa nas redes sociais.","Apoio na criação e publicação de conteúdos de acordo com o plano definido.","Organização de campanhas, comunicação visual e mensagens para o público da empresa.","Acompanhamento da página e organização das atividades de gestão ao longo do período contratado.","O período e as características da gestão são informados no formulário antes da consulta do preço."]},
 software:{title:"🧩 Criação de Sistemas de Software",desc:"Desenvolvimento de sistemas e software de gestão adaptados às necessidades da empresa.",details:["Levantamento das necessidades e dos processos que o sistema deverá controlar.","Desenvolvimento de funcionalidades para gestão, vendas, stock, clientes, utilizadores ou outros processos definidos no projeto.","Estruturação das telas, formulários, áreas de consulta e operações necessárias ao sistema.","Possibilidade de desenvolvimento de sistema de gestão empresarial, sistema de vendas, sistema de stock, software personalizado ou plataforma web.","O porte da empresa é informado no formulário para que a consulta do preço seja calculada corretamente."]},
 promotion:{title:"🚀 Promoção de Página",desc:"Promoção de página ou presença digital durante o período selecionado, cobrada por dia.",details:["Planeamento da promoção de acordo com a página ou presença digital indicada pelo cliente.","Organização da campanha e do período de divulgação selecionado.","Apoio na preparação das informações necessárias para a promoção.","Acompanhamento da prestação durante o período contratado.","A duração da promoção é indicada pelo cliente em número de dias antes da consulta do preço. O valor diário é de 2.500 Kz e o total é calculado automaticamente."]}
};
let currentService="";let selectedCity="";let selectedFacility="";let selectedRate=0;let selectedOriginal=0;let lastResultData=null;let selectedPayment="";let countdownTimer=null;let checkoutDeadline=0;let proofFileName="";let proofFile=null;let uploadInProgress=false;
const priceConfig={shopping:{cosmetics:6000,food:6000,furniture:30000,construction:10000,mixed:10000},parcel:{envelope:10000,cargo:20000},social:{monthly:35000},promotion:{daily:2500,weekly:12000}};
const facilities={Oshakati:[{name:"Hospital Geral do Estado",type:"Hospital público",rate:20000,original:22000},{name:"Clínica privada — Oshakati",type:"Clínica privada",rate:20000,original:22000}],Ongwediva:[{name:"MediPark",type:"Clínica privada",rate:20000,original:22000}],Ondangwa:[{name:"Clínica privada — Ondangwa",type:"Clínica privada",rate:20000,original:22000}],Windhoek:[{name:"Hospital público — Windhoek",type:"Hospital público",rate:60000,original:60000},{name:"Clínica privada — Windhoek",type:"Clínica privada",rate:60000,original:60000}]};

const progressDefinitions={
 hospital:[
  ['origem','Origem',()=>!!document.getElementById('province')?.value&&!!document.getElementById('municipality')?.value],
  ['viagem','Viagem',()=>!!document.getElementById('travelling')?.value],
  ['destino','Destino',()=>!!selectedCity],
  ['unidade','Unidade',()=>!!selectedFacility],
  ['pessoas','Pessoas',()=>Number(document.getElementById('quantity')?.value)>0],
  ['idade','Idade',()=>{const v=document.getElementById('age')?.value;return v!==''&&v!=null&&Number(v)>=0}],
  ['data','Data',()=>!!document.getElementById('serviceDate')?.value],
  ['especialidade','Especialidade',()=>!!document.getElementById('specialty')?.value],
  ['urgencia','Urgência',()=>!!document.getElementById('urgency')?.value]
 ]
};
function updateFormProgress(){
 const box=document.getElementById('formProgress'); if(!box)return;
 const defs=progressDefinitions[currentService];
 if(!defs){box.classList.add('hidden');return}
 box.classList.remove('hidden');
 const done=defs.map(d=>{try{return !!d[2]()}catch(e){return false}}), count=done.filter(Boolean).length,total=defs.length,pct=Math.round(count/total*100);
 const countEl=document.getElementById('progressCount'),fill=document.getElementById('progressFill'),steps=document.getElementById('progressSteps'),next=document.getElementById('progressNext');
 if(countEl)countEl.textContent=`${count} de ${total} preenchidas`;
 if(fill)fill.style.width=pct+'%';
 if(steps)steps.innerHTML=defs.map((d,i)=>`<div class="progress-step ${done[i]?'done':''}"><span class="dot">${done[i]?'✓':i+1}</span><span>${d[1]}</span></div>`).join('');
 const first=defs.findIndex((d,i)=>!done[i]);
 if(next)next.textContent=first<0?'✓ Todas as questões obrigatórias foram preenchidas. Já pode consultar o preço.':'Próxima questão: '+defs[first][1];
}
function initFormProgress(){updateFormProgress();}

function setStage(stage){document.getElementById('servicesPage').classList.toggle('hidden',stage!=='services');document.getElementById('formPage').classList.toggle('hidden',stage!=='form');document.getElementById('paidDocumentPage').classList.toggle('hidden',stage!=='paidDocument');document.getElementById('adminPage').classList.toggle('hidden',stage!=='admin');document.getElementById('loadingPage').classList.toggle('hidden',stage!=='loading');document.getElementById('resultPage').classList.toggle('hidden',stage!=='result');document.getElementById('checkoutPage').classList.toggle('hidden',stage!=='checkout');document.getElementById('appointmentPage').classList.toggle('hidden',stage!=='appointment');document.getElementById('successPage').classList.toggle('hidden',stage!=='success');if(stage!=='checkout'){document.querySelector('header.visual-header')?.classList.remove('payment-selected-timer');document.getElementById('checkoutTimerSection')?.classList.add('hidden');}window.scrollTo({top:0,behavior:'smooth'});}
const serviceImages={'hospital': 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=300&q=85', 'shopping': 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=300&q=85', 'pricecheck': 'https://expertfrais.fr/wp-content/uploads/2025/06/Inflation-alimentaire-ces-produits-du-quotidien-dont-le-prix-a-explose-en-2025-content.jpg', 'shoppingescort': 'data:image/jpeg;base64,', 'parcel': 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=300&q=85', 'minorstranslation': 'https://images.unsplash.com/photo-1516627145497-ae6968895b74?auto=format&fit=crop&w=300&q=85', 'borderescort': 'https://aruba.bynder.com/m/2223011cb11a8e5e/webimage-Couple-at-Aruba-Airport-Immigration.png', 'sworn': 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=300&q=85', 'translation': 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=300&q=85', 'exchange': 'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?auto=format&fit=crop&w=300&q=85', 'import': 'https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=300&q=85', 'website': 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=300&q=85', 'social': 'https://images.unsplash.com/photo-1611162618071-b39a2ec055fb?auto=format&fit=crop&w=500&q=90', 'software': 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=300&q=85', 'promotion': 'https://images.unsplash.com/photo-1611162617474-5b21e879e113?auto=format&fit=crop&w=500&q=90'};
function openService(key,fromPop=false){currentService=key;const serviceTitleEl=document.getElementById('selectedServiceTitle');const cleanServiceTitle=String(serviceInfo[key].title||'').replace(/^\s*[^\p{L}\p{N}]+\s*/u,'');const serviceImage=serviceImages[key]||'';if(serviceTitleEl)serviceTitleEl.innerHTML=serviceImage?`<span class="service-title-with-photo"><img class="service-detail-photo" src="${serviceImage}" alt="${cleanServiceTitle}"><span>${cleanServiceTitle}</span></span>`:cleanServiceTitle;document.getElementById('selectedServiceDesc').textContent=serviceInfo[key].desc;const detailEl=document.getElementById('selectedServiceDetails');if(detailEl){detailEl.innerHTML=`<div class="service-details-collapsible"><div class="service-details-body is-collapsed"><strong>O que o serviço inclui:</strong><ul style="margin:8px 0 0 18px;padding:0">${(serviceInfo[key].details||[]).map(x=>`<li style="margin:5px 0">${x}</li>`).join('')}</ul></div><span class="service-details-fade"></span><button type="button" class="button secondary service-details-toggle" onclick="toggleServiceDetails(this)">VER MAIS</button></div>`;}document.getElementById('hospitalForm').innerHTML='';document.getElementById('genericForm').innerHTML='';document.getElementById('genericForm').classList.add('hidden');selectedCity='';selectedFacility='';selectedRate=0;selectedOriginal=0;if(key==='hospital'){buildHospitalForm()}else if(key==='minorstranslation'){buildMinorServiceLanding()}else{buildGenericForm(key)}setStage('form');initFormProgress();if(!fromPop)history.pushState({stage:'form',service:key},'',`#servico-${key}`);}
function backToServices(fromPop=false){if(fromPop){setStage('services');return}if(history.state&&history.state.stage==='form'){history.back()}else{setStage('services');history.replaceState({stage:'services'},'', '#servicos')}}

document.addEventListener('input',updateFormProgress);
document.addEventListener('change',updateFormProgress);

window.addEventListener('popstate',e=>{const st=e.state||{stage:'services'};if(st.stage==='form'&&st.service){openService(st.service,true)}else if(st.stage==='result'&&st.data){showResult(st.data,true)}else if(st.stage==='checkout'&&st.data){showResult(st.data,true);openCheckout(true)}else if(st.stage==='appointment'&&st.data){showResult(st.data,true);openAppointment(true)}else if(st.stage==='success'&&st.data){showResult(st.data,true);st.data?.invoiceMode==='minor-pending'?showMinorPending():showSuccess(st.data,true)}else if(st.stage==='paidDocument'){setStage('paidDocument')}else if(st.stage==='admin'){setStage('admin');renderAdmin()}else{setStage('services')}});
if(!history.state || !history.state.stage){history.replaceState({stage:'services'},'',location.pathname+'#servicos')}setStage('services');
function buildHospitalForm(){const el=document.getElementById('hospitalForm');el.innerHTML=`
<div class="section"><div class="section-title">ORIGEM DO CLIENTE 🇦🇴</div><h3>De onde sairá o cliente?</h3><div class="grid"><div><label>Província</label><select id="province" onchange="loadMunicipalities()"><option value="">Selecionar província</option>${Object.keys(municipalities).map(p=>`<option>${p}</option>`).join('')}</select></div><div><label>Município</label><select id="municipality" disabled><option>Primeiro selecione a província</option></select></div></div><label>Vai viajar da sua província para a Namíbia?</label><select id="travelling"><option value="">Selecionar</option><option>Sim</option><option>Não</option></select></div>
<div class="section"><div class="section-title">DESTINO DO ATENDIMENTO 🇳🇦</div><h3>Onde pretende fazer a consulta?</h3><div class="choice-grid"><div class="choice" data-city="Oshakati" onclick="selectCity('Oshakati')"><strong>Oshakati</strong><span>Hospital público ou clínica privada — mesmo valor</span></div><div class="choice" data-city="Ongwediva" onclick="selectCity('Ongwediva')"><strong>Ongwediva</strong><span>Hospital/clínica — mesmo valor</span></div><div class="choice" data-city="Ondangwa" onclick="selectCity('Ondangwa')"><strong>Ondangwa</strong><span>Hospital/clínica — mesmo valor</span></div><div class="choice" data-city="Windhoek" onclick="selectCity('Windhoek')"><strong>Windhoek</strong><span>Hospital público ou clínica privada</span></div></div><div id="facilityBlock" class="hidden"><label>Onde será atendido?</label><div class="choice-grid" id="facilityChoices"></div></div></div>
<div class="section"><div class="grid"><div><label>Para quantas pessoas?</label><input id="quantity" type="number" min="1" value="1"></div><div><label>Qual é a sua idade?</label><input id="age" type="number" min="0" max="120" placeholder="Idade"></div></div><div id="hospitalDurationBlock" class="hidden"><label>Quantos dias de acompanhamento?</label><input id="hospitalDays" type="number" min="1" value="1"><div id="hospitalPriceNotice" class="notice hidden">Os valores da prestação e da deslocação serão apresentados somente depois da consulta do preço.</div></div><label>Especialista / especialidade</label><input id="specialtySearch" placeholder="🔍 Pesquisar especialista..." oninput="filterSpecialties()"><select id="specialty"><option value="">Selecionar especialidade</option></select></div>
<div class="section"><div class="section-title">URGÊNCIA DO SERVIÇO</div><h3>Qual é o prazo pretendido?</h3><div class="choice-grid"><div class="choice" onclick="selectUrgency('Normal',this)"><strong>Prazo normal</strong><span>Atendimento planeado com antecedência.</span></div><div class="choice" onclick="selectUrgency('Urgente',this)"><strong>Urgente</strong><span>Necessita de prioridade.</span></div></div><input type="hidden" id="urgency" value=""><label>Data pretendida</label><input id="serviceDate" type="date"></div>
<button class="button" onclick="consultPrice()">CONSULTAR PREÇO DA PRESTAÇÃO</button>`;fillSpecialties();}
function loadMunicipalities(){const p=document.getElementById('province').value;const m=document.getElementById('municipality');m.disabled=!p;m.innerHTML=p?'<option value="">Selecionar município</option>'+municipalities[p].map(x=>`<option>${x}</option>`).join(''):'<option>Primeiro selecione a província</option>'}
function fillParcelProvinces(){const s=document.getElementById('parcelProvince');if(!s)return;s.innerHTML='<option value="">Selecionar província</option>'+Object.keys(municipalities).map(p=>`<option>${p}</option>`).join('')}
function loadParcelMunicipalities(){const p=document.getElementById('parcelProvince')?.value,m=document.getElementById('parcelMunicipality');if(!m)return;m.disabled=!p;m.innerHTML=p?'<option value="">Selecionar município</option>'+municipalities[p].map(x=>`<option>${x}</option>`).join(''):'<option>Primeiro selecione a província</option>'}
function selectCity(city){
 selectedCity=city;selectedFacility='';updateFormProgress();
 const cityGrid=document.querySelector('[data-city="Oshakati"]')?.closest('.choice-grid');
 document.querySelectorAll('[data-city]').forEach(x=>x.classList.remove('active'));
 const selected=document.querySelector(`[data-city="${city}"]`);if(selected)selected.classList.add('active');
 // Depois de escolher a cidade, esconder as outras opções para manter o formulário compacto.
 if(cityGrid){cityGrid.classList.add('hidden');cityGrid.setAttribute('aria-hidden','true');}
 const section=selected?.closest('.section');
 if(section){let summary=document.getElementById('selectedCitySummary');if(!summary){summary=document.createElement('div');summary.id='selectedCitySummary';summary.className='selected-summary';section.insertBefore(summary,document.getElementById('facilityBlock'));}summary.innerHTML=`<div><span class="small">Destino selecionado</span><strong>${city}</strong></div><button type="button" class="button secondary compact" onclick="changeCity()">ALTERAR</button>`;}
 const duration=document.getElementById('hospitalDurationBlock');if(duration)duration.classList.remove('hidden');
 const notice=document.getElementById('hospitalPriceNotice');
 if(notice){notice.classList.add('hidden');notice.textContent='Os valores da prestação serão apresentados somente depois de clicar em “CONSULTAR PREÇO DA PRESTAÇÃO”.';}
 const block=document.getElementById('facilityBlock'),list=document.getElementById('facilityChoices');block.classList.remove('hidden');
 list.innerHTML=facilities[city].map((f,i)=>`<div class="choice" onclick="selectFacility(${i})"><strong>${f.name}</strong><span>${f.type}</span></div>`).join('');
}
function changeCity(){
 const grid=document.querySelector('[data-city="Oshakati"]')?.closest('.choice-grid');
 if(grid){grid.classList.remove('hidden');grid.removeAttribute('aria-hidden');}
 const summary=document.getElementById('selectedCitySummary');if(summary)summary.remove();
 const block=document.getElementById('facilityBlock');if(block)block.classList.add('hidden');
 selectedCity='';selectedFacility='';selectedRate=0;selectedOriginal=0;updateFormProgress();
}
function selectFacility(i){
 const f=facilities[selectedCity][i];selectedFacility=f.name;selectedRate=f.rate;selectedOriginal=f.original;updateFormProgress();
 document.querySelectorAll('#facilityChoices .choice').forEach((x,j)=>x.classList.toggle('active',j===i));
 // Depois de escolher a unidade, esconder as outras opções e mostrar apenas a escolha feita.
 const list=document.getElementById('facilityChoices');
 if(list){list.classList.add('hidden');list.setAttribute('aria-hidden','true');}
 const block=document.getElementById('facilityBlock');
 if(block){let summary=document.getElementById('selectedFacilitySummary');if(!summary){summary=document.createElement('div');summary.id='selectedFacilitySummary';summary.className='selected-summary';block.appendChild(summary);}summary.innerHTML=`<div><span class="small">Unidade selecionada</span><strong>${f.name}</strong><span class="small">${f.type}</span></div><button type="button" class="button secondary compact" onclick="changeFacility()">ALTERAR</button>`;}
}
function changeFacility(){
 const list=document.getElementById('facilityChoices');if(list){list.classList.remove('hidden');list.removeAttribute('aria-hidden');}
 const summary=document.getElementById('selectedFacilitySummary');if(summary)summary.remove();
 selectedFacility='';selectedRate=0;selectedOriginal=0;updateFormProgress();
}

function fillSpecialties(filter=''){const s=document.getElementById('specialty');if(!s)return;const vals=specialties.filter(x=>x.toLowerCase().includes(filter.toLowerCase()));s.innerHTML='<option value="">Selecionar especialidade</option>'+vals.map(x=>`<option>${x}</option>`).join('')}
function filterSpecialties(){fillSpecialties(document.getElementById('specialtySearch').value)}
function selectUrgency(v,el){document.getElementById('urgency').value=v;el.parentElement.querySelectorAll('.choice').forEach(x=>x.classList.remove('active'));el.classList.add('active')}
function buildMinorServiceLanding(){const el=document.getElementById('genericForm');el.classList.remove('hidden');el.innerHTML=`<div class="section"><div class="section-title">COMO PRETENDE CONTINUAR?</div><h3>Documentos de viagem para menores</h3><p class="small">Consulte primeiro o preço da prestação. O formulário com os dados do pai, da mãe, do(s) menor(es) e da viagem só será aberto quando escolher solicitar o documento.</p><button class="button" onclick="genericPrice()">CONSULTAR PREÇO DA PRESTAÇÃO</button><button type="button" class="button secondary" onclick="openMinorRequestForm()">SOLICITAR DOCUMENTO</button><button type="button" class="button secondary" onclick="openPaidDocumentLookup()">CONSULTAR DOCUMENTO PAGO</button></div>`;}
const ANGOLA_PROVINCES={
  "Bengo":["Dande","Nambuangongo","Ambriz","Dembos","Pango Aluquém","Quibaxe"],
  "Benguela":["Benguela","Lobito","Catumbela","Baía Farta","Balombo","Bocoio","Caimbambo","Chongorói","Cubal","Ganda"],
  "Bié":["Cuito","Andulo","Camacupa","Catabola","Chinguar","Chitembo","Cuemba","Cunhinga","Nharea"],
  "Cabinda":["Cabinda","Belize","Buco-Zau","Cacongo"],
  "Cuando Cubango":["Menongue","Calai","Cuangar","Cuchi","Dirico","Mavinga","Nancova","Rivungo"],
  "Cuanza Norte":["Ndalatando","Ambaca","Banga","Bolongongo","Cambambe","Cazengo","Golungo Alto","Lucala","Quiculungo","Samba Cajú"],
  "Cuanza Sul":["Sumbe","Amboim","Cassongue","Cela","Conda","Ebo","Libolo","Mussende","Porto Amboim","Quibala","Quilenda"],
  "Cunene":["Ondjiva","Cahama","Cuanhama","Cuvelai","Namacunde","Ombadja"],
  "Huambo":["Huambo","Bailundo","Caála","Catchiungo","Ecunha","Longonjo","Londuimbali","Mungo","Chicala-Choloanga","Chinjenje","Ucuma"],
  "Huíla":["Lubango","Caconda","Caluquembe","Chibia","Chicomba","Chipindo","Cuvango","Gambos","Humpata","Jamba","Matala","Quilengues","Quipungo"],
  "Icolo e Bengo":["Catete","Bom Jesus","Cabo Ledo","Quissama"],
  "Luanda":["Ingombota","Kilamba Kiaxi","Maianga","Rangel","Sambizanga","Talatona","Viana","Cacuaco","Belas"],
  "Lunda Norte":["Dundo","Cambulo","Capenda-Camulemba","Caungula","Chitato","Cuango","Lóvua","Lubalo","Xá-Muteba"],
  "Lunda Sul":["Saurimo","Cacolo","Dala","Muconda","Quirima"],
  "Malanje":["Malanje","Cacuso","Calandula","Cambundi-Catembo","Cangandala","Kiwaba Nzoji","Luquembo","Marimba","Massango","Mucari","Quela","Quirima"],
  "Moxico":["Luena","Alto Cuito","Bundas","Camanongue","Cameia","Léua","Luacano","Luau","Luchazes"],
  "Moxico Leste":["Cazombo","Alto Zambeze","Macongo","Lumbala Nguimbo","Luchinda"],
  "Namibe":["Moçâmedes","Bibala","Camucuio","Tômbwa","Virei"],
  "Uíge":["Uíge","Alto Cauale","Ambuila","Bembe","Buengas","Damba","Maquela do Zombo","Mucaba","Negage","Puri","Quimbele","Quitexe","Sanza Pombo","Songo"],
  "Zaire":["Mbanza Kongo","Cuimba","Nóqui","Nzeto","Soyo","Tomboco"]
};
function populateProvinceSelect(id){
  const el=document.getElementById(id); if(!el)return;
  el.innerHTML='<option value="">Província</option>'+Object.keys(ANGOLA_PROVINCES).map(p=>`<option value="${p}">${p}</option>`).join('');
}
function bindProvinceMunicipality(provinceId,municipalityId){
  const p=document.getElementById(provinceId),m=document.getElementById(municipalityId); if(!p||!m)return;
  const update=()=>{const list=ANGOLA_PROVINCES[p.value]||[];m.disabled=!p.value;m.innerHTML='<option value="">Município</option>'+list.map(x=>`<option value="${x}">${x}</option>`).join('');};
  p.addEventListener('change',update); update();
}
function initMinorLocationFilters(){
  populateProvinceSelect('minorFatherBirthProvince'); populateProvinceSelect('minorMotherBirthProvince');
  bindProvinceMunicipality('minorFatherBirthProvince','minorFatherBirthMunicipality');
  bindProvinceMunicipality('minorMotherBirthProvince','minorMotherBirthMunicipality');
}
function issuerOptions(type){
  if(type==='BI')return [{v:'DNI',t:'Direcção Nacional de Identificação (DNI)'}];
  if(type==='Passaporte')return [{v:'SME',t:'Serviço de Migração e Estrangeiros (SME)'}];
  return [];
}
function bindDocumentIssuer(typeId,issuerId){
  const t=document.getElementById(typeId),i=document.getElementById(issuerId); if(!t||!i)return;
  const update=()=>{const opts=issuerOptions(t.value);i.innerHTML='<option value="">Selecionar entidade emissora</option>'+opts.map(o=>`<option value="${o.v}">${o.t}</option>`).join('');};
  t.addEventListener('change',update); update();
}
function initMinorDocumentFilters(){
  bindDocumentIssuer('minorFatherDocType','minorFatherIssuer');
  bindDocumentIssuer('minorMotherDocType','minorMotherIssuer');
}

function openMinorRequestForm(){
  const el=document.getElementById('genericForm');
  if(!el)return;
  document.body.classList.add('minor-form-open');
  el.classList.remove('hidden');
  el.innerHTML=`<div style="position:sticky;top:0;z-index:10;background:#fff;text-align:right;padding:0 0 8px"><button type="button" class="button secondary" style="margin:0;width:auto" onclick="closeMinorForm()">FECHAR</button></div><div class="section"><div class="section-title">DADOS PARA PREPARAÇÃO DO DOCUMENTO</div>
  <h3>Dados do pai / responsável legal</h3>
  <div class="minor-form-block">
    <div class="grid"><div><label>Nome completo</label><input id="minorFatherName" placeholder="Nome completo do pai / responsável"></div><div><label>Nacionalidade</label><input id="minorFatherNationality" placeholder="Ex.: Angolana"></div></div>
    <div class="grid"><div><label>Local de nascimento</label><div class="minor-location-row"><select id="minorFatherBirthProvince"><option value="">Província</option></select><select id="minorFatherBirthMunicipality" disabled><option value="">Município</option></select></div></div><div><label>Data de nascimento</label><input id="minorFatherDob" type="date"></div></div>
    <div class="grid"><div><label>Estado civil</label><select id="minorFatherMarital"><option value="">Selecionar estado civil</option><option value="Solteiro">Solteiro</option><option value="Casado">Casado</option><option value="Divorciado">Divorciado</option><option value="Viúvo">Viúvo</option></select></div><div><label>Documento de identificação</label><select id="minorFatherDocType"><option value="">Selecionar documento</option><option value="BI">Bilhete de Identidade</option><option value="Passaporte">Passaporte</option></select><input id="minorFatherDoc" placeholder="Número do documento"></div></div>
    <div class="grid"><div><label>Entidade emissora</label><select id="minorFatherIssuer"><option value="">Selecionar entidade emissora</option></select><div class="minor-filter-note">A entidade é filtrada conforme o documento selecionado.</div></div><div><label>Data de emissão</label><input id="minorFatherIssueDate" type="date"></div></div>
    <label>Residência</label><input id="minorFatherResidence" placeholder="Município, bairro / distrito">
  </div></div>

  <div class="section"><h3>Dados da mãe / adulta acompanhante</h3><div class="minor-form-block">
    <div class="grid"><div><label>Nome completo</label><input id="minorMotherName" placeholder="Nome completo da mãe / acompanhante"></div><div><label>Nacionalidade</label><input id="minorMotherNationality" placeholder="Ex.: Angolana"></div></div>
    <div class="grid"><div><label>Filha de / Filho de — Pai</label><input id="minorMotherFatherName" placeholder="Nome do pai"></div><div><label>Filha de / Filho de — Mãe</label><input id="minorMotherMotherName" placeholder="Nome da mãe"></div></div>
    <div class="grid"><div><label>Local de nascimento</label><div class="minor-location-row"><select id="minorMotherBirthProvince"><option value="">Província</option></select><select id="minorMotherBirthMunicipality" disabled><option value="">Município</option></select></div></div><div><label>Data de nascimento</label><input id="minorMotherDob" type="date"></div></div>
    <div class="grid"><div><label>Estado civil</label><select id="minorMotherMarital"><option value="">Selecionar estado civil</option><option value="Solteira">Solteira</option><option value="Casada">Casada</option><option value="Divorciada">Divorciada</option><option value="Viúva">Viúva</option></select></div><div><label>Documento de identificação</label><select id="minorMotherDocType"><option value="">Selecionar documento</option><option value="BI">Bilhete de Identidade</option><option value="Passaporte">Passaporte</option></select><input id="minorMotherDoc" placeholder="Número do documento"></div></div>
    <div class="grid"><div><label>Entidade emissora</label><select id="minorMotherIssuer"><option value="">Selecionar entidade emissora</option></select><div class="minor-filter-note">A entidade é filtrada conforme o documento selecionado.</div></div><div><label>Data de emissão</label><input id="minorMotherIssueDate" type="date"></div></div>
    <label>Residência</label><input id="minorMotherResidence" placeholder="Município, bairro / distrito">
  </div></div>

  <div class="section"><div class="section-title">DADOS DOS MENORES</div><div class="minor-form-block"><div id="minorChildrenContainer"></div><button type="button" class="button secondary" style="margin-top:12px" onclick="addMinorChild()">+ ADICIONAR OUTRO MENOR</button></div></div>

  <div class="section"><div class="section-title">DADOS DA VIAGEM</div><div class="minor-form-block">
    <div class="grid"><div><label>Local de partida</label><input id="minorOrigin" placeholder="Ex.: Luanda, Angola"></div><div><label>Destino da viagem</label><input id="minorDestination" placeholder="Ex.: Windhoek, Namíbia"></div></div>
    <div class="grid"><div><label>Período de permanência</label><input id="minorStay" placeholder="Ex.: 30 dias"></div><div><label>Acompanhante da viagem</label><input id="minorTravelCompanion" placeholder="Nome do adulto acompanhante"></div></div>
    <div class="grid"><div><label>Local de assinatura</label><input id="minorSigningPlace" placeholder="Cidade / província"></div><div><label>Data da autorização</label><input id="minorSigningDate" type="date"></div></div>
  </div></div>
  <div class="notice">Os dados preenchidos serão utilizados para gerar automaticamente as versões em Português e Inglês do documento. Os dados de exemplo do modelo não serão utilizados.</div>
  <div class="grid"><button type="button" class="button secondary" onclick="submitMinorRequest()">SOLICITAR ESTE SERVIÇO</button><button type="button" class="button" onclick="proceedMinorCheckout()">PAGAR DOCUMENTOS</button></div>
  </div>`;
  buildMinorChildren();
  initMinorLocationFilters();
  initMinorDocumentFilters();
}
function submitMinorRequest(){const d=collectMinorFormData();if(!d){alert('Preencha todos os dados obrigatórios antes de solicitar o serviço.');return}const req={id:'APSAN-DOC-'+Date.now(),service:'minorstranslation',clientName:'',status:'requested',paymentStatus:'Aguardando pagamento',createdAt:new Date().toISOString(),total:7000,rows:minorRowsFromData(d),minorData:d,title:'Documentos de viagem para menores'};const a=getMinorRequests();a.push(req);saveMinorRequests(a);alert('Solicitação registada. O documento foi preparado com os dados fornecidos e aguarda a conclusão do pagamento para entrar em análise.');}
function proceedMinorCheckout(){const d=collectMinorFormData();if(!d){alert('Preencha todos os dados obrigatórios antes de avançar para o pagamento.');return}lastResultData={...(lastResultData||{}),title:'Documentos de viagem para menores',location:'Preparação do documento',total:7000,rows:minorRowsFromData(d),minorData:d};proceedCheckout();}
function buildGenericForm(key){const el=document.getElementById('genericForm');el.classList.remove('hidden');const forms={
translation:[['Tipo de serviço','<select id="translationType" onchange="updateTranslationFields()"><option value="document">Tradução de documentos</option><option value="interpreter">Intérprete</option><option value="literal">Tradução literal</option><option value="consecutive">Interpretação consecutiva</option><option value="simultaneous">Interpretação simultânea</option></select>'],['Idioma','<select id="translationLanguage"><option>Português → Inglês</option><option>Inglês → Português</option></select>'],['Quantidade / duração','<div id="translationQuantityWrap"><input id="translationQuantity" type="number" min="1" value="1"></div>'],['Informação do serviço','<div id="translationPriceHint" class="notice">Preencha os dados e clique em “CONSULTAR PREÇO DA PRESTAÇÃO” para ver o valor.</div>']],
sworn:[['Tipo de documento','<select id="g1"><option>Certidão</option><option>Diploma / certificado</option><option>Documento jurídico</option><option>Outro</option></select>'],['Número de páginas','<input id="g2" type="number" min="1" value="1">'],['Idioma','<select id="g3"><option>Português → Inglês</option><option>Inglês → Português</option></select>']],
exchange:[['Forma de assistência','<select id="g1"><option>Depósito diretamente no banco</option><option>Depósito através da Shoprite</option></select>'],['Valor a depositar','<input id="g2" type="text" inputmode="decimal" autocomplete="off" placeholder="Ex.: 300 000,00" oninput="formatKzInput(this)" onblur="formatKzInput(this,true)" data-money-input="true">']],
import:[['Tipo de mercadoria','<input id="g1" placeholder="Descreva a mercadoria">'],['Origem','<input id="g2" placeholder="País / cidade">'],['Destino','<input id="g3" placeholder="País / cidade">'],['Quantidade','<input id="g4" type="number" min="1" value="1">']],
visa:[['Tipo de visto','<select id="g1"><option>Turismo</option><option>Estudo</option><option>Trabalho</option><option>Outro</option></select>'],['Nacionalidade','<input id="g2" placeholder="Nacionalidade">'],['Quantidade de pessoas','<input id="g3" type="number" min="1" value="1">']],
business:[['Tipo de consultoria','<select id="g1"><option>Abertura de empresa</option><option>Planeamento empresarial</option><option>Estrutura financeira</option><option>Outro</option></select>']],
audit:[['Tipo de auditoria','<select id="g1"><option>Financeira</option><option>Conformidade</option><option>Empresarial</option></select>']],
marketing:[['Serviço pretendido','<select id="g1"><option>Campanha publicitária</option><option>Design gráfico</option><option>Identidade visual</option></select>'],['Quantidade','<input id="g2" type="number" min="1" value="1">']],
minorstranslation:[['Dados do pai / responsável legal','<div class="minor-form-block"><div class="grid"><div><label>Nome completo</label><input id="minorFatherName" placeholder="Nome completo do pai / responsável"></div><div><label>Nacionalidade</label><input id="minorFatherNationality" placeholder="Ex.: Angolana"></div></div><div class="grid"><div><label>Local de nascimento</label><input id="minorFatherBirthPlace" placeholder="Cidade / província"></div><div><label>Data de nascimento</label><input id="minorFatherDob" type="date"></div></div><div class="grid"><div><label>Estado civil</label><input id="minorFatherMarital" placeholder="Ex.: Solteiro(a) / Casado(a)"></div><div><label>N.º do documento de identificação</label><input id="minorFatherDoc" placeholder="BI / Passaporte"></div></div><div class="grid"><div><label>Entidade emissora</label><input id="minorFatherIssuer" placeholder="Entidade emissora"></div><div><label>Data de emissão</label><input id="minorFatherIssueDate" type="date"></div></div><label>Residência</label><input id="minorFatherResidence" placeholder="Município, bairro / distrito"></div>'],['Dados da mãe / adulta acompanhante','<div class="minor-form-block"><div class="grid"><div><label>Nome completo</label><input id="minorMotherName" placeholder="Nome completo da mãe / acompanhante"></div><div><label>Nacionalidade</label><input id="minorMotherNationality" placeholder="Ex.: Angolana"></div></div><div class="grid"><div><label>Filha de / Filho de — Pai</label><input id="minorMotherFatherName" placeholder="Nome do pai da mãe / acompanhante"></div><div><label>Filha de / Filho de — Mãe</label><input id="minorMotherMotherName" placeholder="Nome da mãe da mãe / acompanhante"></div></div><div class="grid"><div><label>Local de nascimento</label><input id="minorMotherBirthPlace" placeholder="Cidade / província"></div><div><label>Data de nascimento</label><input id="minorMotherDob" type="date"></div></div><div class="grid"><div><label>Estado civil</label><input id="minorMotherMarital" placeholder="Ex.: Solteira / Casada"></div><div><label>N.º do documento de identificação</label><input id="minorMotherDoc" placeholder="BI / Passaporte"></div></div><div class="grid"><div><label>Entidade emissora</label><input id="minorMotherIssuer" placeholder="Entidade emissora"></div><div><label>Data de emissão</label><input id="minorMotherIssueDate" type="date"></div></div><label>Residência</label><input id="minorMotherResidence" placeholder="Município, bairro / distrito"></div>'],['Dados dos menores','<div class="minor-form-block"><div id="minorChildrenContainer"></div><button type="button" class="button secondary" style="margin-top:12px" onclick="addMinorChild()">+ ADICIONAR OUTRO MENOR</button></div>'],['Dados da viagem','<div class="minor-form-block"><div class="grid"><div><label>Local de partida</label><input id="minorOrigin" placeholder="Ex.: Huambo, Angola"></div><div><label>Destino da viagem</label><input id="minorDestination" placeholder="Ex.: Namíbia"></div></div><div class="grid"><div><label>Período de permanência</label><input id="minorStay" placeholder="Ex.: 30 dias"></div><div><label>Acompanhante da viagem</label><input id="minorTravelCompanion" placeholder="Ex.: mãe / pai / responsável"></div></div><div class="grid"><div><label>Local de assinatura</label><input id="minorSigningPlace" placeholder="Cidade / província"></div><div><label>Data da autorização</label><input id="minorSigningDate" type="date"></div></div></div>']],software:[['Tipo de sistema','<select id="softwareType"><option value="management">Sistema de gestão empresarial</option><option value="sales">Sistema de vendas</option><option value="stock">Sistema de stock</option><option value="custom">Software personalizado</option><option value="platform">Plataforma web</option></select>'],['Tipo de empresa','<select id="softwareCompanyType"><option value="">Selecionar tipo de empresa</option><option value="small">Pequena empresa — Cantina / Mini loja</option><option value="medium">Média empresa</option><option value="large">Grande empresa</option></select>']],
website:[['Tipo de website','<select id="g1"><option>Institucional</option><option>Loja online</option><option>Portal / plataforma</option><option>Landing page</option></select>'],['Tipo de empresa','<select id="websiteCompanyType"><option value="">Selecionar tipo de empresa</option><option value="small">Pequena empresa</option><option value="medium">Média empresa</option><option value="large">Grande empresa</option></select>']],
language:[['Idioma','<select id="g1"><option>Inglês</option><option>Português</option></select>'],['Modalidade','<select id="g2"><option>Online</option><option>Presencial</option></select>'],['Quantidade de alunos','<input id="g3" type="number" min="1" value="1">']],
tourism:[['Destino / local','<input id="g1" placeholder="Destino pretendido">'],['Número de dias','<input id="g2" type="number" min="1" value="1">'],['Quantidade de pessoas','<input id="g3" type="number" min="1" value="1">']],
shopping:[['Local para realizar as compras','<select id="shopLocation"><option value="">Selecionar local</option><option>Oshikango (Santa Clara)</option><option>Oshakati</option><option>Ongwediva</option><option>Ondangwa</option></select>'],['Tipo de compras','<select id="shopCategory"><option value="">Selecionar categoria</option><option value="cosmetics">Cosméticos</option><option value="food">Alimentos</option><option value="furniture">Mobiliários</option><option value="construction">Materiais de construção</option><option value="mixed">Tudo um pouco</option><option value="clothing">Vestuário / Roupas</option><option value="shoes">Calçados</option><option value="electronics">Eletrónicos</option><option value="household">Artigos para casa</option><option value="medicines">Medicamentos</option><option value="other">Outros</option></select>'],['Valor estimado da compra','<input id="shopInvestment" type="text" inputmode="decimal" autocomplete="off" placeholder="Ex.: 100 000,00" oninput="formatKzInput(this)" onblur="formatKzInput(this,true)">'],['Tamanho da compra','<select id="shopSize"><option value="">Selecionar</option><option value="small">Pequena — poucos produtos</option><option value="medium">Média — quantidade moderada</option><option value="large">Grande — muitos produtos</option></select>'],['Número de lojas','<select id="shopStores"><option value="1">1 loja</option><option value="2">2–3 lojas</option><option value="4">4 ou mais lojas</option></select>'],['Urgência','<select id="shopUrgency"><option>Prazo normal</option><option>Urgente</option></select>']],
pricecheck:[['Local para consultar o preço','<select id="priceCheckLocation"><option value="">Selecionar local</option><option>Oshikango (Santa Clara)</option><option>Oshakati</option><option>Ongwediva</option><option>Ondangwa</option></select>'],['Produto / artigo','<input id="priceCheckProduct" placeholder="Descreva o produto que deseja consultar">']],borderescort:[['Local da travessia','<select id="borderEscortLocation"><option value="">Selecionar local</option><option>Oshikango (Santa Clara)</option><option>Oshakati</option><option>Ongwediva</option><option>Ondangwa</option></select>'],['Vai levar mercadorias, malas ou coisas pesadas?','<select id="borderEscortHeavy"><option value="">Selecionar</option><option>Sim</option><option>Não</option></select>']],shoppingescort:[['Local das compras','<select id="shoppingEscortLocation"><option value="">Selecionar local</option><option>Oshikango (Santa Clara)</option><option>Oshakati</option><option>Ongwediva</option><option>Ondangwa</option></select>']],
parcel:[['Tipo de encomenda','<select id="parcelType" onchange="updateParcelHint()"><option value="envelope">Envelope</option><option value="cargo">Carga</option></select>'],['Transportadora','<select id="parcelCarrier"><option value="">Selecionar transportadora</option><option value="macon">Macon</option><option value="huambo">Huambo Express</option></select>'],['Província de destino','<select id="parcelProvince" onchange="loadParcelMunicipalities()"><option value="">Selecionar província</option></select>'],['Município de destino','<select id="parcelMunicipality" disabled><option>Primeiro selecione a província</option></select>'],['Quantidade','<input id="parcelQty" type="number" min="1" value="1">']],
social:[['Tipo de gestão','<select id="socialType"><option value="monthly">Gestão de redes sociais</option></select>'],['Quantidade de meses','<input id="socialMonths" type="number" min="1" value="1">']],
promotion:[['Plano de promoção','<select id="promotionPlan" onchange="updatePromotionFields()"><option value="daily">Plano diário</option><option value="weekly">Plano semanal</option></select>'],['Quantidade','<input id="promotionQty" type="number" min="1" value="1">'],['Prazo de promoção','<select id="promotionUrgency"><option>Prazo normal</option><option>Urgente</option></select>']]
};const fields=forms[key]||[['Quantidade','<input id="genericQty" type="number" min="1" value="1">']];el.innerHTML='<div class="section"><div class="section-title">DADOS PARA A CONSULTA</div><h3>Informações do serviço</h3>'+fields.map(f=>`<label>${f[0]}</label>${f[1]}`).join('')+'<div id="servicePriceHint" class="notice hidden"></div></div><button class="button" onclick="genericPrice()">CONSULTAR PREÇO DA PRESTAÇÃO</button>'+(key==='minorstranslation'?'<button type="button" class="button secondary" onclick="openPaidDocumentLookup()">CONSULTAR DOCUMENTO PAGO</button>':'');if(key==='parcel')fillParcelProvinces();if(key==='minorstranslation')buildMinorChildren();updateShoppingHint();updateParcelHint();if(key==='translation')updateTranslationFields();if(key==='promotion')updatePromotionFields();}
function updateTranslationFields(){if(currentService!=='translation')return;const type=document.getElementById('translationType')?.value,q=document.getElementById('translationQuantity'),hint=document.getElementById('translationPriceHint');if(!type||!q||!hint)return;if(type==='document'||type==='literal'){q.placeholder='Número de páginas';q.value=Math.max(1,Number(q.value)||1);}else{q.placeholder='Número de dias';q.value=Math.max(1,Number(q.value)||1);}hint.textContent='Preencha os dados e clique em “CONSULTAR PREÇO DA PRESTAÇÃO” para ver o valor.';} function updateShoppingHint(){return} function updatePromotionFields(){if(currentService!=='promotion')return;const plan=document.getElementById('promotionPlan')?.value||'daily',q=document.getElementById('promotionQty');if(!q)return;q.placeholder=plan==='weekly'?'Número de semanas':'Número de dias';q.value=Math.max(1,Number(q.value)||1);const labels=q.closest('.section')?.querySelectorAll('label');if(labels&&labels[1])labels[1].textContent=plan==='weekly'?'Quantidade de semanas':'Quantidade de dias';}
function updateParcelHint(){if(currentService!=='parcel')return;const v=document.getElementById('parcelType')?.value,carrier=document.getElementById('parcelCarrier');const hint=document.getElementById('servicePriceHint');if(!hint||!v)return;hint.classList.remove('hidden');if(v==='envelope'){hint.textContent='Para envelope, selecione a transportadora. O frete e a prestação de serviço serão apresentados somente depois da consulta do preço.'}else{hint.textContent='SERVIÇO INDISPONÍVEL — o envio de encomendas de carga está temporariamente indisponível.'}if(carrier){const carrierLabel=carrier.previousElementSibling;carrierLabel?.classList.toggle('hidden',v!=='envelope');carrier.disabled=v!=='envelope';if(v!=='envelope')carrier.value=''}}
function money(n){return new Intl.NumberFormat('pt-AO').format(n)+' Kz'}
function showLoadingThenResult(data){setStage('loading');setTimeout(()=>{history.pushState({stage:'result',data},'',`#resultado-${currentService}`);showResult(data,true)},1000)}
function consultPrice(){const p=document.getElementById('province').value,m=document.getElementById('municipality').value,travel=document.getElementById('travelling').value,date=document.getElementById('serviceDate').value,q=Math.max(1,Number(document.getElementById('quantity').value)||1),age=Number(document.getElementById('age').value),sp=document.getElementById('specialty').value,u=document.getElementById('urgency').value,days=Math.max(1,Number(document.getElementById('hospitalDays')?.value)||1);if(!p||!m||!travel||!date||!selectedCity||!selectedFacility||!sp||!u||Number.isNaN(age)){alert('Preencha todas as informações desta etapa antes de consultar o preço.');return}if(selectedCity==='Windhoek'){const total=selectedRate*days*q;showLoadingThenResult({title:'Acompanhamento Hospitalar',location:selectedCity+' • '+selectedFacility,total,rows:[['Origem',p+' • '+m],['Viagem para a Namíbia',travel],['Data pretendida',new Date(date+'T12:00:00').toLocaleDateString('pt-PT')],['Destino',selectedCity],['Unidade',selectedFacility],['Especialidade',sp],['Idade',age+' anos'],['Quantidade',q+' pessoa(s)'],['Dias de acompanhamento',days+' dia(s)'],['Urgência',u],['Prestação de serviço APSAN, LDA por dia',money(selectedRate)],['Prestação de serviço APSAN, LDA',money(total)],['Táxi do técnico','Sob responsabilidade do cliente'],['Alimentação','Sob responsabilidade do cliente'],['Alojamento','Sob responsabilidade do cliente']]});return}const serviceOriginal=22000,serviceDiscount=2000,serviceDaily=20000;const displacement=8000;const serviceTotal=serviceDaily*days*q;const total=serviceTotal+displacement;showLoadingThenResult({title:'Acompanhamento Hospitalar',location:selectedCity+' • '+selectedFacility,total,serviceAmount:serviceTotal,locationSurcharge:displacement,rows:[['Origem',p+' • '+m],['Viagem para a Namíbia',travel],['Data pretendida',new Date(date+'T12:00:00').toLocaleDateString('pt-PT')],['Destino',selectedCity],['Unidade',selectedFacility],['Especialidade',sp],['Idade',age+' anos'],['Quantidade',q+' pessoa(s)'],['Dias de acompanhamento',days+' dia(s)'],['Urgência',u]],pricingRows:[['Prestação APSAN, LDA por dia',money(serviceOriginal)],['Desconto APSAN, LDA por dia',money(serviceDiscount)],['Preço final por dia',money(serviceDaily)],['Prestação APSAN, LDA — '+days+' dia(s)',money(serviceTotal)],['Táxi do técnico APSAN, LDA',money(displacement)]]})}
function formatDocDate(v,lang='pt'){
  if(!v)return '';
  const d=new Date(v+'T12:00:00');
  if(isNaN(d))return v;
  const monthsPt=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
  const monthsEn=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const months=lang==='en'?monthsEn:monthsPt;
  return `${String(d.getDate()).padStart(2,'0')} de ${months[d.getMonth()]} de ${d.getFullYear()}`.replace(/^(\d{2}) de (January|February|March|April|May|June|July|August|September|October|November|December) de /,(_,day,month)=>`${day} ${month} `);
}
function addMinorChild(values={}){
  const box=document.getElementById('minorChildrenContainer');if(!box)return;
  const n=box.querySelectorAll('.minor-child-card').length+1;
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  box.insertAdjacentHTML('beforeend',`<div class="minor-child-card" data-child-index="${n}">
    <div class="minor-child-head"><span>Menor ${n}</span><button type="button" class="minor-child-remove" onclick="this.closest('.minor-child-card').remove();renumberMinorChildren()">REMOVER</button></div>
    <div class="grid"><div><label>Nome completo</label><input class="minor-child-name" placeholder="Nome completo do menor" value="${esc(values.name)}"></div><div><label>Nacionalidade</label><input class="minor-child-nationality" placeholder="Ex.: Angolana" value="${esc(values.nationality||'Angolana')}"></div></div>
    <div class="grid"><div><label>Local de nascimento</label><div class="minor-location-row"><select class="minor-child-birth-province"><option value="">Província</option></select><select class="minor-child-birth-municipality" disabled><option value="">Município</option></select></div></div><div><label>Data de nascimento</label><input class="minor-child-dob" type="date" value="${esc(values.dob)}"></div></div>
    <div class="grid"><div><label>Documento de identificação</label><select class="minor-child-doc-type"><option value="">Selecionar documento</option><option value="BI">Bilhete de Identidade</option><option value="Passaporte">Passaporte</option></select><input class="minor-child-doc" placeholder="Número do documento" value="${esc(values.doc)}"></div><div><label>Entidade emissora</label><select class="minor-child-issuer"><option value="">Selecionar entidade emissora</option></select></div></div>
    <div><label>Data de emissão</label><input class="minor-child-issue-date" type="date" value="${esc(values.issueDate)}"></div>
  </div>`);
  const card=box.lastElementChild,p=card.querySelector('.minor-child-birth-province'),m=card.querySelector('.minor-child-birth-municipality'),dt=card.querySelector('.minor-child-doc-type'),iss=card.querySelector('.minor-child-issuer');
  p.innerHTML='<option value="">Província</option>'+Object.keys(ANGOLA_PROVINCES).map(x=>`<option value="${x}">${x}</option>`).join('');
  p.addEventListener('change',()=>{const list=ANGOLA_PROVINCES[p.value]||[];m.disabled=!p.value;m.innerHTML='<option value="">Município</option>'+list.map(x=>`<option value="${x}">${x}</option>`).join('');});
  dt.addEventListener('change',()=>{iss.innerHTML='<option value="">Selecionar entidade emissora</option>'+issuerOptions(dt.value).map(o=>`<option value="${o.v}">${o.t}</option>`).join('');});
  if(values.birthProvince){p.value=values.birthProvince;p.dispatchEvent(new Event('change'));if(values.birthMunicipality)m.value=values.birthMunicipality;}
  if(values.docType){dt.value=values.docType;dt.dispatchEvent(new Event('change'));}
  if(values.issuer)iss.value=values.issuer;
}
function renumberMinorChildren(){document.querySelectorAll('#minorChildrenContainer .minor-child-card').forEach((c,i)=>{c.dataset.childIndex=i+1;const h=c.querySelector('.minor-child-head span');if(h)h.textContent='Menor '+(i+1);});}
function buildMinorChildren(initial=[]){const box=document.getElementById('minorChildrenContainer');if(!box)return;box.innerHTML='';(initial.length?initial:[{}]).forEach(v=>addMinorChild(v));}
function collectMinorFormData(){
  const get=id=>(document.getElementById(id)?.value||'').trim();
  const loc=(p,m)=>[get(p),get(m)].filter(Boolean).join(' — ');
  const father={name:get('minorFatherName'),nationality:get('minorFatherNationality'),birthPlace:loc('minorFatherBirthProvince','minorFatherBirthMunicipality'),birthProvince:get('minorFatherBirthProvince'),birthMunicipality:get('minorFatherBirthMunicipality'),dob:get('minorFatherDob'),marital:get('minorFatherMarital'),doc:get('minorFatherDoc'),docType:get('minorFatherDocType'),issuer:get('minorFatherIssuer'),issueDate:get('minorFatherIssueDate'),residence:get('minorFatherResidence')};
  const mother={name:get('minorMotherName'),nationality:get('minorMotherNationality'),fatherName:get('minorMotherFatherName'),motherName:get('minorMotherMotherName'),birthPlace:loc('minorMotherBirthProvince','minorMotherBirthMunicipality'),birthProvince:get('minorMotherBirthProvince'),birthMunicipality:get('minorMotherBirthMunicipality'),dob:get('minorMotherDob'),marital:get('minorMotherMarital'),doc:get('minorMotherDoc'),docType:get('minorMotherDocType'),issuer:get('minorMotherIssuer'),issueDate:get('minorMotherIssueDate'),residence:get('minorMotherResidence')};
  const children=[...document.querySelectorAll('#minorChildrenContainer .minor-child-card')].map(c=>({
    name:(c.querySelector('.minor-child-name')?.value||'').trim(),
    nationality:(c.querySelector('.minor-child-nationality')?.value||'').trim(),
    birthProvince:c.querySelector('.minor-child-birth-province')?.value||'',
    birthMunicipality:c.querySelector('.minor-child-birth-municipality')?.value||'',
    birthPlace:[c.querySelector('.minor-child-birth-province')?.value||'',c.querySelector('.minor-child-birth-municipality')?.value||''].filter(Boolean).join(' — '),
    dob:c.querySelector('.minor-child-dob')?.value||'',
    docType:c.querySelector('.minor-child-doc-type')?.value||'',
    doc:(c.querySelector('.minor-child-doc')?.value||'').trim(),
    issuer:c.querySelector('.minor-child-issuer')?.value||'',
    issueDate:c.querySelector('.minor-child-issue-date')?.value||''
  }));
  const trip={origin:get('minorOrigin'),destination:get('minorDestination'),stay:get('minorStay'),companion:get('minorTravelCompanion'),signingPlace:get('minorSigningPlace'),signingDate:get('minorSigningDate')};
  if(!father.name||!father.nationality||!father.birthPlace||!father.dob||!father.marital||!father.doc||!father.docType||!father.issuer||!father.issueDate||!father.residence||!mother.name||!mother.nationality||!mother.fatherName||!mother.motherName||!mother.birthPlace||!mother.dob||!mother.marital||!mother.doc||!mother.docType||!mother.issuer||!mother.issueDate||!mother.residence||!children.length||children.some(c=>!c.name||!c.nationality||!c.birthPlace||!c.dob||!c.doc||!c.docType||!c.issuer||!c.issueDate)||!trip.origin||!trip.destination||!trip.stay||!trip.companion||!trip.signingPlace||!trip.signingDate)return null;
  return {father,mother,children,trip};
}
function minorRowsFromData(d){const rows=[['Pai',d.father.name],['Nacionalidade do pai',d.father.nationality],['Local de nascimento do pai',d.father.birthPlace],['Data de nascimento do pai',formatDocDate(d.father.dob)],['Estado civil do pai',d.father.marital],['Documento do pai',d.father.doc],['Entidade emissora do documento do pai',d.father.issuer],['Data de emissão do documento do pai',formatDocDate(d.father.issueDate)],['Residência do pai',d.father.residence],['Mãe / acompanhante',d.mother.name],['Nacionalidade da mãe / acompanhante',d.mother.nationality],['Pai da mãe / acompanhante',d.mother.fatherName],['Mãe da mãe / acompanhante',d.mother.motherName],['Local de nascimento da mãe / acompanhante',d.mother.birthPlace],['Data de nascimento da mãe / acompanhante',formatDocDate(d.mother.dob)],['Estado civil da mãe / acompanhante',d.mother.marital],['Documento da mãe / acompanhante',d.mother.doc],['Entidade emissora do documento da mãe / acompanhante',d.mother.issuer],['Data de emissão do documento da mãe / acompanhante',formatDocDate(d.mother.issueDate)],['Residência da mãe / acompanhante',d.mother.residence]];d.children.forEach((c,i)=>{const n=i+1;rows.push([`Menor ${n}`,c.name],[`Nacionalidade do menor ${n}`,c.nationality],[`Data de nascimento do menor ${n}`,formatDocDate(c.dob)],[`Documento do menor ${n}`,c.doc],[`Entidade emissora do documento do menor ${n}`,c.issuer],[`Data de emissão do documento do menor ${n}`,formatDocDate(c.issueDate)]);});rows.push(['Local de partida',d.trip.origin],['Destino da viagem',d.trip.destination],['Período de permanência',d.trip.stay],['Acompanhante da viagem',d.trip.companion],['Local de assinatura',d.trip.signingPlace],['Data da autorização',formatDocDate(d.trip.signingDate)],['Versões do documento','Português e Inglês'],['Finalidade','Documento de viagem para menor']);return rows;}
function genericPrice(){let total=0,rows=[];if(currentService==='shopping'){const loc=document.getElementById('shopLocation').value,cat=document.getElementById('shopCategory').value,investment=Math.max(0,parseKzInput(document.getElementById('shopInvestment').value)||0),size=document.getElementById('shopSize').value,stores=document.getElementById('shopStores').value,urgency=document.getElementById('shopUrgency').value;const labels={cosmetics:'Cosméticos',food:'Alimentos',furniture:'Mobiliários',construction:'Materiais de construção',mixed:'Tudo um pouco',clothing:'Vestuário / Roupas',shoes:'Calçados',electronics:'Eletrónicos',household:'Artigos para casa',medicines:'Medicamentos',other:'Outros'};if(!loc||!cat||!investment||(cat!=='medicines'&&!size)){alert('Preencha o local, categoria, valor estimado'+(cat==='medicines'?'':' e tamanho da compra')+' antes de consultar o preço.');return}let base;if(cat==='medicines'){base=Math.max(1000,Math.round(investment*0.07))}else if(investment>1000000){base=null}else if(investment>500000){base=Math.round(investment*0.10)}else if(investment>=400000){base=25000}else if(investment>=300000){base=20000}else if(investment>=200000){base=15000}else if(investment>=150000){base=12000}else if(investment>=110000){base=10000}else if(investment>=80000){base=9000}else if(investment>=50000){base=8000}else if(investment>=10000){base=7000}else if(investment===6000){base=2000}else if(investment===4000){base=1500}else if(investment<=5000){base=1000}else{base=Math.max(2000,2000+Math.ceil(Math.max(0,investment-6000)/2000)*1000)}if(cat!=='medicines'&&investment<=500000){base=Math.min(base,investment>=400000?25000:investment>=300000?20000:investment>=200000?15000:investment>=150000?12000:investment>=110000?10000:investment>=80000?9000:investment>=50000?8000:7000)}if(base===null){showLoadingThenResult({title:'Compras na Namíbia',location:loc,total:null,purchaseAmount:investment,rows:[['Local das compras',loc],['Categoria',labels[cat]],['Valor estimado da compra',money(investment)],['Prestação de serviço','Cotação personalizada']]});return}const sizeAdd=cat==='medicines'?0:(size==='small'?0:size==='medium'?2000:5000);const storeAdd=cat==='medicines'?0:(stores==='1'?0:stores==='2'?2000:4000);const urgencyAdd=cat==='medicines'?0:(urgency==='Urgente'?3000:0);const locationSurcharge=0;const serviceFee=cat==='medicines'?base:Math.min(base,base);total=serviceFee+locationSurcharge;rows=[['Local das compras',loc],['Categoria',labels[cat]],['Valor estimado da compra',money(investment)],...(cat==='medicines'?[]:[['Tamanho',size==='small'?'Pequena':size==='medium'?'Média':'Grande'],['Lojas',stores==='1'?'1 loja':stores==='2'?'2–3 lojas':'4 ou mais lojas'],['Urgência',urgency],['Ajustes de complexidade',money(sizeAdd+storeAdd+urgencyAdd)]]),['Prestação de serviço',money(serviceFee)],['Táxi do técnico APSAN, LDA',money(locationSurcharge)]];}else if(currentService==='exchange'){const method=document.getElementById('g1')?.value||'',deposit=parseKzInput(document.getElementById('g2')?.value||'');if(!(deposit>0)){alert('Introduza o valor a depositar antes de consultar o preço.');return}total=10000;rows=[['Forma de assistência',method],['Valor a depositar',money(deposit)],['Prestação de serviço',money(total)]];}else if(currentService==='pricecheck'){const loc=document.getElementById('priceCheckLocation').value,product=document.getElementById('priceCheckProduct').value.trim();if(!loc||!product){alert('Preencha o local e o produto antes de consultar o preço.');return}const locationSurcharge=['Oshakati','Ongwediva','Ondangwa'].includes(loc)?8000:0;total=2000+locationSurcharge;rows=[['Local da consulta',loc],['Produto / artigo',product],['Prestação de serviço',money(2000)],['Táxi do técnico APSAN, LDA',money(locationSurcharge)]];}else if(currentService==='borderescort'){const loc=document.getElementById('borderEscortLocation').value,heavy=document.getElementById('borderEscortHeavy').value;if(!loc||!heavy){alert('Preencha o local e indique se leva mercadorias, malas ou coisas pesadas.');return}total=heavy==='Sim'?15000:10000;rows=[['Local da travessia',loc],['Mercadorias / malas pesadas',heavy],['Prestação de serviço',money(total)]];}else if(currentService==='shoppingescort'){const loc=document.getElementById('shoppingEscortLocation').value;if(!loc){alert('Selecione o local das compras antes de consultar o preço.');return}if(loc==='Windhoek'){total=60000;rows=[['Local das compras',loc],['Taxa única de acompanhamento',money(60000)],['Periodicidade','Taxa única — não é diária']];}else{const locationSurcharge=['Oshakati','Ongwediva','Ondangwa'].includes(loc)?8000:0;total=10000+locationSurcharge;rows=[['Local das compras',loc],['Prestação diária',money(10000)],['Táxi do técnico APSAN, LDA',money(locationSurcharge)]];}}else if(currentService==='website'){const company=document.getElementById('websiteCompanyType')?.value||'',type=document.getElementById('g1')?.value||'';if(!company){alert('Selecione o tipo de empresa antes de consultar o preço.');return}const companyLabels={small:'Pequena empresa',medium:'Média empresa',large:'Grande empresa'},prices={small:80000,medium:120000,large:200000};total=prices[company];rows=[['Tipo de website',type],['Tipo de empresa',companyLabels[company]],['Taxa de criação do website',money(total)]];}else if(currentService==='software'){const company=document.getElementById('softwareCompanyType')?.value||'';if(!company){alert('Selecione o tipo de empresa antes de consultar o preço.');return}const companyLabels={small:'Pequena empresa — Cantina / Mini loja',medium:'Média empresa',large:'Grande empresa'},prices={small:190000,medium:300000,large:600000};total=prices[company];rows=[['Tipo de sistema',document.getElementById('softwareType')?.selectedOptions[0]?.textContent||'Sistema de gestão empresarial'],['Tipo de empresa',companyLabels[company]],['Taxa do sistema de gestão',money(total)]];}else if(currentService==='minorstranslation'){total=7000;rows=[['Tipo de documento','Documento de viagem para menores'],['Versões incluídas','Português e Inglês'],['Preparação','Documento gerado com os dados fornecidos pelo cliente']];}else if(currentService==='parcel'){const type=document.getElementById('parcelType').value,q=Math.max(1,Number(document.getElementById('parcelQty').value)||1),carrier=document.getElementById('parcelCarrier')?.value||'',province=document.getElementById('parcelProvince')?.value||'',municipality=document.getElementById('parcelMunicipality')?.value||'';const label=type==='envelope'?'Envelope':'Carga';if(type==='envelope'){if(!carrier||!province||!municipality){alert('Selecione a transportadora, a província e o município de destino antes de consultar o preço.');return}const carrierLabel=carrier==='macon'?'Macon':'Huambo Express';const isHuila=province==='Huíla';const freight=isHuila?8000:(carrier==='macon'?18000:12000),serviceFee=isHuila?5000:10000;total=(freight+serviceFee)*q;rows=[['Tipo','Envelope'],['Transportadora',carrierLabel],['Província de destino',province],['Município de destino',municipality],['Quantidade',q],['Frete da encomenda',money(freight*q)],['Prestação de serviço da APSAN, LDA',money(serviceFee*q)]];}else{alert('SERVIÇO INDISPONÍVEL — o envio de encomendas de carga está temporariamente indisponível.');return;}}else if(currentService==='social'){const months=Math.max(1,Number(document.getElementById('socialMonths').value)||1);total=priceConfig.social.monthly*months;rows=[['Plano','Gestão de redes sociais'],['Período',months+' mês(es)'],['Valor mensal',money(priceConfig.social.monthly)]];}else if(currentService==='promotion'){const plan=document.getElementById('promotionPlan')?.value||'daily',qty=Math.max(1,Number(document.getElementById('promotionQty')?.value)||1),urgency=document.getElementById('promotionUrgency')?.value||'Prazo normal';const unit=plan==='weekly'?priceConfig.promotion.weekly:priceConfig.promotion.daily;total=unit*qty;if(urgency==='Urgente')total=Math.round(total*1.2);rows=[['Serviço','Promoção de página no Facebook'],['Plano',plan==='weekly'?'Plano semanal':'Plano diário'],['Duração',qty+(plan==='weekly'?' semana(s)':' dia(s)')],['Valor por '+(plan==='weekly'?'semana':'dia'),money(unit)],['Prazo',urgency],['Valor total da promoção',money(total)]];}else if(currentService==='translation'){const type=document.getElementById('translationType')?.value||'',lang=document.getElementById('translationLanguage')?.value||'',qty=Math.max(1,Number(document.getElementById('translationQuantity')?.value)||1);const labels={document:'Tradução de documentos',interpreter:'Intérprete',literal:'Tradução literal',consecutive:'Interpretação consecutiva',simultaneous:'Interpretação simultânea'},prices={interpreter:50000,consecutive:50000,simultaneous:85000};if(!type){alert('Selecione o tipo de serviço de tradução antes de consultar o preço.');return}if(type==='interpreter'||type==='consecutive'||type==='simultaneous'){const price=prices[type];total=price*qty;rows=[['Tipo de serviço',labels[type]],['Idioma',lang],['Duração',qty+' dia(s)'],['Valor por dia',money(price)],['Prestação de serviço',money(total)]];}else{showLoadingThenResult({title:labels[type],location:'Consulta de preço',total:null,rows:[['Tipo de serviço',labels[type]],['Idioma',lang],['Quantidade',qty+' página(s)'],['Prestação de serviço','Cotação conforme o trabalho solicitado']]});return;}}else{const q=Math.max(1,Number(document.getElementById('genericQty')?.value)||1),u=document.getElementById('genericUrgency')?.value||'Normal';total=10000*q;if(u==='Urgente')total=Math.round(total*1.2);rows=[['Quantidade',q+' unidade(s)'],['Prazo',u]];}showLoadingThenResult({title:serviceInfo[currentService].title.replace(/^\S+\s/,''),location:'Consulta de preço',total,rows,purchaseAmount:currentService==='shopping'?Math.max(0,parseKzInput(document.getElementById('shopInvestment')?.value)):0,minorData:currentService==='minorstranslation'?collectMinorFormData():null})}
function showResult(data,fromPop=false){lastResultData=data;setStage('result');document.getElementById('resultTitle').textContent=data.title;document.getElementById('resultLocation').textContent=data.location;document.getElementById('totalPrice').textContent=data.total===null?'Sob consulta':money(data.total);document.getElementById('resultRows').innerHTML=(data.rows||[]).map(r=>`<div class="row"><span>${r[0]}</span><span>${r[1]}</span></div>`).join('');const ps=document.getElementById('pricingSummary');if(ps){ps.innerHTML=(data.pricingRows&&data.pricingRows.length)?`<div class="pricing-summary"><div class="pricing-title">RESUMO DA PRESTAÇÃO</div>${data.pricingRows.map((r,i)=>`<div class="pricing-row ${i===2?'pricing-final':''}"><span>${r[0]}</span><strong>${r[1]}</strong></div>`).join('')}<div class="pricing-total"><span>TOTAL DA PRESTAÇÃO</span><strong>${data.total===null?'Sob consulta':money(data.total)}</strong></div></div>`:'';}const box=document.getElementById('advanceBox');box.classList.toggle('hidden',data.total===null);if(currentService==='minorstranslation'&&data.total!==null){box.innerHTML='<h3>Como deseja continuar?</h3><p class="small">O valor consultado corresponde às duas versões do documento: Português e Inglês.</p><button class="button" onclick="openMinorRequestForm()">📄 SOLICITAR ESTE DOCUMENTO</button><button class="button secondary" onclick="openPaidDocumentLookup()">CONSULTAR DOCUMENTO PAGO</button>';}else if(currentService==='minorstranslation'){box.innerHTML='<h3>Preço indisponível</h3><p class="small">Consulte novamente o preço da prestação.</p>';}}
function openAppointment(fromPop=false){if(!lastResultData||lastResultData.total===null)return;const d=lastResultData;const fn=document.getElementById('appointmentFirstName'),ln=document.getElementById('appointmentLastName'),wa=document.getElementById('appointmentWhatsapp');if(fn)fn.value=d.clientFirstName||'';if(ln)ln.value=d.clientLastName||'';if(wa)wa.value=d.clientWhatsapp||'';const dt=document.getElementById('appointmentDate');if(dt&&!dt.value){const now=new Date();now.setDate(now.getDate()+1);dt.value=now.toISOString().slice(0,10);}setStage('appointment');if(!fromPop)history.pushState({stage:'appointment',data:lastResultData},'',`#agendamento-${currentService}`);}
function confirmAppointment(){const fn=(document.getElementById('appointmentFirstName')?.value||'').trim(),ln=(document.getElementById('appointmentLastName')?.value||'').trim(),wa=(document.getElementById('appointmentWhatsapp')?.value||'').trim(),date=document.getElementById('appointmentDate')?.value||'',time=document.getElementById('appointmentTime')?.value||'',note=(document.getElementById('appointmentNote')?.value||'').trim();if(fn.length<2||ln.length<2||normalizeWhatsapp(wa).replace(/^\+/,'').length<9||!date||!time){alert('Preencha nome, apelido, WhatsApp, data e horário do agendamento.');return}lastResultData={...lastResultData,clientFirstName:fn,clientLastName:ln,clientName:`${fn} ${ln}`,clientWhatsapp:wa,appointmentDate:date,appointmentTime:time,appointmentNote:note,appointmentStatus:'Agendamento solicitado',invoiceMode:'proforma'};showSuccess(lastResultData);history.pushState({stage:'success',data:lastResultData},'',`#agendamento-concluido-${currentService}`);}
function parseKzInput(value){
  const s=String(value??'').trim().replace(/\s/g,'');
  if(!s)return 0;
  if(s.includes(',')) return Number(s.replace(/\./g,'').replace(',','.'))||0;
  return Number(s.replace(/,/g,''))||0;
}
function formatKzInput(input,forceDecimals=false){
  if(!input)return;
  const raw=String(input.value||'').replace(/[^\d,.-]/g,'');
  if(!raw)return;
  let normalized=raw.replace(/-/g,'');
  let decimal='';
  if(normalized.includes(',')){
    const parts=normalized.split(',');
    normalized=parts.shift()||'0';
    decimal=(parts.join('')||'').slice(0,2);
  }else if((normalized.match(/\./g)||[]).length===1){
    const parts=normalized.split('.');
    if((parts[1]||'').length<=2){
      normalized=parts[0]||'0';
      decimal=parts[1]||'';
    }else{
      normalized=normalized.replace(/\./g,'');
    }
  }else{
    normalized=normalized.replace(/\./g,'');
  }
  normalized=normalized.replace(/\D/g,'')||'0';
  const grouped=Number(normalized).toLocaleString('pt-AO');
  if(forceDecimals){ decimal=(decimal||'').slice(0,2).padEnd(2,'0'); }
  input.value=decimal ? `${grouped},${decimal}` : grouped;
}
function proceedCheckout(fromPop=false){if(!lastResultData||lastResultData.total===null)return;selectedPayment='';proofFile=null;proofFileName='';const pf=document.getElementById('proofFile');if(pf)pf.value='';const ps=document.getElementById('proofStatus');if(ps)ps.textContent='Nenhum comprovativo selecionado.';const d=lastResultData;const purchaseAmount=Number(d.purchaseAmount||0);const serviceAmount=Number(d.total||0);const totalToPay=serviceAmount+purchaseAmount;document.getElementById('checkoutTotal').textContent=money(totalToPay);const financialLabels=new Set(['prestação de serviço','prestação / deslocação','deslocação','total a transferir','valor estimado da compra','valor da compra','serviço apsan, lda','total a pagar']);let rows=[...(d.rows||[])].filter(r=>!financialLabels.has(String(r[0]).trim().toLowerCase()));if(purchaseAmount>0)rows.push(['Valor da compra',money(purchaseAmount)]);rows.push(['Serviço APSAN, LDA',money(serviceAmount)]);rows.push(['TOTAL A PAGAR',money(totalToPay)]);document.getElementById('checkoutRows').innerHTML=rows.map(r=>`<div class="row"><span>${r[0]}</span><span>${r[1]}</span></div>`).join('');const img=document.getElementById('checkoutServiceImage');if(img){img.src=serviceImages[currentService]||'';img.alt=(d.title||'Serviço APSAN').replace(/^\S+\s/,'');}const st=document.getElementById('checkoutServiceTitle');if(st)st.textContent=(d.title||'Serviço selecionado').replace(/^\S+\s/,'');const sd=document.getElementById('checkoutServiceDescription');if(sd)sd.textContent=serviceInfo[currentService]?.desc||'';document.getElementById('paymentDetails').classList.add('hidden');document.getElementById('transferChoice').classList.remove('active');document.getElementById('expressChoice').classList.remove('active');const fn=document.getElementById('clientFirstName'),ln=document.getElementById('clientLastName'),wa=document.getElementById('clientWhatsapp');if(fn)fn.value=d.clientFirstName||'';if(ln)ln.value=d.clientLastName||'';if(wa)wa.value=d.clientWhatsapp||'';const logo=document.getElementById('checkoutLogo');if(logo&&typeof APSAN_LOGO_DATA!=='undefined')logo.src=APSAN_LOGO_DATA;setStage('checkout');if(!fromPop)history.pushState({stage:'checkout',data:d},'',`#checkout-${currentService}`);document.getElementById('paymentDetails').classList.add('hidden');document.getElementById('checkoutTimerSection').classList.add('hidden');document.querySelector('header.visual-header')?.classList.remove('payment-selected-timer');document.querySelector('#checkoutPage .checkout-banner')?.classList.remove('payment-selected-header');clearInterval(countdownTimer);requestAnimationFrame(()=>updateCountdown());}function normalizeWhatsapp(v){return String(v||'').replace(/[^0-9+]/g,'');}
function normalizeWhatsapp(v){return String(v||'').replace(/[^0-9+]/g,'');}
function handleProofFile(input){proofFile=input.files&&input.files[0]?input.files[0]:null;proofFileName=proofFile?proofFile.name:'';const st=document.getElementById('proofStatus');if(st)st.textContent=proofFile?`Comprovativo selecionado: ${proofFile.name}`:'Nenhum comprovativo selecionado.';validateCheckout();}
function validateCheckout(){const fn=(document.getElementById('clientFirstName')?.value||'').trim(),ln=(document.getElementById('clientLastName')?.value||'').trim(),wa=(document.getElementById('clientWhatsapp')?.value||'').trim();const ok=fn.length>=2&&ln.length>=2&&normalizeWhatsapp(wa).replace(/^\+/,'').length>=9&&!!selectedPayment&&!!proofFile;const btn=document.getElementById('finishCheckoutButton');if(btn){btn.disabled=!ok;btn.textContent=proofFile?'GERAR FATURA COMPLETA E CONTINUAR':'CARREGUE O COMPROVATIVO PARA CONTINUAR';}const st=document.getElementById('clientStatus');if(st){if(!fn||!ln||!wa)st.textContent='Preencha o primeiro nome, último nome e WhatsApp.';else if(!selectedPayment)st.textContent='Selecione o método de pagamento.';else if(!proofFile)st.textContent='Carregue o comprovativo de pagamento.';else st.textContent='Dados completos. Pode continuar.';st.style.color=ok?'#075b3d':'#68756f';}return ok;}
async function finishCheckout(){if(!validateCheckout()){alert('Preencha os dados do cliente, selecione o método de pagamento e carregue o comprovativo.');return}const fn=document.getElementById('clientFirstName').value.trim(),ln=document.getElementById('clientLastName').value.trim(),wa=document.getElementById('clientWhatsapp').value.trim();if(currentService==='minorstranslation'){let proof=null;try{proof=await proofToDataURL(proofFile)}catch(e){}const request={id:'APSAN-DOC-'+Date.now(),service:'minorstranslation',clientFirstName:fn,clientLastName:ln,clientName:`${fn} ${ln}`,clientWhatsapp:wa,paymentMethod:selectedPayment,proofFileName:proofFileName,paymentProof:proof,paymentStatus:'Pagamento recebido — em análise',status:'pending',createdAt:new Date().toISOString(),total:7000,rows:lastResultData?.rows||[],minorData:lastResultData?.minorData||null,title:'Documentos de viagem para menores'};const requests=JSON.parse(localStorage.getItem('apsanMinorRequests')||'[]');requests.push(request);localStorage.setItem('apsanMinorRequests',JSON.stringify(requests));lastResultData={...lastResultData,...request,invoiceMode:'minor-pending'};showMinorPending();history.pushState({stage:'minorPending',data:lastResultData},'',`#pedido-em-analise-${request.id}`);return}lastResultData={...lastResultData,clientFirstName:fn,clientLastName:ln,clientName:`${fn} ${ln}`,clientWhatsapp:wa,paymentMethod:selectedPayment,proofFileName:proofFileName,paymentStatus:'Pago — comprovativo recebido',invoiceMode:'paid'};showSuccess(lastResultData);history.pushState({stage:'success',data:lastResultData},'',`#sucesso-${currentService}`);} 
function showMinorPending(){setStage('success');const tag=document.getElementById('successTag'),head=document.getElementById('successHeading'),desc=document.getElementById('successDescription');if(tag)tag.textContent='COMPROVATIVO RECEBIDO';if(head)head.textContent='Recebemos o seu comprovativo e está em fase de análise.';if(desc)desc.innerHTML='Volte a consultar o seu pedido dentro de uma hora.<br>Em questões de alguma conveniência entre em contacto pelo nosso <strong>WhatsApp da APSAN, LDA: 944 40 30 93</strong>.';const actions=document.querySelector('.invoice-actions');if(actions)actions.innerHTML='<button class="button" onclick="openPaidDocumentLookup()">CONSULTAR DOCUMENTO PAGO</button>';const note=document.querySelector('.download-note');if(note)note.innerHTML='<strong>Estado do pedido:</strong><br>O pagamento foi recebido e aguarda análise e aprovação pela direção da plataforma.';}
function copyText(text){if(navigator.clipboard){navigator.clipboard.writeText(text).then(()=>alert('Copiado com sucesso.')).catch(()=>fallbackCopy(text));}else fallbackCopy(text);}
function fallbackCopy(text){const t=document.createElement('textarea');t.value=text;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove();alert('Copiado com sucesso.');}
function backToResult(){if(history.state&&history.state.stage==='checkout'){history.back()}else{setStage('result')}}
function startCountdown(){clearInterval(countdownTimer);checkoutDeadline=Date.now()+45*60*1000;updateCountdown();countdownTimer=setInterval(updateCountdown,250);}
function updateCountdown(){const left=Math.max(0,checkoutDeadline-Date.now());const totalSeconds=Math.ceil(left/1000);const minutes=Math.floor(totalSeconds/60);const seconds=totalSeconds%60;const el=document.getElementById('countdown');if(el)el.textContent=`${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;if(left<=0){clearInterval(countdownTimer);if(el)el.textContent='00:00';}}
const BFA_LOGO_DATA="data:image/png;base64,";
function selectPayment(method){selectedPayment=method;const timer=document.getElementById('checkoutTimerSection');const globalHeader=document.querySelector('header.visual-header');const banner=document.querySelector('#checkoutPage .checkout-banner');if(timer&&globalHeader&&timer.parentElement!==globalHeader)globalHeader.appendChild(timer);if(globalHeader)globalHeader.classList.add('payment-selected-timer');timer.classList.remove('hidden');timer.classList.add('checkout-header-timer');if(banner)banner.classList.remove('payment-selected-header');startCountdown();document.getElementById('transferChoice').classList.toggle('active',method==='transfer');document.getElementById('expressChoice').classList.toggle('active',method==='express');const box=document.getElementById('paymentDetails');box.classList.remove('hidden');if(method==='transfer'){box.innerHTML=`<div class="bank-brand"><img src="${BFA_LOGO_DATA}" alt="BFA"><div><h3 style="margin:0">Transferência bancária BFA</h3><p class="small" style="margin:4px 0 0">Dados para pagamento</p></div></div><div class="copy-line"><span><strong>Titular</strong><br><span class="copy-value">APSAN, LDA</span></span></div><div class="copy-line"><span><strong>Banco</strong><br><span class="copy-value">BFA</span></span></div><div class="copy-line"><span><strong>Número de conta</strong><br><span class="copy-value">363503021 30 001</span></span><button class="copy-btn" onclick="copyText('363503021 30 001')">COPIAR</button></div><div class="copy-line"><span><strong>Moeda</strong><br><span class="copy-value">AKZ</span></span></div><div class="copy-line"><span><strong>NBA</strong><br><span class="copy-value bank-identifier">0006 0000 63503021301 57</span></span><button class="copy-btn" onclick="copyText('0006 0000 63503021301 57')">COPIAR</button></div><div class="copy-line"><span><strong>IBAN</strong><br><span class="copy-value bank-identifier iban-value">0006 0000 63503021301 57</span></span><button class="copy-btn" onclick="copyText('0006 0000 63503021301 57')">COPIAR</button></div>`;}else{box.innerHTML=`<h3>Pagamento via MULTICAIXA Express</h3><div class="copy-line"><span><strong>Número Express</strong><br><span class="copy-value">931 057 760</span></span><button class="copy-btn" onclick="copyText('931057760')">COPIAR</button></div><p class="small" style="margin:10px 0 0">Use o número acima no MULTICAIXA Express para efetuar o pagamento.</p>`;}validateCheckout();}
const APSAN_LOGO_DATA="data:image/jpeg;base64,";
function getMinorRequests(){try{return JSON.parse(localStorage.getItem('apsanMinorRequests')||'[]')}catch(e){return[]}}
function saveMinorRequests(a){localStorage.setItem('apsanMinorRequests',JSON.stringify(a))}
function openPaidDocumentLookup(){setStage('paidDocument');const input=document.getElementById('paidDocName');if(input)input.value='';const r=document.getElementById('paidDocLookupResult');if(r)r.innerHTML='<div class="notice">Após a análise do comprovativo do pagamento feito, basta clicar em consultar o documento. O documento ficará disponível aqui.</div>';history.pushState({stage:'paidDocument'},'', '#consultar-documento-pago');}
function lookupPaidDocument(){const name=(document.getElementById('paidDocName')?.value||'').trim().toLowerCase();const r=document.getElementById('paidDocLookupResult');if(name.length<3){r.innerHTML='<div class="notice">Insira o nome completo usado no pagamento.</div>';return}const item=getMinorRequests().find(x=>String(x.clientName||'').trim().toLowerCase()===name&&x.status==='approved'&&x.documentHtml);if(!item){r.innerHTML='<div class="notice">Ainda não existe um documento aprovado para este nome. Se o pagamento foi realizado recentemente, volte a consultar depois da análise.</div>';return}r.innerHTML=`<div class="detail-card"><h3 style="margin-top:0">Documento disponível</h3><p class="small">Pedido: ${item.id}</p><div class="minor-document-preview-wrap" id="paidDocPreview">${minorDocumentHtml(item)}</div><button class="button" onclick="printApprovedMinorDocument('${item.id}')">🖨️ PRÉ-VISUALIZAR / GUARDAR PDF</button></div>`}
function requestMinorService(){openMinorRequestForm();}
function minorDocumentPageHtml(d,lang){
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const father=d.father||{},mother=d.mother||{},trip=d.trip||{};
  const children=d.children||[];
  const childText=children.map(c=>lang==='pt'
    ? `<p><strong>${esc(c.name)}</strong>, ${esc(c.nationality)}, nascido(a) em ${esc(formatDocDate(c.dob,lang))}, titular do Bilhete de Identidade/Passaporte n.º ${esc(c.doc)}, emitido pela ${esc(c.issuer)} em ${esc(formatDocDate(c.issueDate,lang))};</p>`
    : `<p><strong>${esc(c.name)}</strong>, ${esc(c.nationality)}, born on ${esc(formatDocDate(c.dob,lang))}, holder of National Identity Card/Passport No. ${esc(c.doc)}, issued by ${esc(c.issuer)} on ${esc(formatDocDate(c.issueDate,lang))};</p>`
  ).join('');
  const title=lang==='pt'?'AUTORIZAÇÃO DE VIAGEM PARA MENOR':'TRAVEL AUTHORIZATION FOR MINOR';
  const body=lang==='pt'
    ? `<p>Eu, <strong>${esc(father.name)}</strong>, ${esc(father.nationality)}, nascido(a) em ${esc(father.birthPlace)} aos ${esc(formatDocDate(father.dob,lang))}, ${esc(father.marital)}, titular do Bilhete de Identidade/Passaporte n.º ${esc(father.doc)}, emitido pela ${esc(father.issuer)} em ${esc(formatDocDate(father.issueDate,lang))}, residente em ${esc(father.residence)},</p>
       <p>Nos termos da Lei n.º 13/19, de 23 de maio, autorizo o(s) meu(s) filho(s):</p>
       ${childText}
       <p>a viajar do território de Angola, ${esc(trip.origin)}, para o território de ${esc(trip.destination)}, acompanhado(s) por sua mãe, <strong>${esc(mother.name)}</strong>, ${esc(mother.nationality)}, filha de ${esc(mother.fatherName)} e ${esc(mother.motherName)}, nascida em ${esc(mother.birthPlace)} aos ${esc(formatDocDate(mother.dob,lang))}, ${esc(mother.marital)}, titular do Bilhete de Identidade/Passaporte n.º ${esc(mother.doc)}, emitido pela ${esc(mother.issuer)} em ${esc(formatDocDate(mother.issueDate,lang))}, residente em ${esc(mother.residence)}.</p>
       <p>O período previsto de permanência é de <strong>${esc(trip.stay)}</strong>.</p>`
    : `<p>I, <strong>${esc(father.name)}</strong>, ${esc(father.nationality)}, born in ${esc(father.birthPlace)} on ${esc(formatDocDate(father.dob,lang))}, ${esc(father.marital)}, holder of National Identity Card/Passport No. ${esc(father.doc)}, issued by the ${esc(father.issuer)} on ${esc(formatDocDate(father.issueDate,lang))}, residing in ${esc(father.residence)},</p>
       <p>Hereby, pursuant to Law No. 13/19 of 23 May, I authorize my child${children.length>1?'ren':''}:</p>
       ${childText}
       <p>to travel from the territory of Angola, ${esc(trip.origin)}, to the territory of ${esc(trip.destination)}, accompanied by their mother, <strong>${esc(mother.name)}</strong>, ${esc(mother.nationality)}, daughter of ${esc(mother.fatherName)} and ${esc(mother.motherName)}, born in ${esc(mother.birthPlace)} on ${esc(formatDocDate(mother.dob,lang))}, ${esc(mother.marital)}, holder of National Identity Card/Passport No. ${esc(mother.doc)}, issued by the ${esc(mother.issuer)} on ${esc(formatDocDate(mother.issueDate,lang))}, residing in ${esc(mother.residence)}.</p>
       <p>The intended period of stay is <strong>${esc(trip.stay)}</strong>.</p>`;

  return `<div class="minor-official-document minor-document-page" style="font-family:Georgia,'Times New Roman',serif;color:#111;line-height:1.62;background:#fff;font-size:12.5pt;box-sizing:border-box">
    <div style="text-align:center;margin-bottom:24px">
      <div style="font-size:20px;font-weight:700;letter-spacing:.4px">${title}</div>
      <div style="height:1px;background:#222;margin:18px 0 0"></div>
    </div>
    ${body}
    <div style="margin-top:42px;display:grid;grid-template-columns:1fr 1fr;gap:36px">
      <div><div style="border-top:1px solid #222;padding-top:7px">${lang==='pt'?'Assinatura do responsável':'Guardian’s Signature'}</div><div style="margin-top:8px">${esc(father.name)}</div></div>
      <div><div style="border-top:1px solid #222;padding-top:7px">${lang==='pt'?'Adulto responsável':'Responsible Adult'}</div><div style="margin-top:8px">${esc(mother.name)}</div></div>
    </div>
    <div style="margin-top:34px;text-align:center;font-size:13px">${esc(trip.signingPlace)}, ${esc(formatDocDate(trip.signingDate,lang))}</div>
  </div>`;
}
function minorDocumentHtml(item){const d=item.minorData||null;if(!d)return '<div class="minor-document-page"><p>Document awaiting complete data.</p></div>';return `<div class="minor-document-packet"><div class="minor-preview-page">${minorDocumentPageHtml(d,'pt')}</div><div class="minor-preview-page">${minorDocumentPageHtml(d,'en')}</div></div>`}
function renderAdmin(){const root=document.getElementById('adminContent');if(!root)return;const items=getMinorRequests();root.innerHTML=`<button class="button secondary admin-logout" type="button" onclick="adminLogout()">SAIR DA ÁREA DA DIREÇÃO</button><div style="clear:both"></div><div class="section"><div class="section-title">PEDIDOS RECEBIDOS</div><h3>Documentos de viagem para menores</h3>${items.length?items.map((x,i)=>`<div class="detail-card" style="margin-bottom:12px"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><strong>${x.clientName||'Nome ainda não informado'}</strong><span class="small">${x.status}</span></div><p class="small" style="margin:6px 0">${x.id} • ${new Date(x.createdAt).toLocaleString('pt-PT')}</p><div class="grid"><button class="button secondary" style="margin-top:0" onclick="adminPreviewMinor(${i})">PRÉ-VISUALIZAR</button><button class="button secondary" style="margin-top:0" onclick="adminEditMinor(${i})">EDITAR</button></div><div class="grid"><button class="button" style="margin-top:10px" onclick="adminApproveMinor(${i})">APROVAR</button><button class="button secondary" style="margin-top:10px" onclick="adminRejectMinor(${i})">REJEITAR</button></div><button class="button secondary" style="margin-top:10px" onclick="adminDeleteMinor(${i})">ELIMINAR</button><div id="adminPreview${i}"></div></div>`).join(''):'<div class="notice">Nenhum pedido de documento registado neste dispositivo.</div>'}</div>`}
const ADMIN_EMAIL='suporte@apsanlda.com';
const ADMIN_PASSWORD='12suporte45@';
function isAdminAuthenticated(){try{return sessionStorage.getItem('apsanAdminAuth')==='1'}catch(e){return window.__apsanAdminAuth===true}}
function showAdminLogin(){const root=document.getElementById('adminContent');if(!root)return;root.innerHTML=`<div class="section admin-login"><div class="section-title">ACESSO RESTRITO</div><h3 style="text-align:center">Área da Direção da Plataforma</h3><p class="small" style="text-align:center">Introduza as credenciais autorizadas para aceder à gestão dos documentos.</p><label for="adminEmail">E-mail</label><input id="adminEmail" type="email" autocomplete="username" placeholder="E-mail da direção"><label for="adminPassword">Palavra-passe</label><input id="adminPassword" type="password" autocomplete="current-password" placeholder="Palavra-passe"><button class="button" onclick="adminLogin()">ENTRAR NA ÁREA DA DIREÇÃO</button><div id="adminLoginStatus" class="admin-login-note">Acesso reservado à direção da plataforma.</div></div>`}
function adminLogin(){const email=(document.getElementById('adminEmail')?.value||'').trim().toLowerCase(),password=document.getElementById('adminPassword')?.value||'',status=document.getElementById('adminLoginStatus');if(email===ADMIN_EMAIL&&password===ADMIN_PASSWORD){try{sessionStorage.setItem('apsanAdminAuth','1')}catch(e){window.__apsanAdminAuth=true}renderAdmin();return}if(status)status.textContent='Credenciais inválidas. Verifique o e-mail e a palavra-passe.';}
function adminLogout(){try{sessionStorage.removeItem('apsanAdminAuth')}catch(e){}window.__apsanAdminAuth=false;showAdminLogin();}
function openAdmin(){setStage('admin');if(isAdminAuthenticated())renderAdmin();else showAdminLogin();history.pushState({stage:'admin'},'', '#direcao');}
function adminApproveMinor(i){const a=getMinorRequests();if(!a[i])return;a[i].status='approved';a[i].paymentStatus='Pagamento aprovado';a[i].documentHtml=minorDocumentHtml(a[i]);a[i].approvedAt=new Date().toISOString();saveMinorRequests(a);renderAdmin();alert('Documento aprovado e disponibilizado para consulta pelo nome completo usado no pagamento.');}
function adminRejectMinor(i){const a=getMinorRequests();if(!a[i])return;a[i].status='rejected';a[i].paymentStatus='Pagamento rejeitado';saveMinorRequests(a);renderAdmin();}
function adminDeleteMinor(i){if(!confirm('Eliminar este pedido da lista da direção?'))return;const a=getMinorRequests();a.splice(i,1);saveMinorRequests(a);renderAdmin();}
function adminPreviewMinor(i){const a=getMinorRequests();const x=a[i],el=document.getElementById('adminPreview'+i);if(!x||!el)return;el.innerHTML=`<div class="minor-document-preview-wrap">${minorDocumentHtml(x)}</div><button type="button" class="button secondary" style="margin-top:12px" onclick="adminEditMinor(${i})">EDITAR DOCUMENTO</button>`}
function adminEditMinor(i){
  const a=getMinorRequests(),x=a[i]; if(!x)return;
  const d=JSON.parse(JSON.stringify(x.minorData||{father:{},mother:{},children:[{}],trip:{}}));
  const el=document.getElementById('genericForm');
  if(!el)return;
  openMinorRequestForm();
  const set=(id,v)=>{const e=document.getElementById(id);if(e)e.value=v||'';};
  set('minorFatherName',d.father.name);set('minorFatherNationality',d.father.nationality);set('minorFatherDob',d.father.dob);set('minorFatherMarital',d.father.marital);set('minorFatherDocType',d.father.docType||'');set('minorFatherDoc',d.father.doc);set('minorFatherIssuer',d.father.issuer);set('minorFatherIssueDate',d.father.issueDate);set('minorFatherResidence',d.father.residence);set('minorFatherBirthProvince',d.father.birthProvince||'');document.getElementById('minorFatherBirthProvince')?.dispatchEvent(new Event('change'));set('minorFatherBirthMunicipality',d.father.birthMunicipality||'');
  set('minorMotherName',d.mother.name);set('minorMotherNationality',d.mother.nationality);set('minorMotherFatherName',d.mother.fatherName);set('minorMotherMotherName',d.mother.motherName);set('minorMotherDob',d.mother.dob);set('minorMotherMarital',d.mother.marital);set('minorMotherDocType',d.mother.docType||'');set('minorMotherDoc',d.mother.doc);set('minorMotherIssuer',d.mother.issuer);set('minorMotherIssueDate',d.mother.issueDate);set('minorMotherResidence',d.mother.residence);set('minorMotherBirthProvince',d.mother.birthProvince||'');document.getElementById('minorMotherBirthProvince')?.dispatchEvent(new Event('change'));set('minorMotherBirthMunicipality',d.mother.birthMunicipality||'');
  set('minorOrigin',d.trip.origin);set('minorDestination',d.trip.destination);set('minorStay',d.trip.stay);set('minorTravelCompanion',d.trip.companion);set('minorSigningPlace',d.trip.signingPlace);set('minorSigningDate',d.trip.signingDate);
  buildMinorChildren(d.children||[]);
  el.insertAdjacentHTML('afterbegin',`<div class="notice" id="adminEditNotice">A editar o pedido ${x.id}. Depois de terminar, clique em “GUARDAR ALTERAÇÕES”.</div>`);
  const buttons=el.querySelectorAll('button');
  buttons.forEach(b=>{if(b.textContent.includes('SOLICITAR ESTE SERVIÇO'))b.remove();});
  const pay=el.querySelector('button[onclick="proceedMinorCheckout()"]'); if(pay)pay.textContent='GUARDAR ALTERAÇÕES';
  if(pay)pay.setAttribute('onclick',`adminSaveMinorEdit(${i})`);
  setStage('admin');
}
function adminSaveMinorEdit(i){
  const a=getMinorRequests(),x=a[i];if(!x)return;
  const d=collectMinorFormData();if(!d){alert('Preencha todos os dados obrigatórios antes de guardar.');return;}
  x.minorData=d;x.rows=minorRowsFromData(d);x.documentHtml=minorDocumentHtml(x);
  saveMinorRequests(a);renderAdmin();
  alert('Documento atualizado. A pré-visualização já está atualizada.');
}
function printApprovedMinorDocument(id){const x=getMinorRequests().find(r=>r.id===id&&r.status==='approved');if(!x)return;const w=window.open('','_blank');if(!w){alert('Permita a abertura da janela para pré-visualizar o documento.');return}const printScript='<scr'+'ipt>window.onload=function(){window.print()}<\/scr'+'ipt>';w.document.write(`<html><head><title>Autorização de viagem para menor</title><style>@page{size:A4;margin:0}html,body{margin:0;padding:0;background:#fff;color:#111}.minor-preview-page{width:210mm;height:297mm;box-sizing:border-box;page-break-after:always;break-after:page;background:#fff;padding:16mm 18mm;overflow:hidden}.minor-preview-page:last-child{page-break-after:auto;break-after:auto}.minor-official-document{max-width:none!important;margin:0!important;padding:0!important;font-size:12.5pt!important;line-height:1.62!important}.minor-document-page{box-sizing:border-box}</style></head><body>${minorDocumentHtml(x)}${printScript}</body></html>`);w.document.close();}
function invoicePaymentLabel(d){return d.paymentMethod==='express'?'MULTICAIXA Express':d.paymentMethod==='transfer'?'Transferência BFA':'Não informado';}
function invoiceDetails(data){return (data&&data.rows||[]).map(r=>({label:String(r[0]),value:String(r[1])}));}
function generateInvoiceNumber(){if(!lastResultData)return 'APSAN-'+Date.now().toString().slice(-8);if(!lastResultData.invoiceNumber)lastResultData.invoiceNumber='APSAN-'+Date.now().toString().slice(-8);return lastResultData.invoiceNumber;}
function invoiceText(){const d=lastResultData||{},purchase=Number(d.purchaseAmount||0),service=Number(d.total||0),total=purchase+service;return ['APSAN, LDA','AGÊNCIA DE PRESTAÇÃO DE SERVIÇOS ENTRE ANGOLA E NAMÍBIA','FATURA / SOLICITAÇÃO DE SERVIÇO','',`Nº DA FATURA: ${generateInvoiceNumber()}`,`DATA: ${new Date().toLocaleDateString('pt-PT')}`,'','DADOS DO CLIENTE',`Nome: ${d.clientName||'Não informado'}`,`WhatsApp: ${d.clientWhatsapp||'Não informado'}`,`Método de pagamento: ${invoicePaymentLabel(d)}`,'','SERVIÇO SOLICITADO',`Serviço: ${d.title||''}`,`Local: ${d.location||''}`,'','DETALHES DA SOLICITAÇÃO',...invoiceDetails(d).map(r=>`${r.label}: ${r.value}`),'','RESUMO FINANCEIRO',...(purchase>0?[`Valor estimado da compra: ${money(purchase)}`]:[]),`Prestação de serviço: ${money(service)}`,'Deslocação: 0 Kz',`TOTAL A PAGAR: ${money(total)}`,'',`Estado: ${d.invoiceMode==='paid'?'Pagamento confirmado — PAGO':'Aguardando confirmação do pagamento'}`,'WhatsApp APSAN, LDA: 944 40 30 93','NIF: 5002085011','E-mail: info@apsanlda.com'].join('\n');}
function drawPdfTable(page,font,boldFont,rows,x,y,width,rowH,header){const{rgb}=PDFLib;if(header){page.drawRectangle({x,y:y-rowH,width,height:rowH,color:rgb(.03,.30,.21)});page.drawText(header,{x:x+10,y:y-16,size:11,font:boldFont,color:rgb(1,1,1)});y-=rowH;}rows.forEach((r,i)=>{page.drawRectangle({x,y:y-rowH,width,height:rowH,color:i%2?rgb(1,1,1):rgb(.975,.985,.98),borderColor:rgb(.85,.89,.87),borderWidth:.45});page.drawText(String(r[0]),{x:x+10,y:y-16,size:9,font,color:rgb(.12,.15,.14),maxWidth:width*.46-14});page.drawText(String(r[1]),{x:x+width*.48,y:y-16,size:9,font:boldFont,color:rgb(.07,.25,.18),maxWidth:width*.48-14});y-=rowH;});return y;}
function drawPdfSectionTitle(page,font,boldFont,text,x,y,width){const{rgb}=PDFLib;page.drawRectangle({x,y:y-25,width,height:25,color:rgb(.93,.97,.95)});page.drawText(text,{x:x+10,y:y-17,size:11,font:boldFont,color:rgb(.03,.30,.21)});return y-25;}
async function drawInvoiceLogo(page,out,x,y,w,h){try{const img=await out.embedJpg(APSAN_LOGO_DATA);const scale=Math.min(w/img.width,h/img.height),iw=img.width*scale,ih=img.height*scale;page.drawImage(img,{x:x+(w-iw)/2,y:y+(h-ih)/2,width:iw,height:ih});}catch(e){}}
function drawCanvasInvoice(ctx,W,H,d){
  const purchase=Number(d.purchaseAmount||0), service=Number(d.total||0), total=purchase+service;
  const green='#075b3d', gold='#b88a24', ink='#18231f', soft='#eef5f1', line='#d5e0da', pale='#fbfdfc';
  ctx.fillStyle='#fff'; ctx.fillRect(0,0,W,H);
  const S=W/1600;
  ctx.save(); ctx.scale(S,S);
  W=1600; H=H/S;
  const M=72, contentW=W-M*2;
  const moneyText=v=>money(v);
  const invoiceNo=generateInvoiceNumber();
  const date=new Date().toLocaleDateString('pt-AO',{day:'2-digit',month:'2-digit',year:'numeric'});
  const title=String(d.title||'Serviço').replace(/^\S+\s/,'');
  const details=invoiceDetails(d).map(r=>[String(r.label),String(r.value)]);
  function roundedRect(x,y,w,h,r,fill,stroke){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();if(fill){ctx.fillStyle=fill;ctx.fill()}if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=2;ctx.stroke()}}
  function text(txt,x,y,size,weight='400',color=ink,maxW=null){ctx.fillStyle=color;ctx.font=`${weight} ${size}px Arial`; if(maxW){let words=String(txt).split(/\s+/), line='', yy=y; for(const w of words){const test=line?line+' '+w:w;if(ctx.measureText(test).width>maxW && line){ctx.fillText(line,x,yy);line=w;yy+=size*1.3}else line=test} if(line)ctx.fillText(line,x,yy);return yy;} ctx.fillText(String(txt),x,y);return y;}
  function section(x,y,w,label){roundedRect(x,y,w,54,12,soft,null);text(label,x+18,y+35,21,'700',green);return y+54;}
  function table(x,y,w,rows,rowH=48,labelW=.44){
    rows.forEach(([l,v])=>{let h=rowH;const val=String(v||'—');ctx.strokeStyle=line;ctx.lineWidth=1.5;ctx.strokeRect(x,y,w,h);ctx.beginPath();ctx.moveTo(x+w*labelW,y);ctx.lineTo(x+w*labelW,y+h);ctx.stroke();text(l,x+16,y+31,19,'400',ink,w*labelW-28);text(val,x+w*labelW+16,y+31,19,'700',green,w*(1-labelW)-30);y+=h});return y;
  }
  // Header
  ctx.drawImage(window.__APSAN_LOGO_IMG, M, 38, 205, 205);
  text('APSAN, LDA',305,82,50,'700',green);
  text('AGÊNCIA DE PRESTAÇÃO DE SERVIÇOS',305,119,22,'700',ink);
  text('ENTRE ANGOLA E NAMÍBIA',305,150,22,'400',ink);
  text('NIF: 5002085011',305,185,21,'700',gold);
  text('info@apsanlda.com',305,214,21,'400',ink);
  text('Data: '+date, W-330,88,21,'700',ink);
  ctx.fillStyle=gold;ctx.fillRect(M,250,contentW,4);
  // Main title band
  roundedRect(M,270,contentW,108,18,green,null);
  text('FATURA / SOLICITAÇÃO DE SERVIÇO',M+28,320,33,'700','#fff');
  text('SERVIÇOS ENTRE ANGOLA E NAMÍBIA',M+28,355,18,'400','#e6f1eb');
  roundedRect(W-355,292,270,68,12,'#f0d37a',null);
  text('Nº DA FATURA',W-333,320,16,'700',ink);text(invoiceNo,W-333,347,21,'700',ink);
  let y=410, gap=22, half=(contentW-gap)/2;
  // Client + service
  let cy=section(M,y,half,'DADOS DO CLIENTE');cy=table(M,cy,half,[['Primeiro nome',d.clientFirstName||((d.clientName||'').split(' ')[0]||'Não informado')],['Último nome',d.clientLastName||((d.clientName||'').split(' ').slice(1).join(' ')||'Não informado')],['WhatsApp',d.clientWhatsapp||'Não informado'],['Pagamento',invoicePaymentLabel(d)]],54,.42);
  let sx=M+half+gap;let sy=section(sx,y,half,'SERVIÇO SOLICITADO');sy=table(sx,sy,half,[['Serviço',title],['Local',d.location||'Não informado']],54,.42);
  y=Math.max(cy,sy)+28;
  // Request details
  y=section(M,y,contentW,'DETALHES DA SOLICITAÇÃO');
  const detailRows=details.length?details:[['Informação','Não informada']];
  detailRows.forEach(([l,v])=>{const h=58;ctx.strokeStyle=line;ctx.lineWidth=1.5;ctx.strokeRect(M,y,contentW,h);ctx.beginPath();ctx.moveTo(M+contentW*.42,y);ctx.lineTo(M+contentW*.42,y+h);ctx.stroke();text(l,M+16,y+37,20,'400',ink,contentW*.42-28);text(v,M+contentW*.42+16,y+37,20,'700',green,contentW*.58-30);y+=h;});
  y+=30;
  // Financial
  y=section(M,y,contentW,'RESUMO FINANCEIRO');
  const fin=[];if(purchase>0)fin.push(['Valor estimado da compra',moneyText(purchase)]);fin.push(['Prestação de serviço',moneyText(service)],['Deslocação',String(d.locationSurcharge||0)==='0'?'0 Kz':money(Number(d.locationSurcharge||0))]);
  y=table(M,y,contentW,fin,60,.62);
  roundedRect(M,y,contentW,76,12,green,null);text('TOTAL A PAGAR',M+24,y+49,30,'700','#fff');text(moneyText(total),W-M-300,y+49,30,'700','#fff');y+=96;
  // Status/contact cards
  const cardW=(contentW-gap)/2;
  roundedRect(M,y,cardW,105,14,pale,line);text('ESTADO DA SOLICITAÇÃO',M+20,y+36,19,'700',green);text(d.invoiceMode==='paid'?'Pagamento confirmado — PAGO':'Aguardando confirmação do pagamento',M+20,y+71,19,'400',ink,cardW-40);
  roundedRect(M+cardW+gap,y,cardW,105,14,pale,line);text('WHATSAPP APSAN, LDA',M+cardW+gap+20,y+36,19,'700',green);text('944 40 30 93',M+cardW+gap+20,y+71,25,'700',green);y+=135;
  if(d.invoiceMode==='paid'){
    ctx.save();
    const sx=W-285, sy=y-52, sr=108;
    ctx.translate(sx,sy);ctx.rotate(-0.08);
    ctx.globalAlpha=.94;ctx.strokeStyle='#0b7752';ctx.lineWidth=7;ctx.beginPath();ctx.arc(0,0,sr,0,Math.PI*2);ctx.stroke();
    ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,sr-12,0,Math.PI*2);ctx.stroke();
    ctx.setLineDash([5,7]);ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,sr-23,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);
    if(window.__APSAN_LOGO_IMG){const img=window.__APSAN_LOGO_IMG;const maxW=76,maxH=48,scale=Math.min(maxW/img.width,maxH/img.height);ctx.drawImage(img,-img.width*scale/2,-62,img.width*scale,img.height*scale);}
    text('PAGO',-54,14,34,'900',green);
    text('APSAN, LDA',-59,39,14,'900',green);
    text('COMPROVATIVO RECEBIDO',-76,57,9,'700',green);
    ctx.globalAlpha=1;ctx.restore();
  }
  // Footer chamativo e institucional
  const footerY=Math.min(Math.max(y+24, H-155), H-125);
  ctx.fillStyle=green;ctx.fillRect(0,footerY,W,H-footerY);
  ctx.fillStyle=gold;ctx.fillRect(0,footerY,W,7);
  if(window.__APSAN_LOGO_IMG){
    const img=window.__APSAN_LOGO_IMG;
    const maxW=170,maxH=80,scale=Math.min(maxW/img.width,maxH/img.height);
    ctx.drawImage(img,M,footerY+27,img.width*scale,img.height*scale);
  }
  text('APSAN, LDA',M+205,footerY+42,23,'900','#fff');
  text('AGÊNCIA DE PRESTAÇÃO DE SERVIÇOS ENTRE ANGOLA E NAMÍBIA',M+205,footerY+69,13,'400','#e9f5ef');
  text('NIF: 5002085011  •  WhatsApp: 944 40 30 93  •  info@apsanlda.com',M+205,footerY+98,13,'700','#fff');
  text('CONFIANÇA • ASSISTÊNCIA • CONEXÃO',W-M-330,footerY+128,12,'700','#f0d37a');
  ctx.restore();
}

function buildInvoiceBlob(){return new Promise(resolve=>{if(!window.__APSAN_LOGO_IMG){const img=new Image();img.onload=()=>{window.__APSAN_LOGO_IMG=img;buildInvoiceBlob().then(resolve)};img.src=APSAN_LOGO_DATA;return;}const canvas=document.createElement('canvas');canvas.width=2480;canvas.height=3508;drawCanvasInvoice(canvas.getContext('2d'),2480,3508,lastResultData||{});canvas.toBlob(resolve,'image/png');});}
function downloadInvoiceImage(){buildInvoiceBlob().then(blob=>{if(!blob)return;const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`APSAN-LDA-Fatura-${generateInvoiceNumber()}.png`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),3000);});}
function proofToDataURL(file){return new Promise((resolve,reject)=>{if(!file)return reject(new Error('Sem comprovativo'));if(file.type.startsWith('image/')){const r=new FileReader();r.onload=()=>resolve({type:'image',url:r.result});r.onerror=reject;r.readAsDataURL(file);}else if(file.type==='application/pdf'){const r=new FileReader();r.onload=()=>resolve({type:'pdf',url:r.result});r.onerror=reject;r.readAsArrayBuffer(file);}else reject(new Error('Formato não suportado'));});}
async function renderPdfProof(arrayBuffer){
  if(!window.pdfjsLib)throw new Error('PDF.js não carregado');
  const pdf=await window.pdfjsLib.getDocument({data:arrayBuffer}).promise;
  const canvases=[];
  const maxPages=Math.min(pdf.numPages,1);
  for(let n=1;n<=maxPages;n++){
    const page=await pdf.getPage(n);
    const viewport=page.getViewport({scale:2});
    const canvas=document.createElement('canvas');canvas.width=Math.ceil(viewport.width);canvas.height=Math.ceil(viewport.height);
    await page.render({canvasContext:canvas.getContext('2d'),viewport}).promise;canvases.push(canvas);
  }
  return canvases;
}
async function printInvoicePacket(){
  const packet=document.getElementById('printPacket');if(!packet)return;
  const blob=await buildInvoiceBlob();const invoiceUrl=URL.createObjectURL(blob);let proof=null;
  try{proof=await proofToDataURL(proofFile);}catch(e){}
  packet.innerHTML=`<div class="print-page"><img src="${invoiceUrl}" style="width:100%;height:100%;object-fit:contain"></div><div class="print-page" id="printProofPage"><h2 class="proof-page-title">COMPROVATIVO DE PAGAMENTO</h2><div class="proof-image-wrap" id="proofImageWrap"></div></div>`;
  const wrap=document.getElementById('proofImageWrap');
  if(proof?.type==='image'){const img=document.createElement('img');img.className='proof-image';img.src=proof.url;img.alt='Comprovativo de pagamento';wrap.appendChild(img);}
  else if(proof?.type==='pdf'){try{const canvases=await renderPdfProof(proof.url);canvases.forEach(c=>{c.className='proof-rendered-canvas';wrap.appendChild(c);});}catch(e){wrap.innerHTML='<div style="font-family:Arial;text-align:center"><p>Não foi possível visualizar o PDF nesta sessão.</p></div>';}}
  else{wrap.innerHTML='<div style="font-family:Arial;text-align:center"><p>O comprovativo não está disponível para impressão nesta sessão.</p></div>';}
  window.__printCleanup=()=>{URL.revokeObjectURL(invoiceUrl);packet.innerHTML='';};
  setTimeout(()=>{window.print();setTimeout(()=>window.__printCleanup?.(),1200)},250);
}
async function shareCombinedInvoice(){const d=lastResultData||{};const name=(d.clientFirstName&&d.clientLastName)?`${d.clientFirstName} ${d.clientLastName}`:(d.clientName||'cliente');const inv=generateInvoiceNumber();const msg=`Olá APSAN, LDA. Sou ${name}. Segue a minha fatura/solicitação ${inv}.`;if(navigator.share){try{const blob=await buildInvoiceBlob();const file=new File([blob],`APSAN-LDA-Fatura-${inv}.png`,{type:'image/png'});if(navigator.canShare?.({files:[file]})){await navigator.share({title:`Fatura ${inv}`,text:msg,files:[file]});return}}catch(e){}}window.location.href=`https://wa.me/244944403093?text=${encodeURIComponent(msg)}`;}
function showSuccess(data,fromPop=false){lastResultData=data;setStage('success');const paid=data?.invoiceMode==='paid';const ag=data?.invoiceMode==='proforma';const tag=document.getElementById('successTag'),head=document.getElementById('successHeading'),desc=document.getElementById('successDescription');if(tag)tag.textContent=paid?'PAGAMENTO RECEBIDO':ag?'AGENDAMENTO SOLICITADO':'SOLICITAÇÃO CONCLUÍDA';if(head)head.textContent=paid?'A sua fatura paga está pronta.':ag?'O seu documento de agendamento está pronto.':'A sua fatura está pronta.';if(desc)desc.textContent=paid?'A fatura inclui os dados da solicitação e o comprovativo de pagamento para impressão em 2 páginas.':ag?'A fatura proforma regista os dados do serviço e o agendamento solicitado.':'O documento contém os dados preenchidos durante a solicitação.';}
</script><footer class="site-footer">
