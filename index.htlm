<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>APSAN, LDA — Consulta de Preços</title>
<style>
:root{--green:#075b3d;--green-dark:#063b2a;--green-soft:#eef8f3;--gold:#d5ae32;--text:#17211d;--muted:#68756f;--border:#e3e9e6;--cream:#fff8df}
*{box-sizing:border-box}body{margin:0;background:#f5f7f6;font-family:Arial,Helvetica,sans-serif;color:var(--text)}
.hero{position:relative;overflow:hidden;background:var(--green);color:#fff;padding:38px 24px 82px}.brand{display:flex;align-items:center;gap:18px;max-width:900px;margin:auto}.logo{width:58px;height:96px;border:3px solid var(--gold);border-radius:32px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:28px;font-weight:800} .apsan-logo{width:126px;height:100px;object-fit:contain;display:block;filter:drop-shadow(0 4px 8px rgba(0,0,0,.18));flex:0 0 auto}h1{font-size:38px;margin:0 0 10px}.hero p{font-size:19px;line-height:1.35;margin:0;max-width:650px}.card{max-width:900px;margin:-55px auto 40px;background:#fff;border-radius:30px;padding:30px;box-shadow:0 10px 35px #00000012}.hidden{display:none!important}
.tag{display:inline-block;background:#fff2bd;color:#66561c;padding:8px 13px;border-radius:16px;font-size:13px;font-weight:800;margin-bottom:10px}.services-head h2{font-size:30px;margin:7px 0}.services-head p{color:var(--muted);line-height:1.5}.services-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:24px}.service-card{display:flex;align-items:center;gap:15px;text-align:left;background:#fff;border:1px solid var(--border);border-radius:20px;padding:17px;cursor:pointer;min-height:105px}.service-card:hover{border-color:var(--green)}.service-icon{width:52px;height:52px;flex:none;border-radius:15px;background:var(--green-soft);display:flex;align-items:center;justify-content:center;font-size:27px}.service-card strong{display:block;font-size:16px;margin-bottom:6px}.service-card span{display:block;color:var(--muted);font-size:13px;line-height:1.35}
.back{border:0;background:none;color:var(--green);font-weight:800;font-size:17px;cursor:pointer;padding:0 0 25px}.service-box{background:var(--green-soft);border:1px solid #dbece4;border-radius:24px;padding:24px;margin-bottom:26px}.service-title{font-size:29px;font-weight:800;margin:0 0 7px}.service-desc{color:var(--muted);font-size:16px;margin:0}label{display:block;font-weight:800;font-size:17px;margin:22px 0 9px}select,input{width:100%;height:56px;border:1px solid var(--border);border-radius:16px;padding:0 17px;font-size:16px;background:#fff;color:var(--text);outline:none}select:focus,input:focus{border-color:var(--green);box-shadow:0 0 0 3px #075b3d18}.section{border:1px solid var(--border);border-radius:22px;padding:22px;margin:22px 0}.section h3{margin:0 0 16px;font-size:19px}.section-title{color:var(--green);font-size:13px;font-weight:900;letter-spacing:.5px;margin-bottom:7px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.choice{border:1px solid var(--border);border-radius:18px;padding:18px;cursor:pointer}.choice:hover{border-color:var(--green)}.choice.active{border:2px solid var(--green);background:var(--green-soft)}.choice strong{display:block;font-size:17px;margin-bottom:5px}.choice span{color:var(--muted);font-size:14px}.helper{font-size:13px;color:var(--muted);margin-top:7px;line-height:1.4}.calc-box{background:#f8fbf9;border:1px solid var(--border);border-radius:18px;padding:16px;margin-top:16px}.calc-box strong{color:var(--green)}.notice{background:#f6f7f6;border-radius:15px;padding:13px;margin-top:15px;color:var(--muted);font-size:13px;line-height:1.45}.button{width:100%;border:0;border-radius:17px;background:var(--green);color:#fff;font-size:18px;font-weight:800;padding:18px;cursor:pointer;margin-top:25px}.button:hover{background:var(--green-dark)}
/* etapa de carregamento */.loading{text-align:center;padding:45px 10px 55px}.spinner{width:78px;height:78px;border:7px solid #dcebe5;border-top-color:var(--green);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 22px}@keyframes spin{to{transform:rotate(360deg)}}.loading h2{margin:0 0 8px;font-size:27px}.loading p{margin:0;color:var(--muted)}
.result-top{text-align:center}.check{width:82px;height:82px;border-radius:50%;background:#eaf8f0;color:#087b4e;display:flex;align-items:center;justify-content:center;font-size:52px;margin:0 auto 20px}.result-title{font-size:34px;font-weight:900;margin:5px 0}.result-location{font-size:18px;color:var(--muted);margin-bottom:28px}.price-box{background:#0b2b20;color:#fff;border-radius:25px;padding:30px;text-align:center}.price-label{color:#aebdb7;font-size:15px;letter-spacing:1px;font-weight:800}.price{font-size:54px;font-weight:900;margin:8px 0}.price-sub{font-size:17px;color:#d5e1dc}.details{border:1px solid var(--border);border-radius:22px;padding:24px;margin-top:25px}.details h3{margin:0 0 10px;font-size:22px}.row{display:flex;justify-content:space-between;gap:15px;padding:14px 0;border-bottom:1px solid #edf0ee;font-size:16px}.row:last-child{border-bottom:0}.row span:last-child{text-align:right;font-weight:800}.small{font-size:14px;color:var(--muted)}.secondary{background:#fff;color:var(--green);border:1px solid var(--green)}
.selected-summary{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:14px;padding:14px 16px;border:1px solid #dbe8e1;border-radius:16px;background:#f5faf7}.selected-summary>div{display:flex;flex-direction:column;gap:3px}.selected-summary strong{font-size:17px;color:var(--ink)}.compact{width:auto!important;padding:9px 14px!important;font-size:12px!important;margin:0!important}.choice-grid.hidden{display:none!important}

.checkout-box{border:1px solid var(--border);border-radius:24px;padding:24px;margin-top:20px}.checkout-title{font-size:30px;font-weight:900;margin:0 0 8px}.checkout-total{background:#0b2b20;color:#fff;border-radius:20px;padding:22px;text-align:center;margin:18px 0}.checkout-total .label{font-size:14px;color:#b8c8c1;font-weight:800}.checkout-total .value{font-size:42px;font-weight:900;margin-top:6px}.countdown{font-size:34px;font-weight:900;color:var(--green);text-align:center;margin:8px 0}.payment-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.payment-choice{border:2px solid var(--border);border-radius:20px;padding:18px;background:#fff;cursor:pointer;text-align:center}.payment-choice.active{border-color:var(--green);background:var(--green-soft)}.payment-logo{height:58px;display:flex;align-items:center;justify-content:center;margin-bottom:8px}.mcx-logo{display:flex;align-items:center;gap:8px;font-weight:900;color:#111}.mcx-mark{width:48px;height:48px;border-radius:14px;background:#f6a800;display:flex;align-items:center;justify-content:center;color:#fff;font-size:27px;font-weight:900}.detail-card{background:#f8fbf9;border:1px solid var(--border);border-radius:18px;padding:18px;margin-top:15px}.copy-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #e8eeeb}.copy-line:last-child{border-bottom:0}.copy-value{font-weight:800;word-break:break-all}.copy-btn{border:1px solid var(--green);background:#fff;color:var(--green);border-radius:10px;padding:8px 11px;font-weight:800;cursor:pointer}.upload-label{display:block;border:2px dashed #b9c9c2;border-radius:18px;padding:20px;text-align:center;cursor:pointer;margin-top:15px}.upload-label input{height:auto;border:0;padding:0;margin-top:10px}.success-icon{width:86px;height:86px;border-radius:50%;background:#eaf8f0;color:#087b4e;display:flex;align-items:center;justify-content:center;font-size:54px;margin:0 auto 18px}.success{text-align:center;padding:30px 8px}.whatsapp-box{background:#eef8f3;border-radius:18px;padding:18px;margin-top:20px}.invoice-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.invoice-actions .button{margin-top:0}@media(max-width:650px){.payment-grid,.invoice-actions{grid-template-columns:1fr}}
@media(max-width:650px){.hero{padding:24px 16px 72px}.brand{gap:10px;align-items:center}.apsan-logo{width:88px;height:76px}h1{font-size:28px}.hero p{font-size:16px}.card{margin:-45px 10px 25px;padding:22px;border-radius:25px}.grid,.choice-grid,.services-grid{grid-template-columns:1fr}.price{font-size:43px}.result-title{font-size:29px}}
/* Impressao / PDF em 2 paginas */
@media print{
  body{background:#fff!important}
  body>*:not(#printPacket){display:none!important}
  #printPacket{display:block!important;margin:0!important;padding:0!important;background:#fff!important}
  .print-page{width:210mm;min-height:297mm;page-break-after:always;break-after:page;position:relative;overflow:hidden;background:#fff}
  .print-page:last-child{page-break-after:auto;break-after:auto}
  .print-page{padding:10mm!important}
  .print-page:first-child{padding:0!important}
  .proof-page-title{font-family:Arial,Helvetica,sans-serif;text-align:center;color:#075b3d;font-size:22px;font-weight:800;margin:0 0 8mm}
  .proof-image-wrap{width:100%;height:calc(100% - 18mm);display:flex;align-items:center;justify-content:center;overflow:hidden}
  .print-page img.proof-image{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block}
  .proof-rendered-canvas{max-width:100%;max-height:100%;width:auto;height:auto;display:block}
}
#printPacket{display:none}
.proof-stamp{width:210px;height:210px;border:6px double #0b7752;border-radius:50%;position:relative;display:flex;align-items:center;justify-content:center;flex-direction:column;transform:rotate(-7deg);box-shadow:inset 0 0 0 3px #ffffff,inset 0 0 0 7px #0b7752;background:rgba(255,255,255,.72);overflow:hidden}
.proof-stamp:before{content:"";position:absolute;inset:12px;border:2px dashed #0b7752;border-radius:50%;opacity:.8}
.proof-stamp .stamp-logo{width:68px;height:48px;object-fit:contain;z-index:1;filter:saturate(.9)}
.proof-stamp .stamp-paid{font-size:34px;line-height:1;font-weight:900;letter-spacing:2px;color:#0b7752;z-index:1;margin-top:3px}
.proof-stamp .stamp-company{font-size:12px;font-weight:900;letter-spacing:1px;color:#0b7752;z-index:1;margin-top:5px}
.proof-stamp .stamp-note{font-size:8px;font-weight:800;letter-spacing:.5px;color:#0b7752;z-index:1;margin-top:4px}


.express-real-logo{width:74px;height:74px;object-fit:contain;border-radius:14px;display:block}.express-logo-detail{display:flex;justify-content:center;padding:10px;border:1px solid var(--border);border-radius:16px;background:#fff}.express-real-logo-detail{width:180px;max-width:100%;height:auto;display:block;border-radius:18px}.upload-status{margin:8px 0 12px;min-height:20px;text-align:center}.payment-choice .payment-logo{display:flex;align-items:center;justify-content:center;min-height:78px}.bank-brand{display:flex;align-items:center;gap:14px;padding:6px 0 12px;border-bottom:1px solid #e8eeeb;margin-bottom:4px}.bank-brand img{width:82px;height:auto;object-fit:contain}.bank-brand h3{font-size:18px;color:var(--green)}

/* Checkout premium */
.checkout-shell{position:relative;overflow:hidden;border:1px solid #dfe9e4;border-radius:30px;background:#fff;box-shadow:0 18px 55px #063b2a18;margin-top:18px}
.checkout-banner{position:relative;background:linear-gradient(135deg,#063b2a 0%,#075b3d 58%,#0b7752 100%);color:#fff;padding:30px 26px 34px}
.checkout-banner:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-55px;top:-75px;background:#d5ae3228}
.checkout-brand{font-size:12px;font-weight:900;letter-spacing:1.4px;color:#d9c56e;margin-bottom:10px}.checkout-title{font-size:31px;font-weight:900;margin:0 0 8px;position:relative;z-index:1}.checkout-subtitle{margin:0;color:#d9e8e1;line-height:1.45;max-width:650px;position:relative;z-index:1}.checkout-body{padding:24px 26px 30px}
.checkout-total{background:linear-gradient(135deg,#0b2b20,#075b3d);color:#fff;border-radius:22px;padding:23px;text-align:center;margin:0 0 22px;box-shadow:0 10px 25px #063b2a22}.checkout-total .label{font-size:12px;color:#c5d7cf;font-weight:900;letter-spacing:1px}.checkout-total .value{font-size:42px;font-weight:900;margin-top:6px}
.checkout-section{border:1px solid var(--border);border-radius:21px;padding:20px;margin:18px 0;background:#fff}.checkout-section-title{display:flex;align-items:center;gap:9px;color:var(--green);font-size:14px;font-weight:900;letter-spacing:.7px;margin-bottom:13px}.countdown-wrap{display:flex;align-items:center;justify-content:center;gap:12px;background:#f8fbf9;border-radius:18px;padding:14px}.countdown{font-size:34px;font-weight:900;color:var(--green);text-align:center;letter-spacing:2px}.countdown-note{font-size:13px;color:var(--muted);text-align:center;margin:10px 0 0}
.payment-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.payment-choice{border:2px solid var(--border);border-radius:20px;padding:18px;background:#fff;cursor:pointer;transition:.2s;min-height:165px}.payment-choice:hover{transform:translateY(-2px);border-color:#8eb8a8}.payment-choice.active{border-color:var(--green);background:var(--green-soft);box-shadow:0 8px 22px #075b3d18}.payment-logo{height:82px;display:flex;align-items:center;justify-content:center;margin-bottom:9px}.express-real-logo{width:82px;height:82px;object-fit:contain;border-radius:18px;display:block}.payment-choice strong{display:block;font-size:16px}.payment-choice .small{display:block;margin-top:5px}
.detail-card{background:#f8fbf9;border:1px solid var(--border);border-radius:18px;padding:18px;margin-top:15px}.copy-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #e8eeeb}.copy-line:last-child{border-bottom:0}.copy-value{font-weight:800;word-break:break-all}.copy-btn{border:1px solid var(--green);background:#fff;color:var(--green);border-radius:10px;padding:8px 11px;font-weight:800;cursor:pointer}
.invoice-actions{display:grid;grid-template-columns:1fr;gap:12px;margin-top:18px}.invoice-actions .button{margin-top:0}.download-note{background:#fff8df;border:1px solid #f0df9c;border-radius:16px;padding:14px;color:#66561c;font-size:14px;line-height:1.45;margin-top:16px}.success-icon{width:86px;height:86px;border-radius:50%;background:#eaf8f0;color:#087b4e;display:flex;align-items:center;justify-content:center;font-size:54px;margin:0 auto 18px}.success{text-align:center;padding:30px 8px}.whatsapp-box{background:#eef8f3;border:1px solid #d7ebe1;border-radius:20px;padding:20px;margin-top:20px}.whatsapp-number{font-size:25px;font-weight:900;margin:8px 0 12px;color:var(--green)}.whatsapp-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.whatsapp-actions .button{margin-top:0}
@media(max-width:650px){.payment-grid,.whatsapp-actions{grid-template-columns:1fr}.checkout-banner{padding:26px 20px 30px}.checkout-body{padding:20px 18px 24px}.checkout-title{font-size:28px}.checkout-total .value{font-size:36px}}

.minor-form-block{background:#f8fbf9;border:1px solid #dfeae5;border-radius:16px;padding:14px;margin-top:4px}.minor-form-block label{margin-top:10px}.minor-child-card{background:#fff;border:1px solid #dfe7e2;border-radius:14px;padding:14px;margin-bottom:12px}.minor-child-head{display:flex;justify-content:space-between;align-items:center;gap:10px;font-weight:900;color:var(--green)}.minor-child-remove{border:0;background:#f2f5f3;border-radius:10px;padding:7px 10px;cursor:pointer}.customer-section .grid{align-items:start}.customer-section label{margin-top:14px}.customer-section input{margin-bottom:2px}.checkout-action{margin-top:18px}.checkout-action .button{margin-top:0}.checkout-action .button:disabled{opacity:.55;cursor:not-allowed}

.proof-box{background:#fbfdfc}.proof-box .upload-label{background:#f7fbf9;border-color:#8fb7a8}.proof-box input[type=file]{cursor:pointer}.proof-box .upload-status{font-weight:700;color:var(--muted)}.invoice-actions{grid-template-columns:1fr}.whatsapp-actions{display:grid;gap:10px}.invoice-page-preview{background:#fff;border:1px solid var(--border);border-radius:18px;padding:20px;margin-top:18px;text-align:left}
.minor-document-packet{display:grid;grid-template-columns:1fr;gap:18px}.minor-preview-page{background:#fff;border:1px solid #dfe7e2;box-shadow:0 8px 24px #0000000b;padding:0;overflow:hidden}.minor-preview-page .minor-official-document{width:100%;box-sizing:border-box}.minor-preview-page + .minor-preview-page{border-top:8px solid #f1f4f2}@media print{.minor-preview-page{box-shadow:none;border:0}.minor-document-packet{display:block}}

.form-progress{position:sticky;top:0;z-index:20;background:#fff;border:1px solid #dce8e2;border-radius:18px;padding:14px 16px;margin:0 0 20px;box-shadow:0 5px 18px #0000000b}.progress-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:9px}.progress-title{font-weight:900;color:var(--green);font-size:14px}.progress-count{font-weight:800;color:var(--muted);font-size:13px}.progress-track{height:8px;background:#e8efeb;border-radius:99px;overflow:hidden}.progress-fill{height:100%;width:0;background:var(--green);border-radius:99px;transition:width .25s ease}.progress-steps{display:flex;gap:7px;overflow-x:auto;padding-top:11px;scrollbar-width:none}.progress-steps::-webkit-scrollbar{display:none}.progress-step{display:flex;align-items:center;gap:5px;white-space:nowrap;font-size:11px;color:#7a8580;font-weight:700}.progress-step .dot{width:19px;height:19px;border-radius:50%;border:1px solid #cfdad5;background:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:10px;flex:none}.progress-step.done{color:var(--green)}.progress-step.done .dot{background:var(--green);border-color:var(--green);color:#fff}.progress-next{margin-top:9px;font-size:12px;color:var(--muted)}

.pricing-summary{margin-top:18px;border:1px solid var(--border);border-radius:18px;background:#f8fbf9;overflow:hidden}.pricing-title{padding:14px 16px;background:#eaf5ef;color:var(--green);font-size:14px;font-weight:900;letter-spacing:.3px}.pricing-row{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:13px 16px;border-top:1px solid #e5ece8}.pricing-row span{color:var(--ink);line-height:1.35}.pricing-row strong{color:var(--green);text-align:right;white-space:nowrap}.pricing-final{background:#fff;font-size:16px}.pricing-final strong{font-size:18px}.pricing-total{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:16px;background:var(--green);color:#fff;font-size:16px;font-weight:900}.pricing-total strong{font-size:21px;white-space:nowrap}.pricing-row:first-of-type strong{text-decoration:line-through;text-decoration-thickness:1px;opacity:.78}@media(max-width:650px){.pricing-row,.pricing-total{gap:10px}.pricing-row span{max-width:62%}.pricing-total{font-size:15px}.pricing-total strong{font-size:19px}}

.site-footer{margin:34px auto 0;max-width:980px;background:linear-gradient(135deg,#075d42,#063d2d);border-top:5px solid #f0d37a;border-radius:24px 24px 0 0;padding:24px 20px 20px;text-align:center;color:#fff;box-shadow:0 -8px 30px rgba(0,0,0,.08)}
.site-footer-brand{font-size:22px;font-weight:900;letter-spacing:.6px}.site-footer-line{font-size:11px;opacity:.9;margin-top:5px}.site-footer-contact{display:flex;justify-content:center;flex-wrap:wrap;gap:10px 22px;margin-top:14px;font-size:12px;font-weight:700}.site-footer-slogan{margin-top:14px;font-size:11px;color:#f0d37a;font-weight:900;letter-spacing:.8px}
 .director-dot{display:block;width:24px;height:24px;margin:12px auto 0;border:0;border-radius:50%;background:#075b3d;color:#075b3d;box-shadow:0 0 0 1px rgba(255,255,255,.12);cursor:pointer;padding:0;font-size:1px;opacity:.95}.director-dot:hover{transform:scale(1.08)}
.admin-login{max-width:520px;margin:0 auto}.admin-login .section-title{text-align:center}.admin-login-note{background:#f5f7f6;border-radius:16px;padding:14px;color:var(--muted);font-size:13px;line-height:1.5;margin-top:12px}.admin-logout{float:right;margin-bottom:12px}
@media(max-width:650px){.site-footer{margin-top:24px;border-radius:20px 20px 0 0;padding:20px 14px 18px}.site-footer-contact{gap:8px 14px;font-size:11px}.site-footer-line{font-size:9px}}

<style>
/* Cabeçalho APSAN animado */
.apsan-animated-header{position:relative;overflow:hidden}
.apsan-animated-header .brand{position:relative;z-index:2}
.apsan-header-glow{position:absolute;inset:-40%;background:linear-gradient(120deg,transparent 35%,rgba(255,255,255,.12) 48%,rgba(224,184,74,.18) 52%,transparent 65%);animation:apsanSweep 5s linear infinite;pointer-events:none}
.apsan-header-ribbon{position:absolute;left:0;right:0;bottom:0;height:34px;overflow:hidden;background:rgba(0,0,0,.16);border-top:1px solid rgba(255,255,255,.12);z-index:3}
.apsan-header-track{display:flex;width:max-content;white-space:nowrap;animation:apsanMarquee 18s linear infinite;height:100%;align-items:center}
.apsan-header-track span{font-size:12px;font-weight:800;letter-spacing:1.2px;color:#fff;margin-right:55px}
.apsan-header-track b{color:#e7c65d}
.apsan-animated-header h1{animation:apsanTitleIn .8s ease-out both}
.apsan-animated-header p{animation:apsanTextIn 1s .15s ease-out both}
@keyframes apsanSweep{0%{transform:translateX(-25%) rotate(12deg)}100%{transform:translateX(25%) rotate(12deg)}}
@keyframes apsanMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes apsanTitleIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes apsanTextIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:650px){.apsan-header-ribbon{height:30px}.apsan-header-track span{font-size:10px;margin-right:38px}.apsan-animated-header{padding-bottom:42px}}
@media(prefers-reduced-motion:reduce){.apsan-header-glow,.apsan-header-track,.apsan-animated-header h1,.apsan-animated-header p{animation:none}}


/* Cabeçalho visual EXATO do design aprovado */
.visual-header{position:relative;width:100%;margin:0;padding:0;overflow:hidden;background:#063b2a;line-height:0}
.visual-header-media{position:relative;width:100%;overflow:hidden}
.visual-header-image{display:block;width:100%;height:auto;margin:0;padding:0;border:0}
.visual-header-cta{position:absolute;left:25.4%;top:55.5%;width:32.7%;height:10.8%;border:0;background:transparent;cursor:pointer;border-radius:999px;padding:0;z-index:2}
.visual-header-cta:focus-visible{outline:3px solid #f2c84b;outline-offset:4px}

/* Tráfego realista e rota aérea — animações integradas no próprio visual */
.road-traffic{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.road-car{position:absolute;left:0;top:0;width:clamp(62px,7.2vw,112px);height:clamp(34px,4.1vw,64px);transform-origin:50% 85%;filter:drop-shadow(0 5px 5px rgba(0,0,0,.5));animation:driveRoad 8.5s cubic-bezier(.32,.02,.68,.98) infinite;will-change:transform,opacity}
/* A estrada junto à placa Welcome to Namibia sobe em perspectiva para a direita. */
.road-car.car-a{animation-delay:-1.2s}
.road-car.car-b{animation-delay:-4.7s;animation-duration:10.5s}
.road-car.car-c{animation-delay:-7.4s;animation-duration:12.5s}
.road-car.car-d{animation-delay:-9.1s;animation-duration:14s}
.road-car .body{position:absolute;left:4%;right:4%;bottom:12%;height:47%;border-radius:18% 20% 12% 12%;background:linear-gradient(180deg,#f7f8f8 0%,#c5cbd0 48%,#737b82 100%);border:1px solid rgba(25,29,31,.65);box-shadow:inset 0 2px 2px rgba(255,255,255,.7),inset 0 -3px 4px rgba(0,0,0,.2)}
.road-car .roof{position:absolute;left:23%;top:8%;width:54%;height:48%;border-radius:32% 34% 8% 8%;background:linear-gradient(150deg,#e8edf0 0%,#596873 42%,#1d2b33 100%);border:1px solid rgba(18,24,28,.65);box-shadow:inset 0 2px 2px rgba(255,255,255,.45)}
.road-car .window{position:absolute;top:15%;width:21%;height:25%;background:linear-gradient(145deg,#b8d8e3 0%,#536a75 48%,#18242a 100%);border:1px solid rgba(255,255,255,.25);border-radius:18% 18% 5% 5%;z-index:2}.road-car .window.w1{left:29%}.road-car .window.w2{left:51%}
.road-car .wheel{position:absolute;bottom:0;width:17%;height:29%;background:radial-gradient(circle at 50% 45%,#60676b 0 18%,#181b1d 20% 68%,#050607 70%);border-radius:50%;border:1px solid #777;z-index:4}.road-car .wheel.wl{left:13%}.road-car .wheel.wr{right:13%}
.road-car .light{position:absolute;bottom:28%;width:7%;height:12%;border-radius:50%;background:#fff4c4;box-shadow:0 0 7px rgba(255,244,180,.95);z-index:4}.road-car .light.l{right:3%}.road-car .light.r{left:3%}
.road-car .plate{position:absolute;right:7%;bottom:26%;min-width:28%;height:13%;padding:0 2px;border-radius:2px;background:#f3d84c;color:#111;font:bold clamp(5px,.58vw,8px)/1 Arial,sans-serif;display:flex;align-items:center;justify-content:center;letter-spacing:.15px;border:1px solid rgba(0,0,0,.45);z-index:5;box-shadow:0 1px 2px rgba(0,0,0,.35)}
/* Cada carro percorre a mesma faixa de estrada, aproximando-se da placa e diminuindo em perspectiva. */
@keyframes driveRoad{0%{transform:translate(52vw,34vw) scale(1.02) rotate(-4deg);opacity:0}8%{opacity:1}52%{transform:translate(70vw,26vw) scale(.76) rotate(-7deg);opacity:1}90%{opacity:.9}100%{transform:translate(91vw,17vw) scale(.40) rotate(-11deg);opacity:0}}
@keyframes driveRoadMobile{0%{transform:translate(45vw,82vw) scale(.9) rotate(-4deg);opacity:0}8%{opacity:1}55%{transform:translate(64vw,64vw) scale(.67) rotate(-8deg);opacity:1}100%{transform:translate(88vw,45vw) scale(.34) rotate(-12deg);opacity:0}}
/* Avião: camada de movimento suave sobre a rota já presente no visual. */
.flight-motion{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:2;overflow:hidden}
.flight-plane{position:absolute;left:0;top:0;font-size:clamp(18px,2.4vw,34px);line-height:1;color:#fff;filter:drop-shadow(0 0 6px rgba(255,220,80,.95));animation:flySmooth 9s cubic-bezier(.42,0,.58,1) infinite;will-change:transform,opacity}
.flight-trail{position:absolute;left:0;top:0;width:clamp(55px,8vw,120px);height:2px;background:linear-gradient(90deg,transparent,rgba(255,218,77,.15),rgba(255,230,120,.9));box-shadow:0 0 8px rgba(255,215,70,.75);transform-origin:right center;animation:trailSmooth 9s cubic-bezier(.42,0,.58,1) infinite;opacity:.9}
@keyframes flySmooth{0%{transform:translate(39vw,18vw) rotate(0deg) scale(.82);opacity:0}8%{opacity:1}25%{transform:translate(48vw,17.2vw) rotate(2deg) scale(.92)}50%{transform:translate(60vw,17.5vw) rotate(0deg) scale(1)}75%{transform:translate(70vw,18vw) rotate(-2deg) scale(.9)}92%{opacity:1}100%{transform:translate(77vw,18.4vw) rotate(-1deg) scale(.78);opacity:0}}
@keyframes trailSmooth{0%{transform:translate(37vw,18vw) scaleX(.1);opacity:0}8%{opacity:.8}50%{transform:translate(57vw,17.5vw) scaleX(1);opacity:.9}90%{opacity:.7}100%{transform:translate(75vw,18.3vw) scaleX(.45);opacity:0}}
@media(max-width:650px){
 .road-car{width:58px;height:34px;animation-name:driveRoadMobile}
 .road-car.car-b{animation-duration:10.5s}.road-car.car-c{animation-duration:12.5s}.road-car.car-d{animation-duration:14s}
 .road-car .plate{font-size:4.5px;min-width:31%}
 .flight-plane{font-size:19px;animation-duration:10s}.flight-trail{height:1.5px;animation-duration:10s}
}
@media(prefers-reduced-motion:reduce){.road-car,.flight-plane,.flight-trail{animation:none!important}.road-car.car-a{transform:translate(72vw,28vw) scale(.7);opacity:1}.road-car.car-b{transform:translate(80vw,25vw) scale(.55);opacity:.9}.road-car.car-c,.road-car.car-d{display:none}.flight-plane{transform:translate(58vw,18vw);opacity:.9}.flight-trail{transform:translate(48vw,18vw) scaleX(.6);opacity:.5}}

@media(max-width:650px){.visual-header-cta{left:25.2%;top:55.3%;width:32.8%;height:11%}}
</style>
</style>

<style id="minor-a4-preview-css">
/* Pré-visualização do documento: mesma proporção e estrutura da folha A4 impressa. */
.minor-document-preview-wrap{
  width:100%;
  overflow-x:auto;
  overflow-y:visible;
  padding:14px 0 20px;
  text-align:center;
}
.minor-preview-page{
  width:210mm!important;
  height:297mm!important;
  min-height:297mm!important;
  max-width:none!important;
  margin:0 auto 22px!important;
  background:#fff!important;
  border:1px solid #dfe5e1!important;
  box-shadow:0 12px 35px rgba(0,0,0,.14)!important;
  padding:16mm 18mm!important;
  overflow:hidden!important;
  box-sizing:border-box!important;
  transform-origin:top center;
}
.minor-preview-page .minor-official-document{
  width:100%!important;
  max-width:none!important;
  min-height:265mm!important;
  margin:0!important;
  padding:0!important;
  font-size:12.5pt!important;
  line-height:1.62!important;
  background:#fff!important;
  box-sizing:border-box!important;
}
.minor-document-packet{display:block!important;width:100%}
.minor-preview-page + .minor-preview-page{margin-top:22px!important;border-top:1px solid #dfe5e1!important}
@media(max-width:820px){
  .minor-document-preview-wrap{overflow:hidden;padding:10px 0 16px}
  .minor-preview-page{
    /* A folha continua a ser A4; só é visualmente reduzida sem alterar a quebra de texto. */
    transform:scale(calc((100vw - 24px) / 793.7008));
    transform-origin:top center;
    margin-left:auto!important;
    margin-right:auto!important;
    margin-bottom:calc(-297mm + ((100vw - 24px) * 1.41421356) + 22px)!important;
  }
}
@media print{
  .minor-document-preview-wrap{overflow:visible;padding:0}
  .minor-preview-page{
    width:210mm!important;
    height:297mm!important;
    min-height:297mm!important;
    max-width:210mm!important;
    margin:0!important;
    border:0!important;
    box-shadow:none!important;
    padding:16mm 18mm!important;
    transform:none!important;
    page-break-after:always!important;
    break-after:page!important;
  }
  .minor-preview-page:last-child{page-break-after:auto!important;break-after:auto!important}
}
</style>


<style id="minor-filters-css">
.minor-filter-note{font-size:12px;color:var(--muted);margin-top:5px}
.minor-location-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:650px){.minor-location-row{grid-template-columns:1fr}}
</style>


<style id="apsan-minor-requested-adjustments">
/* Detalhes longos: inicialmente recolhidos. */
.service-details-collapsible{position:relative;margin-top:16px}
.service-details-body.is-collapsed{max-height:145px;overflow:hidden}
.service-details-fade{position:absolute;left:0;right:0;bottom:48px;height:60px;background:linear-gradient(to bottom,rgba(255,255,255,0),#fff);pointer-events:none}
.service-details-toggle{width:auto!important;min-width:130px!important;margin-top:10px!important}
/* Formulário de documentos: ocupa todo o ecrã no telefone. */
@media(max-width:700px){
  body.minor-form-open{overflow:hidden}
  body.minor-form-open #genericForm{position:fixed!important;inset:0!important;width:100vw!important;height:100dvh!important;max-height:100dvh!important;z-index:99999!important;margin:0!important;padding:16px!important;overflow-y:auto!important;overflow-x:hidden!important;background:#fff!important;border-radius:0!important}
}
/* Foto do serviço de viagem para menor. */
.minor-service-photo{width:58px;height:58px;border-radius:14px;object-fit:cover;display:block;flex:0 0 58px}
</style>
<script>
function toggleServiceDetails(btn){
  const box=btn.closest('.service-details-collapsible');
  if(!box)return;
  const body=box.querySelector('.service-details-body');
  const fade=box.querySelector('.service-details-fade');
  const collapsed=body.classList.toggle('is-collapsed');
  if(fade)fade.style.display=collapsed?'block':'none';
  btn.textContent=collapsed?'VER MAIS':'VER MENOS';
}
function closeMinorForm(){
  document.body.classList.remove('minor-form-open');
  const el=document.getElementById('genericForm');
  if(el){el.classList.add('hidden');el.innerHTML='';}
}
</script>

<style id="apsan-service-real-images">
.service-real-photo{width:58px;height:58px;border-radius:14px;object-fit:cover;display:block;flex:0 0 58px;background:#f1f7f4}
.service-detail-photo{width:86px;height:86px;border-radius:18px;object-fit:cover;display:block;margin:0 0 12px 0;background:#f1f7f4}
.service-title-with-photo{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
</style>

<style id="apsan-official-checkout-css">
.apsan-checkout-official{max-width:1180px;margin:0 auto;padding:18px 16px 28px;background:linear-gradient(180deg,#fbfdfc 0%,#f5faf7 100%);color:#10251d}
.checkout-topbar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;padding:10px 4px 18px}
.checkout-back-btn{justify-self:start;border:1px solid #d7e1dc;background:#fff;border-radius:14px;padding:10px 15px;font-weight:800;color:#335249;cursor:pointer}
.checkout-branding{display:flex;align-items:center;justify-content:center;gap:18px}.checkout-logo-img{width:175px;height:54px;object-fit:contain}.checkout-brand-text{display:flex;flex-direction:column;line-height:1.1}.checkout-brand-text strong{font-size:20px;color:#123d30}.checkout-brand-text span{font-size:11px;color:#62766e;margin-top:5px}
.checkout-secure{justify-self:end;display:flex;align-items:center;gap:10px}.secure-shield{width:43px;height:43px;border-radius:50%;background:#075b3d;color:#fff;display:grid;place-items:center;font-size:24px;font-weight:900}.checkout-secure strong{display:block;color:#124b3a;font-size:16px}.checkout-secure span:last-child{display:block;color:#687a74;font-size:12px;margin-top:3px}
.checkout-steps{display:flex;align-items:flex-start;justify-content:center;gap:10px;margin:2px auto 22px;max-width:850px}.checkout-step{display:flex;flex-direction:column;align-items:center;text-align:center;min-width:90px}.checkout-step>span{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:#d6ddd9;color:#5d6c66;font-weight:900}.checkout-step.done>span,.checkout-step.current>span{background:#0b7a51;color:#fff}.checkout-step strong{display:block;font-size:13px;color:#23483c;margin-top:6px}.checkout-step small{display:block;font-size:11px;color:#60736c;margin-top:2px}.checkout-step-line{height:2px;background:#cbd4d0;flex:1;max-width:120px;margin-top:15px}.checkout-step-line.active{background:#16815a}
.checkout-heading{margin:0 0 14px}.checkout-heading h2{font-size:38px;line-height:1.05;margin:0;font-weight:950;color:#071b15}.checkout-heading p{margin:8px 0 0;color:#5f746d;font-size:17px}
.checkout-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(320px,.95fr);gap:14px;align-items:start}.checkout-main-column,.checkout-side-column{display:flex;flex-direction:column;gap:14px}.checkout-panel{background:#fff;border:1px solid #dce5e1;border-radius:22px;padding:20px;box-shadow:0 7px 25px rgba(20,65,50,.05)}
.checkout-service-head{display:flex;gap:20px;align-items:center;margin-bottom:20px}.checkout-service-image{width:165px;height:145px;object-fit:cover;border-radius:20px;background:#e9f2ee}.checkout-service-title{font-size:27px;line-height:1.12;font-weight:950;color:#081c16}.checkout-service-copy p{font-size:17px;color:#60746d;margin:10px 0 0;line-height:1.35}
.checkout-section-title{font-size:18px;font-weight:950;color:#075b3d;letter-spacing:.2px;margin-bottom:13px}.checkout-muted{font-size:15px;line-height:1.35;color:#6b7b76;margin:0 0 16px}
.checkout-summary-rows{border-top:1px solid #e4ebe8}.checkout-summary-rows .row{display:flex;justify-content:space-between;gap:18px;padding:12px 2px;border-bottom:1px solid #e8eeeb;font-size:15px}.checkout-summary-rows .row span:last-child{font-weight:850;text-align:right}
.checkout-total{background:linear-gradient(135deg,#064b36,#087b52);color:#fff;border-radius:15px;padding:14px 18px;margin-top:13px;display:flex;align-items:center;justify-content:space-between}.checkout-total .label{font-size:17px;font-weight:900;letter-spacing:.5px}.checkout-total .value{font-size:29px;font-weight:950}
.checkout-fields-two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.customer-section label{display:block;font-size:14px;font-weight:850;color:#162820;margin:12px 0 7px}.customer-section input{width:100%;box-sizing:border-box;border:1px solid #d8e1dd;border-radius:14px;background:#fff;padding:14px 15px;font-size:16px;outline:none}.customer-section input:focus{border-color:#0b7a51;box-shadow:0 0 0 3px rgba(11,122,81,.1)}.checkout-status{font-size:13px;margin-top:8px;min-height:18px}
.timer-panel{text-align:left}.side-panel-title{display:flex;align-items:center;gap:10px;color:#075b3d;font-size:17px;line-height:1.2}.side-icon{font-size:34px;font-weight:700}.countdown-wrap{background:#eef8f3;border-radius:18px;padding:14px;margin-top:12px}.countdown{font-size:44px;font-weight:950;color:#087b52;text-align:center;margin:0}.countdown-note{text-align:center;color:#6a7b75;font-size:13px;margin:8px 0 0}
.checkout-safe-note{display:flex;gap:12px;align-items:flex-start;background:#e5f3eb;border-radius:18px;padding:16px;color:#12563f}.safe-big{width:40px;height:40px;border-radius:12px;background:#087b52;color:#fff;display:grid;place-items:center;font-size:23px;font-weight:900;flex:none}.checkout-safe-note strong{font-size:17px}.checkout-safe-note p{font-size:13px;line-height:1.35;margin:5px 0 0;color:#386457}
.payment-grid{display:flex;flex-direction:column;gap:10px}.payment-choice{position:relative;width:100%;box-sizing:border-box;display:flex;align-items:center;text-align:left;gap:13px;border:2px solid #e0e7e4;border-radius:16px;padding:13px 42px 13px 13px;background:#fff;cursor:pointer}.payment-choice.active{border-color:#087b52;background:#f2faf6;box-shadow:0 0 0 1px #087b52}.payment-logo{width:68px;height:60px;display:flex;align-items:center;justify-content:center;flex:none}.payment-choice-text strong{display:block;font-size:16px;color:#0b1713}.payment-choice-text span{display:block;font-size:13px;color:#687973;margin-top:4px;line-height:1.2}.payment-radio{position:absolute;right:14px;width:23px;height:23px;border:2px solid #d4ded9;border-radius:50%;top:50%;transform:translateY(-50%)}.payment-choice.active .payment-radio{border-color:#087b52;background:#087b52}.payment-choice.active .payment-radio:after{content:"✓";color:#fff;position:absolute;inset:0;display:grid;place-items:center;font-weight:900;font-size:14px}.express-real-logo{max-width:64px;max-height:58px;object-fit:contain}.detail-card{background:#f8fbf9;border:1px solid #dce7e2;border-radius:15px;padding:14px;margin-top:12px}.detail-card .copy-line{padding:9px 0}
.proof-box .checkout-muted{margin-bottom:12px}.checkout-upload{border:2px dashed #9fc6b6;border-radius:16px;background:#fbfefd;min-height:125px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;cursor:pointer;color:#075b3d}.checkout-upload input{display:none}.upload-symbol{font-size:38px;line-height:1}.checkout-upload strong{font-size:15px}.checkout-upload>span:last-of-type{font-size:12px;color:#6b7c75}.upload-status{font-size:12px;color:#64756f;margin:9px 0 0;text-align:center}
.checkout-important{background:#fff2cf;border-radius:16px;padding:14px 17px;color:#6c4b0b}.checkout-important strong{font-size:15px}.checkout-important ul{margin:7px 0 0;padding-left:18px;font-size:12px;line-height:1.45}
.checkout-actions{display:grid;grid-template-columns:150px minmax(280px,1fr) 280px;gap:12px;align-items:center;margin-top:15px}.checkout-secondary-btn,.checkout-primary-btn,.checkout-whatsapp-btn{min-height:52px;border-radius:16px;font-weight:900;cursor:pointer}.checkout-secondary-btn{border:1px solid #cfdad5;background:#fff;color:#52655e;font-size:15px}.checkout-primary-btn{border:0;background:#087b52;color:#fff;font-size:15px;box-shadow:0 7px 18px rgba(8,123,82,.2)}.checkout-primary-btn:disabled{opacity:.55;cursor:not-allowed}.checkout-primary-btn b{font-size:22px;margin-left:10px}.checkout-whatsapp-btn{border:1px solid #d7e1dd;background:#fff;display:flex;align-items:center;justify-content:center;gap:9px;color:#155240}.checkout-whatsapp-btn>span{font-size:24px;color:#0aa65b}.checkout-whatsapp-btn div{text-align:left}.checkout-whatsapp-btn strong{display:block;font-size:13px}.checkout-whatsapp-btn small{display:block;color:#687a73;margin-top:2px}.checkout-whatsapp-btn>b{font-size:17px}.checkout-footer-line{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #dfe7e3;margin-top:16px;padding-top:12px;color:#65766f;font-size:11px}.checkout-footer-line strong{color:#315b4d}
@media(max-width:800px){
  .apsan-checkout-official{padding:10px 10px 20px}.checkout-topbar{grid-template-columns:auto 1fr;gap:10px}.checkout-back-btn{grid-column:1;grid-row:1}.checkout-branding{grid-column:2;justify-content:flex-end}.checkout-logo-img{width:105px;height:42px}.checkout-brand-text{display:none}.checkout-secure{grid-column:1/-1;justify-self:stretch;justify-content:center;background:#f0f8f4;border-radius:13px;padding:9px}.secure-shield{width:34px;height:34px;font-size:18px}.checkout-secure strong{font-size:13px}.checkout-secure span:last-child{font-size:11px}.checkout-steps{gap:4px;margin-bottom:16px}.checkout-step{min-width:62px}.checkout-step>span{width:28px;height:28px}.checkout-step strong{font-size:11px}.checkout-step small{font-size:9px}.checkout-step-line{margin-top:13px;max-width:45px}.checkout-heading h2{font-size:31px}.checkout-heading p{font-size:15px}.checkout-layout{grid-template-columns:1fr}.checkout-service-head{align-items:flex-start;gap:13px}.checkout-service-image{width:115px;height:105px;border-radius:15px}.checkout-service-title{font-size:21px}.checkout-service-copy p{font-size:14px}.checkout-panel{padding:16px;border-radius:18px}.checkout-section-title{font-size:16px}.checkout-summary-rows .row{font-size:14px}.checkout-total .label{font-size:14px}.checkout-total .value{font-size:25px}.checkout-fields-two{grid-template-columns:1fr}.checkout-actions{grid-template-columns:1fr;}.checkout-secondary-btn{order:2}.checkout-primary-btn{order:1}.checkout-whatsapp-btn{order:3}.checkout-footer-line{flex-direction:column}.checkout-side-column{gap:12px}
}
</style>

<style id="apsan-checkout-payment-fit-css">
/* Ajuste mobile: números bancários ficam em uma única linha, sem quebra feia. */
.apsan-checkout-official .detail-card .copy-line{align-items:center;min-width:0}
.apsan-checkout-official .detail-card .copy-line>span{min-width:0;flex:1}
.apsan-checkout-official .detail-card .copy-value{display:inline-block;white-space:nowrap;word-break:normal;overflow:visible;font-size:14px;letter-spacing:-.2px}
.apsan-checkout-official .detail-card .copy-btn{flex:none;white-space:nowrap}
@media(max-width:800px){
  .apsan-checkout-official .detail-card{padding:12px}
  .apsan-checkout-official .detail-card .copy-line{gap:8px;padding:10px 0}
  .apsan-checkout-official .detail-card .copy-value{font-size:13px;letter-spacing:-.35px}
  .apsan-checkout-official .detail-card .copy-btn{padding:7px 9px;font-size:12px}
}
</style>

<style id="apsan-checkout-blue-coming-css">
#checkoutPage .checkout-shell{background:linear-gradient(180deg,#f7fbff 0%,#f2f7fc 100%)}
#checkoutPage .checkout-banner{background:linear-gradient(135deg,#0b4f91 0%,#1976c9 58%,#2b86d0 100%);color:#fff}
#checkoutPage .checkout-brand{color:#d9ecff}
#checkoutPage .checkout-title{color:#fff}
#checkoutPage .checkout-subtitle{color:#e6f2ff}
#checkoutPage .checkout-total{background:linear-gradient(135deg,#0a477f,#176fb8)}
#checkoutPage .checkout-section{border-color:#d7e4f0}
#checkoutPage .checkout-section-title{color:#155f9e}
#checkoutPage .payment-choice.active{border-color:#1976c9;background:#eef7ff;box-shadow:0 0 0 1px #1976c9}
#checkoutPage .payment-choice:hover{border-color:#73add8}
#checkoutPage .copy-btn{border-color:#1976c9;color:#155f9e}
#checkoutPage .detail-card{background:#f5faff;border-color:#cfe0ee}
#checkoutPage .detail-card .bank-brand h3{color:#155f9e!important}
#checkoutPage .countdown{color:#1976c9}
#checkoutPage .countdown-wrap{background:#eef7ff}
#checkoutPage .checkout-action .button{background:#176fb8}
#checkoutPage .upload-label{border-color:#8db8da;background:#f8fcff}
#checkoutPage .checkout-coming-soon{margin-top:18px;padding:18px;border:1px solid #d6e3ee;border-radius:20px;background:#fff}
#checkoutPage .coming-title{display:flex;align-items:center;gap:10px;color:#155f9e;margin-bottom:14px}
#checkoutPage .coming-title>span{font-size:25px}
#checkoutPage .coming-title strong{display:block;font-size:17px}
#checkoutPage .coming-title small{display:block;color:#718396;font-size:12px;margin-top:3px}
#checkoutPage .coming-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
#checkoutPage .coming-card{position:relative;min-height:128px;border:1px solid #dbe6ef;border-radius:15px;padding:13px;background:linear-gradient(180deg,#fff,#f8fbfe);box-sizing:border-box}
#checkoutPage .coming-icon{width:54px;height:40px;border-radius:10px;display:grid;place-items:center;margin-bottom:9px;font-weight:950;font-size:19px;background:#eaf4fc;color:#155f9e}
#checkoutPage .coming-icon.visa{font-style:italic;font-size:20px}
#checkoutPage .coming-icon.wallet{font-size:25px}
#checkoutPage .coming-icon.qr{font-size:27px}
#checkoutPage .coming-icon.link{font-size:28px}
#checkoutPage .coming-icon.shop{background:#fff0f0;color:#c21f26;font-size:23px}
#checkoutPage .coming-icon.hand{background:#eaf7f1;color:#167453}
#checkoutPage .coming-card strong{display:block;font-size:13px;line-height:1.2;color:#1c2d3b}
#checkoutPage .coming-card span{display:block;font-size:11px;line-height:1.25;color:#71808c;margin-top:4px}
#checkoutPage .coming-card em{position:absolute;right:9px;top:9px;font-style:normal;font-size:8px;font-weight:900;color:#1976c9;background:#e8f3fc;border-radius:20px;padding:4px 6px}
@media(max-width:650px){
 #checkoutPage .coming-grid{grid-template-columns:repeat(2,1fr);gap:9px}
 #checkoutPage .coming-card{min-height:125px;padding:11px}
 #checkoutPage .coming-card strong{font-size:12px}
 #checkoutPage .coming-card span{font-size:10px}
}
#checkoutPage #expressChoice{opacity:.62;cursor:not-allowed;filter:grayscale(.12)}
</style>

<style id="apsan-checkout-width-logos-38">
/* Largura total no telefone */
#checkoutPage{width:100%;box-sizing:border-box}
#checkoutPage .checkout-shell{width:100%;max-width:100%;box-sizing:border-box}
#checkoutPage .checkout-body{width:100%;box-sizing:border-box}
#checkoutPage .checkout-section{width:100%;box-sizing:border-box}

/* Dados bancários: o número passa a ter largura própria, sem ser espremido pelo COPIAR. */
#checkoutPage .detail-card .copy-line{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:12px}
#checkoutPage .detail-card .copy-line>span{min-width:0}
#checkoutPage .detail-card .copy-value{display:block;white-space:nowrap;word-break:normal;overflow:visible;font-size:16px;letter-spacing:-.15px}
#checkoutPage .detail-card .copy-btn{white-space:nowrap;flex:none}

/* Nos campos longos, o valor ocupa toda a largura e o botão fica numa linha própria. */
#checkoutPage .detail-card .copy-line:has(.copy-value:nth-child(1)){min-height:60px}
@media(max-width:650px){
  #checkoutPage .checkout-shell{border-radius:0}
  #checkoutPage .checkout-body{padding-left:12px;padding-right:12px}
  #checkoutPage .detail-card{width:100%;box-sizing:border-box;padding:14px 12px}
  #checkoutPage .detail-card .copy-line{grid-template-columns:1fr auto;column-gap:8px}
  #checkoutPage .detail-card .copy-line>span{width:100%;min-width:0}
  #checkoutPage .detail-card .copy-value{font-size:15px;letter-spacing:-.45px;white-space:nowrap}
  #checkoutPage .detail-card .copy-btn{padding:8px 10px;font-size:12px}
  #checkoutPage .detail-card .copy-line:has(.copy-value){min-width:0}
  /* Para NBA/IBAN: número ocupa visualmente a linha completa e não quebra. */
  #checkoutPage .detail-card .copy-line:has(.copy-value){overflow:visible}
  #checkoutPage .coming-icon{width:78px;height:46px;padding:0;background:#edf6fd}
  #checkoutPage .coming-icon img{display:block;width:100%;height:100%;object-fit:contain}
  #checkoutPage .coming-card{overflow:visible}
}
</style>

<style id="apsan-checkout-desktop-visual-mobile-39">
/* No telefone, manter a mesma composição visual do desktop: sem empilhar
   desnecessariamente os elementos e sem quebrar identificadores bancários. */
@media(max-width:650px){
  #checkoutPage .checkout-body{
    padding-left:10px!important;
    padding-right:10px!important;
  }

  /* Mantém os dados bancários numa linha única, como no desktop. */
  #checkoutPage .detail-card .copy-line{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) max-content!important;
    align-items:center!important;
    column-gap:7px!important;
    width:100%!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .detail-card .copy-line>span{
    min-width:0!important;
    width:auto!important;
  }
  #checkoutPage .detail-card .copy-value{
    display:inline-block!important;
    white-space:nowrap!important;
    word-break:keep-all!important;
    overflow:visible!important;
    font-size:clamp(11px,3.7vw,15px)!important;
    letter-spacing:-.55px!important;
    line-height:1.15!important;
  }
  #checkoutPage .detail-card .copy-btn{
    padding:7px 9px!important;
    font-size:11px!important;
    min-width:76px!important;
    white-space:nowrap!important;
  }

  /* Mantém as duas formas principais lado a lado, como no desktop. */
  #checkoutPage .payment-grid{
    grid-template-columns:1fr 1fr!important;
    gap:10px!important;
  }
  #checkoutPage .payment-choice{
    min-width:0!important;
    padding:13px 8px!important;
  }
  #checkoutPage .payment-choice strong{font-size:13px!important;line-height:1.15!important}
  #checkoutPage .payment-choice .small{font-size:11px!important;line-height:1.15!important}
  #checkoutPage .payment-logo{height:50px!important;margin-bottom:5px!important}

  /* Área "Em breve": mantém cartões lado a lado e aproveita a largura. */
  #checkoutPage .checkout-coming-soon{
    width:100%!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .coming-grid{
    grid-template-columns:repeat(3,1fr)!important;
    gap:8px!important;
  }
  #checkoutPage .coming-card{
    min-width:0!important;
    min-height:118px!important;
    padding:9px!important;
  }
  #checkoutPage .coming-icon{
    width:100%!important;
    height:39px!important;
  }
  #checkoutPage .coming-card strong{font-size:11px!important}
  #checkoutPage .coming-card span{font-size:9px!important}
  #checkoutPage .coming-card em{font-size:7px!important;padding:3px 5px!important;right:5px!important;top:5px!important}

  /* Campos do cliente continuam largos e com a mesma linguagem visual. */
  #checkoutPage .customer-section .grid{
    grid-template-columns:1fr 1fr!important;
    gap:9px!important;
  }
  #checkoutPage .customer-section input{
    font-size:14px!important;
    padding:12px!important;
  }

  /* Tamanho geral ajustado para caber no ecrã sem alterar a estrutura. */
  #checkoutPage .checkout-title{font-size:28px!important}
  #checkoutPage .checkout-subtitle{font-size:14px!important}
}
</style>

<style id="apsan-bank-horizontal-40">
#checkoutPage .detail-card .copy-line{
  display:grid;
