  }
}
#checkoutPage .bfa-payment-logo{display:block;object-fit:contain}
</style>

<style id="apsan-checkout-edge-to-edge-43">
@media(max-width:650px){
  /* A caixa azul dos dados bancários sai das margens estreitas do conteúdo
     e ocupa exatamente a largura física do ecrã. */
  #checkoutPage .detail-card{
    width:100vw!important;
    max-width:100vw!important;
    box-sizing:border-box!important;
    margin-left:calc((100% - 100vw)/2)!important;
    margin-right:0!important;
    padding-left:24px!important;
    padding-right:24px!important;
    border-radius:22px!important;
  }

  /* A linha bancária usa todo o espaço: número à esquerda, COPIAR à direita.
     O identificador nunca é colocado por baixo do botão. */
  #checkoutPage .detail-card .copy-line{
    width:100%!important;
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 88px!important;
    column-gap:14px!important;
    align-items:center!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .detail-card .copy-line>span{
    min-width:0!important;
    width:100%!important;
    overflow:visible!important;
  }
  #checkoutPage .detail-card .copy-value{
    display:block!important;
    width:100%!important;
    max-width:none!important;
    white-space:nowrap!important;
    overflow:visible!important;
    text-overflow:clip!important;
    word-break:normal!important;
    overflow-wrap:normal!important;
    font-size:clamp(11px,3.7vw,16px)!important;
    letter-spacing:-.38px!important;
    line-height:1.15!important;
  }
  #checkoutPage .detail-card .copy-btn{
    width:88px!important;
    min-width:88px!important;
    justify-self:end!important;
    white-space:nowrap!important;
    padding:10px 8px!important;
    font-size:12px!important;
    box-sizing:border-box!important;
  }

  /* Cabeçalho interno acompanha a largura total da caixa. */
  #checkoutPage .detail-card .bank-brand{
    width:100%!important;
    box-sizing:border-box!important;
  }
}
</style>

<style id="apsan-checkout-edge-fix-44">
@media(max-width:650px){
  /* Corrige a caixa que saiu demasiado para fora do viewport.
     O checkout tem 10px de margem interna; compensamos exatamente esses 10px,
     sem usar 100vw + calc(), que estava a cortar o lado esquerdo/direito. */
  #checkoutPage .detail-card{
    width:calc(100% + 20px)!important;
    max-width:none!important;
    margin-left:-10px!important;
    margin-right:0!important;
    box-sizing:border-box!important;
    padding-left:18px!important;
    padding-right:18px!important;
    border-radius:22px!important;
    overflow:visible!important;
  }

  /* Toda a linha fica visível: identificador à esquerda e COPIAR fixo à direita. */
  #checkoutPage .detail-card .copy-line{
    width:100%!important;
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 88px!important;
    column-gap:10px!important;
    align-items:center!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .detail-card .copy-line>span{
    min-width:0!important;
    width:100%!important;
    overflow:visible!important;
  }
  #checkoutPage .detail-card .copy-value{
    display:block!important;
    width:100%!important;
    max-width:none!important;
    white-space:nowrap!important;
    word-break:normal!important;
    overflow-wrap:normal!important;
    overflow:visible!important;
    text-overflow:clip!important;
    font-size:clamp(11px,3.55vw,15px)!important;
    letter-spacing:-.45px!important;
    line-height:1.15!important;
  }
  #checkoutPage .detail-card .copy-btn{
    width:88px!important;
    min-width:88px!important;
    justify-self:end!important;
    white-space:nowrap!important;
    box-sizing:border-box!important;
  }

  /* Mantém o cabeçalho e todos os dados alinhados dentro da nova largura. */
  #checkoutPage .detail-card h3{
    margin-left:0!important;
    margin-right:0!important;
  }
}
</style>

<style id="apsan-checkout-final-no-cut-45">
@media(max-width:650px){
  /* Largura EXATA do ecrã: a caixa começa no limite esquerdo e termina
     no limite direito, sem ficar cortada. */
  #checkoutPage .detail-card{
    width:calc(100% + 20px)!important;
    max-width:none!important;
    margin-left:-10px!important;
    margin-right:0!important;
    box-sizing:border-box!important;
    padding-left:18px!important;
    padding-right:18px!important;
    overflow:visible!important;
  }

  /* A área de cada identificador é calculada de forma independente.
     O botão nunca entra na área do número. */
  #checkoutPage .detail-card .copy-line{
    width:100%!important;
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 88px!important;
    column-gap:8px!important;
    align-items:center!important;
    box-sizing:border-box!important;
    min-width:0!important;
  }
  #checkoutPage .detail-card .copy-line>span:first-child{
    min-width:0!important;
    width:100%!important;
    overflow:visible!important;
  }
  #checkoutPage .detail-card .copy-value{
    display:block!important;
    width:100%!important;
    max-width:none!important;
    white-space:nowrap!important;
    overflow:visible!important;
    text-overflow:clip!important;
    word-break:normal!important;
    overflow-wrap:normal!important;
    line-height:1.12!important;
    letter-spacing:-.55px!important;
  }

  /* Tamanho menor somente para os identificadores longos, garantindo
     que o IBAN/NBA inteiro caiba numa única linha. */
  #checkoutPage .detail-card .bank-identifier{
    font-size:clamp(10.5px,3.35vw,14px)!important;
    letter-spacing:-.58px!important;
  }
  #checkoutPage .detail-card .iban-value{
    font-size:clamp(10px,3.2vw,13.5px)!important;
    letter-spacing:-.62px!important;
  }

  #checkoutPage .detail-card .copy-btn{
    width:88px!important;
    min-width:88px!important;
    justify-self:end!important;
    white-space:nowrap!important;
    box-sizing:border-box!important;
    padding:9px 8px!important;
  }
}
</style>

<style id="apsan-iban-real-full-width-46">
@media(max-width:650px){
  /* A caixa é centrada pelo viewport, não pelo container estreito do checkout.
     Assim ocupa de ponta a ponta sem cortar o lado esquerdo. */
  #checkoutPage .detail-card{
    position:relative!important;
    left:50%!important;
    transform:translateX(-50%)!important;
    width:100vw!important;
    max-width:100vw!important;
    margin-left:0!important;
    margin-right:0!important;
    box-sizing:border-box!important;
    padding-left:16px!important;
    padding-right:16px!important;
    overflow:visible!important;
  }

  /* Uma única linha física: texto completo + COPIAR à frente. */
  #checkoutPage .detail-card .copy-line{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 76px!important;
    column-gap:7px!important;
    align-items:center!important;
    width:100%!important;
    min-width:0!important;
    box-sizing:border-box!important;
    overflow:visible!important;
  }

  #checkoutPage .detail-card .copy-line>span:first-child{
    min-width:0!important;
    width:100%!important;
    overflow:visible!important;
  }

  /* NÃO cortar, NÃO esconder e NÃO quebrar o IBAN. */
  #checkoutPage .detail-card .copy-value{
    display:block!important;
    width:auto!important;
    max-width:none!important;
    white-space:nowrap!important;
    word-break:keep-all!important;
    overflow-wrap:normal!important;
    overflow:visible!important;
    text-overflow:clip!important;
    line-height:1.1!important;
  }

  /* Os identificadores longos recebem o espaço e tamanho necessário
     para permanecerem completos numa única linha. */
  #checkoutPage .detail-card .bank-identifier{
    font-size:12.5px!important;
    letter-spacing:-.5px!important;
  }
  #checkoutPage .detail-card .iban-value{
    font-size:12px!important;
    letter-spacing:-.55px!important;
  }

  #checkoutPage .detail-card .copy-btn{
    width:76px!important;
    min-width:76px!important;
    justify-self:end!important;
    white-space:nowrap!important;
    padding:8px 5px!important;
    font-size:11px!important;
    box-sizing:border-box!important;
  }

  /* O título/valor das linhas normais não é afetado. */
  #checkoutPage .detail-card .bank-brand{
    width:100%!important;
    box-sizing:border-box!important;
  }
}
</style>

<style id="apsan-remove-mobile-side-bars-47">
@media(max-width:650px){
  /* Remove the side gutters/rails around the bank information card.
     Keep the card INSIDE the viewport instead of translating it outside. */
  html, body{
    width:100%!important;
    max-width:100%!important;
    overflow-x:hidden!important;
  }

  #checkoutPage{
    width:100%!important;
    max-width:100%!important;
    overflow:visible!important;
  }

  #checkoutPage .detail-card{
    position:relative!important;
    left:auto!important;
    transform:none!important;
    width:100%!important;
    max-width:100%!important;
    margin-left:0!important;
    margin-right:0!important;
    box-sizing:border-box!important;
    padding-left:18px!important;
    padding-right:18px!important;
    overflow:visible!important;
  }

  /* No lateral strip inside the bank card: use the complete content width. */
  #checkoutPage .detail-card .copy-line{
    width:100%!important;
    max-width:100%!important;
    box-sizing:border-box!important;
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 82px!important;
    column-gap:8px!important;
    align-items:center!important;
    overflow:visible!important;
  }

  #checkoutPage .detail-card .copy-line>span:first-child{
    min-width:0!important;
    width:100%!important;
    overflow:visible!important;
  }

  #checkoutPage .detail-card .copy-value{
    width:auto!important;
    max-width:none!important;
    display:block!important;
    white-space:nowrap!important;
    word-break:keep-all!important;
    overflow:visible!important;
    text-overflow:clip!important;
  }

  /* Keep long bank identifiers on exactly one line. */
  #checkoutPage .detail-card .bank-identifier{
    font-size:12.5px!important;
    letter-spacing:-.55px!important;
  }
  #checkoutPage .detail-card .iban-value{
    font-size:12px!important;
    letter-spacing:-.62px!important;
  }

  #checkoutPage .detail-card .copy-btn{
    width:82px!important;
    min-width:82px!important;
    justify-self:end!important;
    white-space:nowrap!important;
    box-sizing:border-box!important;
  }
}
</style>

<style id="apsan-copy-buttons-right-48">
@media(max-width:650px){
  /* Único ajuste solicitado: deslocar os botões COPIAR um pouco mais
     para a direita, sem alterar o tamanho/posição dos números. */
  #checkoutPage .detail-card .copy-btn{
    transform:translateX(12px)!important;
  }
}
</style>

<style id="apsan-logos-crisp-49">
/* Logos de pagamento: sem transparência, sem grayscale e com contraste total. */
#checkoutPage .payment-choice .payment-logo img,
#checkoutPage .express-real-logo,
#checkoutPage .express-real-logo-detail,
#checkoutPage .bfa-payment-logo,
#checkoutPage .coming-icon img{
  opacity:1!important;
  filter:none!important;
  visibility:visible!important;
}

/* MULTICAIXA EXPRESS usa exatamente o logotipo fornecido pelo utilizador. */
#checkoutPage #expressChoice{
  opacity:1!important;
  filter:none!important;
}
#checkoutPage .express-real-logo{
  object-fit:contain!important;
}

/* Logotipos de "Disponíveis em breve" ficam fortes e legíveis. */
#checkoutPage .coming-icon{
  opacity:1!important;
}
#checkoutPage .coming-icon img{
  opacity:1!important;
  filter:none!important;
  mix-blend-mode:normal!important;
  object-fit:contain!important;
}
</style>

<style id="apsan-payment-timer-red-50">
#checkoutPage #checkoutTimerSection{transition:all .2s ease}
#checkoutPage #checkoutTimerSection .checkout-section-title{color:#c62828!important}
#checkoutPage #checkoutTimerSection .countdown-wrap{
  background:#fff0f0!important;
  border:1px solid #f3b7b7!important;
}
#checkoutPage #checkoutTimerSection .countdown{
  color:#d32f2f!important;
}
#checkoutPage #checkoutTimerSection .countdown-note{
  color:#8a5a5a!important;
}
@media(max-width:650px){
  /* Apenas os botões: mais próximos da ponta direita, sem mexer nos números. */
  #checkoutPage .detail-card .copy-btn{
    transform:translateX(22px)!important;
  }
}
</style>

<style id="apsan-checkout-header-timer-51">
/* Temporizador: aparece no cabeçalho somente após escolher o pagamento
   e permanece visível durante o scroll do checkout. */
#checkoutPage .checkout-banner{
  overflow:visible!important;
  position:relative;
  z-index:20;
}
#checkoutPage .checkout-header-timer{
  position:sticky!important;
  top:0!important;
  z-index:50!important;
  width:100%!important;
  box-sizing:border-box!important;
  margin:18px 0 0!important;
  padding:10px 14px!important;
  border:1px solid #efb4b4!important;
  border-radius:14px!important;
  background:#fff1f1!important;
  box-shadow:0 6px 18px rgba(120,0,0,.14)!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:12px!important;
}
#checkoutPage .checkout-header-timer .checkout-section-title{
  margin:0!important;
  color:#b71c1c!important;
  font-size:12px!important;
  line-height:1.2!important;
  letter-spacing:.5px!important;
}
#checkoutPage .checkout-header-timer .countdown-wrap{
  margin:0!important;
  padding:5px 12px!important;
  min-width:105px!important;
  background:#ffe2e2!important;
  border:1px solid #efb4b4!important;
  border-radius:10px!important;
}
#checkoutPage .checkout-header-timer .countdown{
  margin:0!important;
  font-size:26px!important;
  line-height:1!important;
  color:#d32f2f!important;
  letter-spacing:1px!important;
}
#checkoutPage .checkout-header-timer .countdown-note{
  display:none!important;
}
@media(max-width:650px){
  #checkoutPage .checkout-header-timer{
    grid-template-columns:minmax(0,1fr) auto!important;
    gap:8px!important;
    padding:9px 10px!important;
    margin-top:14px!important;
    border-radius:12px!important;
  }
  #checkoutPage .checkout-header-timer .checkout-section-title{
    font-size:10px!important;
  }
  #checkoutPage .checkout-header-timer .countdown-wrap{
    min-width:88px!important;
    padding:6px 9px!important;
  }
  #checkoutPage .checkout-header-timer .countdown{
    font-size:22px!important;
  }
}
</style>

<style id="apsan-flyer-replaced-by-timer-52">
/* Depois de escolher o pagamento, o PANFLETO INTEIRO do cabeçalho
   desaparece. O mesmo espaço transforma-se no temporizador fixo. */
#checkoutPage .checkout-banner.payment-selected-header{
  position:sticky!important;
  top:0!important;
  z-index:1000!important;
  box-sizing:border-box!important;
  min-height:92px!important;
  height:92px!important;
  padding:0!important;
  overflow:visible!important;
  display:block!important;
  box-shadow:0 5px 18px rgba(0,0,0,.16)!important;
}

/* Esconde completamente marca, título e texto do panfleto. */
#checkoutPage .checkout-banner.payment-selected-header .checkout-brand,
#checkoutPage .checkout-banner.payment-selected-header .checkout-title,
#checkoutPage .checkout-banner.payment-selected-header .checkout-subtitle{
  display:none!important;
}

/* O temporizador ocupa todo o espaço que antes era do panfleto. */
#checkoutPage .checkout-banner.payment-selected-header .checkout-header-timer{
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  min-height:0!important;
  margin:0!important;
  padding:14px 20px!important;
  box-sizing:border-box!important;
  border:0!important;
  border-radius:0!important;
  background:#fff1f1!important;
  box-shadow:none!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:16px!important;
}

/* Texto e contador no mesmo cabeçalho, limpos e visíveis. */
#checkoutPage .checkout-banner.payment-selected-header .checkout-section-title{
  margin:0!important;
  color:#b71c1c!important;
  font-size:15px!important;
  line-height:1.2!important;
}
#checkoutPage .checkout-banner.payment-selected-header .countdown-wrap{
  margin:0!important;
  min-width:125px!important;
  padding:8px 16px!important;
  background:#ffe0e0!important;
  border:1px solid #efaaaa!important;
  border-radius:12px!important;
}
#checkoutPage .checkout-banner.payment-selected-header .countdown{
  margin:0!important;
  color:#d32f2f!important;
  font-size:30px!important;
  line-height:1!important;
}
#checkoutPage .checkout-banner.payment-selected-header .countdown-note{
  display:none!important;
}

@media(max-width:650px){
  #checkoutPage .checkout-banner.payment-selected-header{
    height:82px!important;
    min-height:82px!important;
  }
  #checkoutPage .checkout-banner.payment-selected-header .checkout-header-timer{
    padding:10px 14px!important;
    gap:8px!important;
  }
  #checkoutPage .checkout-banner.payment-selected-header .checkout-section-title{
    font-size:11px!important;
    letter-spacing:.2px!important;
  }
  #checkoutPage .checkout-banner.payment-selected-header .countdown-wrap{
    min-width:94px!important;
    padding:7px 9px!important;
  }
  #checkoutPage .checkout-banner.payment-selected-header .countdown{
    font-size:24px!important;
  }
}
</style>

<style id="apsan-global-flyer-replaced-by-timer-53">
/* O elemento que será substituído é o PANFLETO GLOBAL:
   header.visual-header = logo APSAN + Angola/Namíbia + Welcome to Namibia. */
header.visual-header.payment-selected-timer{
  position:fixed!important;
  top:0!important;
  left:0!important;
  right:0!important;
  width:100%!important;
  height:92px!important;
  min-height:92px!important;
  overflow:visible!important;
  z-index:99999!important;
  background:#fff1f1!important;
  box-shadow:0 5px 18px rgba(0,0,0,.18)!important;
}

/* Desaparece TODO o panfleto original, não apenas o texto. */
header.visual-header.payment-selected-timer .visual-header-media{
  display:none!important;
}

/* O temporizador passa a ocupar exatamente o lugar do panfleto. */
header.visual-header.payment-selected-timer .checkout-header-timer{
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  margin:0!important;
  padding:12px 22px!important;
  box-sizing:border-box!important;
  border:0!important;
  border-radius:0!important;
  background:#fff1f1!important;
  box-shadow:none!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:18px!important;
  z-index:10000!important;
}

header.visual-header.payment-selected-timer .checkout-header-timer .checkout-section-title{
  margin:0!important;
  color:#b71c1c!important;
  font-size:15px!important;
  line-height:1.2!important;
  font-weight:900!important;
}
header.visual-header.payment-selected-timer .checkout-header-timer .countdown-wrap{
  margin:0!important;
  min-width:125px!important;
  padding:8px 16px!important;
  background:#ffe0e0!important;
  border:1px solid #efaaaa!important;
  border-radius:12px!important;
}
header.visual-header.payment-selected-timer .checkout-header-timer .countdown{
  margin:0!important;
  color:#d32f2f!important;
  font-size:30px!important;
  line-height:1!important;
}
header.visual-header.payment-selected-timer .checkout-header-timer .countdown-note{
  display:none!important;
}

@media(max-width:650px){
  header.visual-header.payment-selected-timer{
    height:78px!important;
    min-height:78px!important;
  }
  header.visual-header.payment-selected-timer .checkout-header-timer{
    padding:9px 14px!important;
    gap:8px!important;
  }
  header.visual-header.payment-selected-timer .checkout-header-timer .checkout-section-title{
    font-size:11px!important;
  }
  header.visual-header.payment-selected-timer .checkout-header-timer .countdown-wrap{
    min-width:92px!important;
    padding:7px 9px!important;
  }
  header.visual-header.payment-selected-timer .checkout-header-timer .countdown{
    font-size:24px!important;
  }
}
</style>

<style id="apsan-fixed-timer-spacer-54">
/* Reserva o espaço inicial do cabeçalho fixo. Depois, o conteúdo continua
   a rolar normalmente e passa por baixo da barra do cronômetro. */
body:has(header.visual-header.payment-selected-timer) #checkoutPage{
  padding-top:92px!important;
}
@media(max-width:650px){
  body:has(header.visual-header.payment-selected-timer) #checkoutPage{
    padding-top:78px!important;
  }
}
</style>

<style id="apsan-translation-options-55">
#genericForm #translationPriceHint{
  margin-top:10px!important;
