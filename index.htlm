<style id="apsan-checkout-desktop-match-41">
/* MOBILE = mesma composição estrutural do desktop, apenas dimensionada para o ecrã. */
@media (max-width:650px){
  #checkoutPage,
  #checkoutPage .checkout-shell,
  #checkoutPage .checkout-body{
    width:100%!important;
    max-width:none!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .checkout-shell{margin:0!important;border-radius:0!important}
  #checkoutPage .checkout-body{
    padding-left:10px!important;
    padding-right:10px!important;
  }

  /* Caixa BFA larga, como a caixa apresentada no computador. */
  #checkoutPage .detail-card{
    width:100%!important;
    max-width:none!important;
    box-sizing:border-box!important;
    margin-left:0!important;
    margin-right:0!important;
    padding:14px 14px!important;
    border-radius:18px!important;
  }

  /* O valor e o COPIAR têm colunas independentes. Nunca se sobrepõem. */
  #checkoutPage .detail-card .copy-line{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 84px!important;
    gap:10px!important;
    align-items:center!important;
    width:100%!important;
    box-sizing:border-box!important;
    min-width:0!important;
    padding:11px 0!important;
  }
  #checkoutPage .detail-card .copy-line>span{
    min-width:0!important;
    width:auto!important;
    display:block!important;
  }
  #checkoutPage .detail-card .copy-value{
    display:block!important;
    width:100%!important;
    max-width:100%!important;
    white-space:nowrap!important;
    word-break:normal!important;
    overflow-wrap:normal!important;
    overflow:hidden!important;
    text-overflow:clip!important;
    line-height:1.18!important;
    font-size:clamp(12px,3.85vw,16px)!important;
    letter-spacing:-.45px!important;
  }
  #checkoutPage .detail-card .copy-btn{
    width:84px!important;
    min-width:84px!important;
    justify-self:end!important;
    box-sizing:border-box!important;
    white-space:nowrap!important;
    padding:9px 7px!important;
    font-size:12px!important;
  }

  /* Mesmo alinhamento horizontal dos dois métodos principais. */
  #checkoutPage .payment-grid{
    display:grid!important;
    grid-template-columns:1fr 1fr!important;
    gap:10px!important;
  }
  #checkoutPage .payment-choice{
    min-width:0!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .payment-logo{
    height:54px!important;
    display:flex!important;
    align-items:center!important;
    justify-content:center!important;
  }
  #checkoutPage .bfa-payment-logo{
    display:block!important;
    width:78px!important;
    height:54px!important;
    object-fit:contain!important;
  }

  /* Logos de "Disponíveis em breve": maiores, nítidos e sem transparência visual. */
  #checkoutPage .coming-icon{
    width:100%!important;
    height:50px!important;
    background:#fff!important;
    border:1px solid #d8e6f1!important;
    border-radius:11px!important;
    overflow:hidden!important;
    display:flex!important;
    align-items:center!important;
    justify-content:center!important;
  }
  #checkoutPage .coming-icon img{
    width:100%!important;
    height:100%!important;
    display:block!important;
    object-fit:contain!important;
    opacity:1!important;
  }
  #checkoutPage .coming-card{
    opacity:1!important;
    min-width:0!important;
    overflow:hidden!important;
  }
}

/* Desktop: mantém o mesmo tratamento nítido do BFA e dos logos futuros. */
#checkoutPage .bfa-payment-logo{
  display:block;
  width:82px;
  height:58px;
  object-fit:contain;
}
#checkoutPage .coming-icon img{
  opacity:1;
  image-rendering:auto;
}
</style>

<style id="apsan-checkout-final-polish-42">
@media(max-width:650px){
  /* Igual à composição desktop: os métodos ocupam a largura inteira. */
  #checkoutPage .payment-grid{
    display:flex!important;
    flex-direction:column!important;
    width:100%!important;
