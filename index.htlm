<style id="apsan-checkout-full-mobile-40">
/* Checkout mobile: largura total e composição horizontal, sem sobreposição. */
@media(max-width:650px){
  #checkoutPage{
    width:100%!important;
    max-width:none!important;
    margin:0!important;
    padding:0!important;
    box-sizing:border-box!important;
  }
  #checkoutPage .checkout-shell{
    width:100%!important;
    max-width:none!important;
    margin:0!important;
    box-sizing:border-box!important;
    border-radius:0!important;
  }
  #checkoutPage .checkout-body{
    width:100%!important;
    max-width:none!important;
    box-sizing:border-box!important;
    padding-left:10px!important;
    padding-right:10px!important;
  }

  /* Caixa azul dos dados bancários: ocupa toda a largura disponível. */
  #checkoutPage .detail-card{
    width:100%!important;
    max-width:none!important;
    box-sizing:border-box!important;
    margin-left:0!important;
    margin-right:0!important;
    padding:15px 14px!important;
    border-radius:18px!important;
  }

  /* Cada linha reserva uma coluna real para o número e outra para COPIAR. */
  #checkoutPage .detail-card .copy-line{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) 82px!important;
    align-items:center!important;
    column-gap:10px!important;
    width:100%!important;
    box-sizing:border-box!important;
    min-width:0!important;
  }
  #checkoutPage .detail-card .copy-line>span{
    display:block!important;
    width:auto!important;
    min-width:0!important;
    overflow:visible!important;
  }
  #checkoutPage .detail-card .copy-value{
    display:block!important;
    width:max-content!important;
    max-width:100%!important;
    white-space:nowrap!important;
    overflow:hidden!important;
    text-overflow:clip!important;
    word-break:normal!important;
    overflow-wrap:normal!important;
    font-size:clamp(12px,4vw,16px)!important;
    line-height:1.15!important;
    letter-spacing:-.35px!important;
  }
  #checkoutPage .detail-card .copy-btn{
    width:82px!important;
    min-width:82px!important;
    box-sizing:border-box!important;
    padding:9px 7px!important;
    white-space:nowrap!important;
    font-size:12px!important;
    justify-self:end!important;
  }

  /* Cabeçalho bancário também aproveita toda a largura. */
  #checkoutPage .bank-brand{
    width:100%!important;
    box-sizing:border-box!important;
  }

  /* Os logotipos de "Em breve" ficam maiores e legíveis. */
  #checkoutPage .coming-icon{
    width:100%!important;
    height:48px!important;
    background:#eef6fc!important;
    border-radius:12px!important;
    margin-bottom:9px!important;
    overflow:hidden!important;
  }
  #checkoutPage .coming-icon img{
    display:block!important;
    width:100%!important;
    height:100%!important;
    object-fit:contain!important;
  }
  #checkoutPage .coming-card{
    min-width:0!important;
    overflow:hidden!important;
  }
}
</style>

