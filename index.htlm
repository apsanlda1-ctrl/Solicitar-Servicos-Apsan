t-grid"><button type="button" class="payment-choice" id="transferChoice" onclick="selectPayment('transfer')"><div class="payment-logo"><img class="bfa-payment-logo" src="data:image/png;base64," alt="BFA"></div><strong>TRANSFERÊNCIA BFA</strong><span class="small">Pagamento por transferência bancária</span></button><button type="button" class="payment-choice" id="expressChoice" onclick="selectPayment('express')"><div class="payment-logo"><img class="express-real-logo" src="data:image/png;base64," alt="MULTICAIXA Express"></div><strong>MULTICAIXA EXPRESS</strong><span class="small">Pagamento via MULTICAIXA Express</span></button></div><div id="paymentDetails" class="detail-card hidden"></div>
